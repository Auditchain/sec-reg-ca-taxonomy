            "@value": "Use of proceeds identifier [typed axis]",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/467",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/UseOfProceedsIdentifierTypedAxis"
        },
        {
          "@id": "regca:UseOfProceedsLineItems",
