            "regca-complete:reference/2241"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CombinedStakeSharePercentageOnNetwork"
        },
        {
          "@id": "regca:CombinedHashPowerSharePercentageOnNetwork",
          "rdfs:label": {
            "@value": "Combined hash power share of the issuer and its affiliates on the network",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The proportion of a blockchain network's total hash rate contributed, on that network, by the issuer together with every affiliate reported on that network. Stored as a fraction.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2242",
            "regca-complete:reference/2243",
            "regca-complete:reference/2244",
            "regca-complete:reference/2245",
            "regca-complete:reference/2246"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CombinedHashPowerSharePercentageOnNetwork"
        },
