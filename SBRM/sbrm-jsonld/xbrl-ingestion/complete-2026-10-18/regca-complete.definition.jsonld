            "regca-complete:reference/2409",
            "regca-complete:reference/2410",
            "regca-complete:reference/2411",
            "regca-complete:reference/2412"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliateBlockchainNetworkParticipationForPeriodAbstract"
        },
