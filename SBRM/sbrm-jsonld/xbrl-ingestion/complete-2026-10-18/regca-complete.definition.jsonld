        },
        {
          "@id": "regca-complete:rule/REGCA_C_BS_01",
          "@type": "sbrm-mm:ConsistencyRule",
          "xbrlb:ruleType": "ConsistencyRule",
          "dct:identifier": "REGCA_C_BS_01",
          "cmns-qtu:hasExpression": {
