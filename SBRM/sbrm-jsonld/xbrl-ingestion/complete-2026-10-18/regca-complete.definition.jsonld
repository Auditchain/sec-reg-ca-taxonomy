        {
          "@id": "regca:AffiliateEffectiveStakeControlledOnNetwork",
          "rdfs:label": {
            "@value": "Affiliate effective stake controlled on the network, in native token units",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Stake whose consensus weight the affiliate controls on the network, expressed in units of the network's native token.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2148",
