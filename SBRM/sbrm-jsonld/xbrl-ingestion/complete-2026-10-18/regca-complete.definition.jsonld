          },
          "xbrlb:sourceIndex": 856
        },
        {
          "@id": "regca-complete:label/ForeignCurrencyAmountInUSD/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ForeignCurrencyAmountInUSD",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Foreign amount times the exchange rate; this is the amount counted in the aggregate offering price or aggregate sales.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 857
        },
        {
          "@id": "regca-complete:label/Item4AppliesIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Item4AppliesIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Most recent qualified Form 1-CRYPTO or Form 1-KC contains audited financial statements",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 858
        },
        {
          "@id": "regca-complete:label/Item4AppliesIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Item4AppliesIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Item 4 information is required only if the issuer's most recent qualified offering statement on Form 1-CRYPTO or report on Form 1-KC, whichever is more recent, contains audited financial statements. True if that is the case.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 859
        },
        {
          "@id": "regca-complete:label/FormerAccountantReportAdverseOrModifiedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantReportAdverseOrModifiedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Former accountant's report adverse, disclaimed, qualified or modified",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 860
        },
        {
          "@id": "regca-complete:label/FormerAccountantReportAdverseOrModifiedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantReportAdverseOrModifiedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if the principal accountant's report on the financial statements for either of the past two years contained an adverse opinion or a disclaimer of opinion, or was qualified or modified as to uncertainty, audit scope or accounting principles (Item 304(a)(1)(ii)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 861
        },
        {
          "@id": "regca-complete:label/FormerAccountantReportAdverseOrModifiedDescription/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantReportAdverseOrModifiedDescription",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Nature of each adverse opinion, disclaimer, qualification or modification",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 862
        },
        {
          "@id": "regca-complete:label/FormerAccountantReportAdverseOrModifiedDescription/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantReportAdverseOrModifiedDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Describes each adverse opinion, disclaimer of opinion, qualification or modification reported as true above (Item 304(a)(1)(ii)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 863
        },
        {
          "@id": "regca-complete:label/AccountantChangeRecommendedOrApprovedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantChangeRecommendedOrApprovedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Change in accountants recommended or approved by the audit committee or board",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 864
        },
        {
          "@id": "regca-complete:label/AccountantChangeRecommendedOrApprovedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantChangeRecommendedOrApprovedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if the decision to change accountants was recommended or approved by the audit or similar committee of the board, or by the board if there is no such committee (Item 304(a)(1)(iii)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 865
        },
        {
          "@id": "regca-complete:label/AccountantChangeApprovingBodyDomain/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantChangeApprovingBodyDomain",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Approving body [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 866
        },
        {
          "@id": "regca-complete:label/AuditOrSimilarCommitteeMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AuditOrSimilarCommitteeMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Audit or similar committee of the board of directors [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 867
        },
        {
          "@id": "regca-complete:label/AuditOrSimilarCommitteeMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AuditOrSimilarCommitteeMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Used when the issuer has such a committee.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 868
        },
        {
          "@id": "regca-complete:label/BoardOfDirectorsMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BoardOfDirectorsMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Board of directors [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 869
        },
        {
          "@id": "regca-complete:label/BoardOfDirectorsMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BoardOfDirectorsMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Used when the issuer has no audit or similar committee.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 870
        },
        {
          "@id": "regca-complete:label/AccountantChangeApprovingBody/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantChangeApprovingBody",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Body that recommended or approved the change",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 871
        },
        {
          "@id": "regca-complete:label/AccountantChangeApprovingBody/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantChangeApprovingBody",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Which body recommended or approved the change (Item 304(a)(1)(iii)(A)-(B)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 872
        },
        {
          "@id": "regca-complete:label/DisagreementsWithFormerAccountantIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:DisagreementsWithFormerAccountantIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disagreements with the former accountant",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 873
        },
        {
          "@id": "regca-complete:label/DisagreementsWithFormerAccountantIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:DisagreementsWithFormerAccountantIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if, during the two most recent fiscal years and any later interim period before the resignation, declination or dismissal, there was any disagreement with the former accountant on accounting principles or practices, financial statement disclosure, or auditing scope or procedure that, if not resolved to its satisfaction, would have caused it to refer to the matter in its report. Includes disagreements later resolved; a difference of opinion is enough, and an oral communication from the engagement partner generally suffices (Item 304(a)(1)(iv); Instructions 4-5).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 874
        },
        {
          "@id": "regca-complete:label/DisagreementsWithFormerAccountantDescription/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:DisagreementsWithFormerAccountantDescription",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of each disagreement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 875
        },
        {
          "@id": "regca-complete:label/DisagreementsWithFormerAccountantDescription/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:DisagreementsWithFormerAccountantDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Describes each disagreement (Item 304(a)(1)(iv)(A)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 876
        },
        {
          "@id": "regca-complete:label/SubjectMatterDiscussedWithFormerAccountantIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SubjectMatterDiscussedWithFormerAccountantIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Audit committee or board discussed the subject matter with the former accountant",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 877
        },
        {
          "@id": "regca-complete:label/SubjectMatterDiscussedWithFormerAccountantIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SubjectMatterDiscussedWithFormerAccountantIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if the audit or similar committee, or the board, discussed the subject matter of each disagreement or reportable event with the former accountant (Item 304(a)(1)(iv)(B), (v)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 878
        },
        {
          "@id": "regca-complete:label/FormerAccountantAuthorizedToRespondIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantAuthorizedToRespondIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Former accountant authorized to respond fully to the successor accountant",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 879
        },
        {
          "@id": "regca-complete:label/FormerAccountantAuthorizedToRespondIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantAuthorizedToRespondIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if the issuer has authorized the former accountant to respond fully to the successor accountant's inquiries on the subject matter of each disagreement or reportable event (Item 304(a)(1)(iv)(C), (v)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 880
        },
        {
          "@id": "regca-complete:label/LimitationOnFormerAccountantResponse/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LimitationOnFormerAccountantResponse",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Nature of and reason for any limitation on the former accountant's response",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 881
        },
        {
          "@id": "regca-complete:label/LimitationOnFormerAccountantResponse/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LimitationOnFormerAccountantResponse",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Required if the former accountant is not authorized to respond fully (Item 304(a)(1)(iv)(C)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 882
        },
        {
          "@id": "regca-complete:label/ReportableEventsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Reportable events",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 883
        },
        {
          "@id": "regca-complete:label/ReportableEventsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if any of the four kinds of events in Item 304(a)(1)(v)(A)-(D) occurred during the two most recent fiscal years and any later interim period before the change, even without a difference of opinion. An event that led to a disagreement is reported as a disagreement instead (Item 304(a)(1)(v)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 884
        },
        {
          "@id": "regca-complete:label/ReportableEventInternalControlsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventInternalControlsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant advised that internal controls needed for reliable financial statements do not exist",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 885
        },
        {
          "@id": "regca-complete:label/ReportableEventInternalControlsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventInternalControlsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Reportable event under Item 304(a)(1)(v)(A).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 886
        },
        {
          "@id": "regca-complete:label/ReportableEventManagementRepresentationsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventManagementRepresentationsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant advised it can no longer rely on management's representations or be associated with the statements",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 887
        },
        {
          "@id": "regca-complete:label/ReportableEventManagementRepresentationsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventManagementRepresentationsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Reportable event under Item 304(a)(1)(v)(B).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 888
        },
        {
          "@id": "regca-complete:label/ReportableEventAuditScopeIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventAuditScopeIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant advised of a need to expand the audit scope significantly, not done",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 889
        },
        {
          "@id": "regca-complete:label/ReportableEventAuditScopeIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventAuditScopeIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Reportable event under Item 304(a)(1)(v)(C): the accountant advised that its audit scope must be expanded significantly, or that information needed further investigation, and because of the change (or otherwise) this was not done.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 890
        },
        {
          "@id": "regca-complete:label/ReportableEventFairnessOrReliabilityIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventFairnessOrReliabilityIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant concluded information materially impacts the fairness or reliability of reports or statements, unresolved",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 891
        },
        {
          "@id": "regca-complete:label/ReportableEventFairnessOrReliabilityIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventFairnessOrReliabilityIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Reportable event under Item 304(a)(1)(v)(D).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 892
        },
        {
          "@id": "regca-complete:label/ReportableEventsDescription/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventsDescription",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of each reportable event",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 893
        },
        {
          "@id": "regca-complete:label/ReportableEventsDescription/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ReportableEventsDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Describes each reportable event (Item 304(a)(1)(v), applying (a)(1)(iv)(A)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 894
        },
        {
          "@id": "regca-complete:label/NewAccountantConsultedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantConsultedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer consulted the new accountant before engaging it",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 895
        },
        {
          "@id": "regca-complete:label/NewAccountantConsultedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantConsultedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if, during the two most recent fiscal years and any later interim period before the engagement, the issuer consulted the new accountant on the application of accounting principles to a specified transaction or the type of audit opinion (with a written report or important oral advice), or on any matter that was a disagreement or reportable event (Item 304(a)(2)(i)-(ii)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 896
        },
        {
          "@id": "regca-complete:label/NewAccountantConsultationIssues/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantConsultationIssues",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issues on which the new accountant was consulted",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 897
        },
        {
          "@id": "regca-complete:label/NewAccountantConsultationIssues/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantConsultationIssues",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Item 304(a)(2)(A).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 898
        },
        {
          "@id": "regca-complete:label/NewAccountantViewsOnConsultationIssues/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantViewsOnConsultationIssues",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Views of the new accountant on each issue",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 899
        },
        {
          "@id": "regca-complete:label/NewAccountantViewsOnConsultationIssues/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantViewsOnConsultationIssues",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Brief description of the new accountant's oral or written views on each issue (Item 304(a)(2)(B)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 900
        },
        {
          "@id": "regca-complete:label/NewAccountantWrittenViewsFiledAsExhibitIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantWrittenViewsFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "New accountant's written views filed as an exhibit",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 901
        },
        {
          "@id": "regca-complete:label/NewAccountantWrittenViewsFiledAsExhibitIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantWrittenViewsFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if written views received from the new accountant are filed as an exhibit, as Item 304(a)(2)(B) requires.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 902
        },
        {
          "@id": "regca-complete:label/FormerAccountantConsultedOnIssuesIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantConsultedOnIssuesIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Former accountant consulted on the same issues",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 903
        },
        {
          "@id": "regca-complete:label/FormerAccountantConsultedOnIssuesIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantConsultedOnIssuesIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Item 304(a)(2)(C).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 904
        },
        {
          "@id": "regca-complete:label/FormerAccountantViewsSummary/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantViewsSummary",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Summary of the former accountant's views",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 905
        },
        {
          "@id": "regca-complete:label/FormerAccountantViewsSummary/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FormerAccountantViewsSummary",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Required if the former accountant was consulted (Item 304(a)(2)(C)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 906
        },
        {
          "@id": "regca-complete:label/NewAccountantReviewOfDisclosureRequestedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantReviewOfDisclosureRequestedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "New accountant asked to review the disclosure before filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 907
        },
        {
          "@id": "regca-complete:label/NewAccountantReviewOfDisclosureRequestedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantReviewOfDisclosureRequestedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer asked the new accountant to review the Item 304(a) disclosure before filing and offered it the chance to send a letter to the Commission (Item 304(a)(2)(D)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 908
        },
        {
          "@id": "regca-complete:label/NewAccountantLetterFiledAsExhibitIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantLetterFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "New accountant's letter filed as an exhibit",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 909
        },
        {
          "@id": "regca-complete:label/NewAccountantLetterFiledAsExhibitIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NewAccountantLetterFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the new accountant furnished a letter and it is filed as an exhibit (Item 304(a)(2)(D)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 910
        },
        {
          "@id": "regca-complete:label/RegulationSKItem304OtherInformation/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:RegulationSKItem304OtherInformation",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Other Item 304 information",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 911
        },
        {
          "@id": "regca-complete:label/RegulationSKItem304OtherInformation/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:RegulationSKItem304OtherInformation",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Any further information Item 304(a) calls for that the data points above do not hold.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 912
        },
        {
          "@id": "regca-complete:label/AccountantLettersAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLettersAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant letters (Items 4 and 5) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 913
        },
        {
          "@id": "regca-complete:label/AccountantProvidedCopyOfDisclosuresIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantProvidedCopyOfDisclosuresIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant given a copy of the disclosures",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 914
        },
        {
          "@id": "regca-complete:label/AccountantProvidedCopyOfDisclosuresIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantProvidedCopyOfDisclosuresIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer gave the former accountant (Item 4) or the independent accountant (Item 5(b)) a copy of the disclosures, received no later than the filing day (Item 304(a)(3); Form 1-UC Item 5(c)(1)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 915
        },
        {
          "@id": "regca-complete:label/AccountantLetterRequestedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterRequestedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant asked for a letter to the Commission",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 916
        },
        {
          "@id": "regca-complete:label/AccountantLetterRequestedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterRequestedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer asked the accountant for a letter to the Commission saying whether it agrees with the issuer's statements (Item 304(a)(3); Form 1-UC Item 5(c)(2)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 917
        },
        {
          "@id": "regca-complete:label/AccountantLetterFiledAsExhibitIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Accountant's letter filed as an exhibit",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 918
        },
        {
          "@id": "regca-complete:label/AccountantLetterFiledAsExhibitIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterFiledAsExhibitIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the accountant's letter is filed as an exhibit to this report or amendment.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 919
        },
        {
          "@id": "regca-complete:label/AccountantInterimLetterIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantInterimLetterIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Letter is an interim letter",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 920
        },
        {
          "@id": "regca-complete:label/AccountantInterimLetterIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantInterimLetterIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the letter filed is an interim letter highlighting specific concerns, with a fuller letter to follow (Item 304(a)(3)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 921
        },
        {
          "@id": "regca-complete:label/AccountantLetterReceiptDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterReceiptDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date the accountant's letter was received",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 922
        },
        {
          "@id": "regca-complete:label/AccountantLetterReceiptDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AccountantLetterReceiptDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The amendment filing the letter is due within two business days of receipt; if received on a Saturday or Sunday, the period starts on the next business day and includes it (Item 304(a)(3); Form 1-UC Item 5(c)(3)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 923
        },
        {
          "@id": "regca-complete:label/LaterSimilarTransactionsAccountedDifferentlyIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LaterSimilarTransactionsAccountedDifferentlyIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Later similar transactions accounted for as the former accountant would not have",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 924
        },
        {
          "@id": "regca-complete:label/LaterSimilarTransactionsAccountedDifferentlyIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LaterSimilarTransactionsAccountedDifferentlyIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Regulation S-K Item 304(b): true if, after a disagreement or reportable event, material transactions or events like it in the year of the change or the next year were accounted for or disclosed differently from what the former accountant apparently would have required. Form 1-KC does not ask for this.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 925
        },
        {
          "@id": "regca-complete:label/LaterSimilarTransactionsEffectDescription/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LaterSimilarTransactionsEffectDescription",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Nature of the disagreement or reportable event and effect of the former accountant's method",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 926
        },
        {
          "@id": "regca-complete:label/LaterSimilarTransactionsEffectDescription/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:LaterSimilarTransactionsEffectDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Regulation S-K Item 304(b): the existence and nature of the disagreement or reportable event, and the effect on the financial statements had the former accountant's method been followed.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 927
        },
        {
          "@id": "regca-complete:label/PriorRegulationCryptoAssetsOfferingsAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PriorRegulationCryptoAssetsOfferingsAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Offerings under Regulation Crypto Assets in the previous 12 months [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 928
        },
        {
          "@id": "regca-complete:label/PriorRegulationCryptoAssetsOfferingsAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PriorRegulationCryptoAssetsOfferingsAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Asked so a reader can see earlier offerings under Regulation Crypto Assets that bear on aggregate sales (Rule 100), on whether this is the issuer's first offering or one qualified within a year of it (Rule 300(a)(3)(i)-(ii)) and on one-time use of the startup exemption (Rule 200(b)(3)). ",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 929
        },
        {
          "@id": "regca-complete:label/OfferingUnderRegulationCryptoAssetsInPrevious12MonthsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingUnderRegulationCryptoAssetsInPrevious12MonthsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Has the issuer conducted an offering under Regulation Crypto Assets in the previous 12 months?",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 930
        },
        {
          "@id": "regca-complete:label/OfferingUnderRegulationCryptoAssetsInPrevious12MonthsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingUnderRegulationCryptoAssetsInPrevious12MonthsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Asked so a reader can see earlier offerings under Regulation Crypto Assets that bear on aggregate sales (Rule 100), on whether this is the issuer's first offering or one qualified within a year of it (Rule 300(a)(3)(i)-(ii)) and on one-time use of the startup exemption (Rule 200(b)(3)). Yes (true) or no (false), for the 12 months before the date of this filing. If yes, each offering is described in its own row below, with its own text box and URL; the filer adds one row per offering, as many as needed.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 931
        },
        {
          "@id": "regca-complete:label/PriorRegulationCryptoAssetsOfferingTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PriorRegulationCryptoAssetsOfferingTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Offering in the previous 12 months [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 932
        },
        {
          "@id": "regca-complete:label/PriorRegulationCryptoAssetsOfferingIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PriorRegulationCryptoAssetsOfferingIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Prior offering identifier [typed axis]",
            "@language": "en"
