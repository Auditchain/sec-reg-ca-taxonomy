        {
          "@id": "regca-complete:mvf/entry/FilingMerkleRoot",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FilingMerkleRoot",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root of this filing, as 64 lowercase hexadecimal characters, computed by the method reported in the filing over every fact in the filing except this root, the method and the facts in the table of anchors. It is recorded on a blockchain network before the filing is filed; the table of anchors gives the record.",
          "mvf:hasSemanticReference": [
            "https://www.rfc-editor.org/rfc/rfc6962",
            "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf",
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/FilingMerkleRoot",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Merkle root of the filing",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingMerkleRoot",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/FilingMerkleRoot",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:FilingMerkleRoot",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingMerkleRoot",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/FilingMerkleRootMethodDomain",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FilingMerkleRootMethodDomain",
            "@type": "xsd:anyURI"
          },
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
        {
