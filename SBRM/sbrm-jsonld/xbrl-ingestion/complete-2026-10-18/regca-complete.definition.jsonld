          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BNP_D_03_XML\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"exists($AffiliateEstimatedStakeSharePercentage) and abs($AffiliateEstimatedStakeSharePercentage * $TotalActiveStakeOnNetwork - $AffiliateEffectiveStakeControlledOnNetwork) le $P_shareRoundingTolerance * $TotalActiveStakeOnNetwork\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_AffiliateEffectiveStakeControlledOnNetwork\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_AffiliateEffectiveStakeControlledOnNetwork\" name=\"AffiliateEffectiveStakeControlledOnNetwork\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_AffiliateEffectiveStakeControlledOnNetwork_concept\">\n    <cf:concept><cf:qname>regca:AffiliateEffectiveStakeControlledOnNetwork</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateEffectiveStakeControlledOnNetwork\" xlink:to=\"f_AffiliateEffectiveStakeControlledOnNetwork_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_AffiliateEffectiveStakeControlledOnNetwork_typed2\">\n    <df:dimension><df:qname>regca:AffiliateIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateEffectiveStakeControlledOnNetwork\" xlink:to=\"f_AffiliateEffectiveStakeControlledOnNetwork_typed2\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_AffiliateEffectiveStakeControlledOnNetwork_typed3\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateEffectiveStakeControlledOnNetwork\" xlink:to=\"f_AffiliateEffectiveStakeControlledOnNetwork_typed3\" complement=\"false\" cover=\"false\" order=\"3\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_TotalActiveStakeOnNetwork\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_TotalActiveStakeOnNetwork\" name=\"TotalActiveStakeOnNetwork\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_TotalActiveStakeOnNetwork_concept\">\n    <cf:concept><cf:qname>regca:TotalActiveStakeOnNetwork</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalActiveStakeOnNetwork\" xlink:to=\"f_TotalActiveStakeOnNetwork_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_TotalActiveStakeOnNetwork_typed2\">\n    <df:dimension><df:qname>regca:AffiliateIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalActiveStakeOnNetwork\" xlink:to=\"f_TotalActiveStakeOnNetwork_typed2\" complement=\"true\" cover=\"true\" order=\"2\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_TotalActiveStakeOnNetwork_typed3\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalActiveStakeOnNetwork\" xlink:to=\"f_TotalActiveStakeOnNetwork_typed3\" complement=\"false\" cover=\"false\" order=\"3\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_AffiliateEstimatedStakeSharePercentage\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_AffiliateEstimatedStakeSharePercentage\" name=\"AffiliateEstimatedStakeSharePercentage\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_AffiliateEstimatedStakeSharePercentage_concept\">\n    <cf:concept><cf:qname>regca:AffiliateEstimatedStakeSharePercentage</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateEstimatedStakeSharePercentage\" xlink:to=\"f_AffiliateEstimatedStakeSharePercentage_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_AffiliateEstimatedStakeSharePercentage_typed2\">\n    <df:dimension><df:qname>regca:AffiliateIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateEstimatedStakeSharePercentage\" xlink:to=\"f_AffiliateEstimatedStakeSharePercentage_typed2\" complement=\"f