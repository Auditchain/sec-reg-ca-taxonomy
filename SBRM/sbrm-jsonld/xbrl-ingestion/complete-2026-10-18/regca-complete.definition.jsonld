        {
          "@id": "regca-complete:mvf/entry/AffiliatePerimeterAttestingOfficerIdentifier",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_AffiliatePerimeterAttestingOfficerIdentifier",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Stable issuer-assigned identifier for the certifying officer, carried across filings so the same person is recognisable when a middle initial, a suffix or a nickname changes the reported name. Deliberately NOT a Legal Entity Identifier: an LEI under ISO 17442 identifies a legal entity, and the only LEIs on this schedule belong to the issuer and to the enumerated affiliates - regca:AffiliateLegalEntityIdentifier. Demanding one for a natural person would be a category error and would invite a false value.",
          "mvf:hasSemanticReference": [
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets",
            "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405",
            "https://raw.rutgers.edu/Testing-Machine-Readable-Compliance.pdf",
            "https://tile.loc.gov/storage-services/service/ll/usrep/usrep426/usrep426438/usrep426438.pdf"
          ]
        },
        {
