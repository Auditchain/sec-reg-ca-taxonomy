            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BDAY_03\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($Para) = ('http://luca.pacioli.ai/report#Rule302f1Member', 'http://luca.pacioli.ai/report#Rule302f3Member')) or (empty($PriceDate) and empty($FirstUse)) or xs:date($Doc) le (for $bd0 in xs:date(min((for $x in ($PriceDate, $FirstUse) return xs:date($x)))), $bw0 in (days-from-duration($bd0 - xs:date('2000-01-03')) mod 7), $bdf in ($bd0 - xs:dayTimeDuration(concat('P', string(max((0, $bw0 - 4))), 'D'))), $bwf in min(($bw0, 4)) return $bdf + xs:dayTimeDuration(concat('P', string($P_pricingSupplementBusinessDays + 2 * (($bwf + $P_pricingSupplementBusinessDays) idiv 5)), 'D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Para\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Para\" name=\"Para\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Para_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularSupplementRule302fParagraph</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Para_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Doc\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Doc\" name=\"Doc\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Doc_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Doc_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_PriceDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_PriceDate\" name=\"PriceDate\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_PriceDate_concept\">\n    <cf:concept><cf:qname>regca:OfferingPriceDeterminationDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PriceDate\" xlink:to=\"f_PriceDate_concept\" comple