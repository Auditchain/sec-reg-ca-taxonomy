        {
          "@id": "regca-complete:reference/1611",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AffiliateNetworkParticipationByAffiliateTable",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/securities-and-exchange-commission",
          "dct:title": "17 CFR 230.405 (Securities Act Rule 405), incorporated by 17 CFR 228.100",
          "dct:bibliographicCitation": "17 CFR 230.405 (affiliate)",
          "cmns-docc:hasTextualContent": "Verbatim: \"An affiliate of, or person affiliated with, a specified person, is a person that directly, or indirectly through one or more intermediaries, controls or is controlled by, or is under common control with, the person specified.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405"
          },
          "dct:date": {
            "@value": "2026-09-01",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 1611,
          "xbrlb:sourceIndex": 1610
        },
        {
          "@id": "regca-complete:reference/1612",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AffiliateNetworkParticipationByAffiliateTable",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/securities-and-exchange-commission",
          "dct:title": "17 CFR 230.405 (Securities Act Rule 405), incorporated by 17 CFR 228.100",
          "dct:bibliographicCitation": "17 CFR 230.405 (control)",
          "cmns-docc:hasTextualContent": "Verbatim: \"the possession, direct or indirect, of the power to direct or cause the direction of the management and policies of a person, whether through the ownership of voting securities, by contract, or otherwise\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405"
          },
          "dct:date": {
            "@value": "2026-09-01",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 1612,
          "xbrlb:sourceIndex": 1611
        },
