          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/FilingProvenanceAbstract",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FilingProvenanceAbstract",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root of the filing, the method used to compute it, the root of the issuer's previous filing and the address of the taxonomy the filing uses, so that anyone can check that the filing has not changed since it was filed and where it sits in the issuer's chain of filings.",
          "mvf:hasSemanticReference": [
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets",
            "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/FilingProvenanceAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Filing provenance (proposed) [abstract]",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingProvenanceAbstract",
