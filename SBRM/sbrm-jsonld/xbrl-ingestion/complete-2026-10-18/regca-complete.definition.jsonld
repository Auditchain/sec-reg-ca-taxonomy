            "regca-complete:reference/2236"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CombinedEntitiesCouldInfluenceConsensusIndicator"
        },
        {
          "@id": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "rdfs:label": {
            "@value": "Affiliate perimeter attesting officer title",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Title of the officer attesting to the affiliate perimeter, as the issuer itself styles the position. Reported in addition to regca:AffiliatePerimeterAttestingOfficerRole, which normalises the officer into standard role categories; this element preserves the issuer's own title for the person.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2208",
            "regca-complete:reference/2209",
            "regca-complete:reference/2210",
            "regca-complete:reference/2211"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliatePerimeterAttestingOfficerTitle"
        },
        {
          "@id": "regca:AffiliatePerimeterAttestingOfficerIdentifier",
          "rdfs:label": {
            "@value": "Affiliate perimeter attesting officer identifier",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Stable issuer-assigned identifier for the certifying officer, carried across filings so the same person is recognisable when a middle initial, a suffix or a nickname changes the reported name. Deliberately NOT a Legal Entity Identifier: an LEI under ISO 17442 identifies a legal entity, and the only LEIs on this schedule belong to the issuer and to the enumerated affiliates - regca:AffiliateLegalEntityIdentifier. Demanding one for a natural person would be a category error and would invite a false value.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2216",
            "regca-complete:reference/2217",
            "regca-complete:reference/2218",
            "regca-complete:reference/2219"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliatePerimeterAttestingOfficerIdentifier"
        },
        {
          "@id": "regca:AffiliatePerimeterAttestingOfficerRole",
          "rdfs:label": {
            "@value": "Affiliate perimeter attesting officer role",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Role category of the officer attesting to the affiliate perimeter. The residual member regca:FunctionalEquivalentExecutiveOfficerMember covers a signer who holds none of the listed titles but serves in the functional capacity of one; a signer who serves in no such capacity has no member to select.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2212",
            "regca-complete:reference/2213",
            "regca-complete:reference/2214",
            "regca-complete:reference/2215"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliatePerimeterAttestingOfficerRole"
        },
        {
          "@id": "regca:AffiliatePerimeterAttestationDate",
          "rdfs:label": {
            "@value": "Affiliate perimeter attestation date",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Date on which the certifying officer signed the affiliate-perimeter completeness certification. Must fall on or after the reporting date and on or before the filing date.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2220",
            "regca-complete:reference/2221",
            "regca-complete:reference/2222",
            "regca-complete:reference/2223"
          ],
