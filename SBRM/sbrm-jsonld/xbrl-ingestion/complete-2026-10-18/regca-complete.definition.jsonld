          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_SIG_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($DocumentType) = ('http://luca.pacioli.ai/report#Form1CRYPTOMember', 'http://luca.pacioli.ai/report#Form1KCMember', 'http://luca.pacioli.ai/report#Form1SCMember', 'http://luca.pacioli.ai/report#StartupRule103DisclosureMember')) or string($SubType) eq 'http://luca.pacioli.ai/report#OfferingCircularSupplementMember' or (string($DocumentType) = ('http://luca.pacioli.ai/report#Form1KCMember', 'http://luca.pacioli.ai/report#Form1SCMember') and string($Amend) eq 'true') or (every $m in ('http://luca.pacioli.ai/report#PrincipalExecutiveOfficerMember', 'http://luca.pacioli.ai/report#PrincipalFinancialOfficerMember', 'http://luca.pacioli.ai/report#PrincipalAccountingOfficerMember') satisfies $m = (for $c in $Caps return string($c)))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SubType\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SubType\" name=\"SubType\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SubType_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementSubmissionType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_SubType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Caps\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Caps\" name=\"Caps\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Caps_concept\">\n    <cf:concept><cf:qname>regca:SignatoryCapacity</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed1\">\n    <df:dimension><df:qname>regca:SignatoryEntityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed1\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed2\">\n    <df:dimension><df:qname>regca:SignatoryIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed2\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed3\">\n    <df:dimension><df:qname>regca:SignatoryCapacityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed3\" complement=\"false\" cover=\"true\" order=\"4\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Caps_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_period\" complement=\"false\" cover=\"true\" order=\"5\"/>\n</gen:link>",
