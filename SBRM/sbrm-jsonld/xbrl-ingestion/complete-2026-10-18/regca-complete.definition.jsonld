        },
        {
          "@id": "regca:MiningOrStakingAssetsPledgedOrEncumberedIndicator",
          "rdfs:label": {
            "@value": "Mining or staking assets pledged or encumbered indicator",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "dct:source": [
