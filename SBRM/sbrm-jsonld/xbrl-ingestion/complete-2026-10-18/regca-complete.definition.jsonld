        {
          "@id": "regca-complete:rule/REGCA_OFFER_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_OFFER_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_OFFER_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"abs($AOP - $Units * $Price) le $P_monetaryTolerance\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_AOP\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_AOP\" name=\"AOP\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_AOP_concept\">\n    <cf:concept><cf:qname>regca:AggregateOfferingPrice</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AOP\" xlink:to=\"f_AOP_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_AOP_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AOP\" xlink:to=\"f_AOP_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Units\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Units\" name=\"Units\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Units_concept\">\n    <cf:concept><cf:qname>regca:UnitsOfCoveredInvestmentContractsOffered</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Units\" xlink:to=\"f_Units_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Units_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Units\" xlink:to=\"f_Units_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Price\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Price\" name=\"Price\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Price_concept\">\n    <cf:concept><cf:qname>regca:PurchasePricePerUnit</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Price_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
