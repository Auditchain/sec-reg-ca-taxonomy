              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_COVER_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"count(distinct-values(for $d in $DocumentTypes return tokenize(normalize-space(string($d)), ' '))) eq 1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Filing\" bindAsSequence=\"true\" matches=\"true\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Filing\" name=\"Filing\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Filing_concept\">\n    <cf:concept><cf:qname>regca:IssuerName</cf:qname></cf:concept>\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n    <cf:concept><cf:qname>regca:FilingMerkleRoot</cf:qname></cf:concept>\n    <cf:concept><cf:qname>regca:TaxonomyEntryPointAddress</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Filing\" xlink:to=\"f_Filing_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Filing_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/vari