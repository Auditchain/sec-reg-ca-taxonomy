        {
          "@id": "regca-complete:mvf/entry/OfferingStatementQualificationDate",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_OfferingStatementQualificationDate",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. In a special financial report, the date the Commission qualified the offering statement (Rule 305(a)(2)(ii)). In a post-qualification amendment, the most recent qualification date: the offering statement or the last post-qualification amendment (Rule 301(f)(2)). The forms do not ask for it, but these deadlines run from it. In an offering circular filed under Rule 302(f)(1) or (3), the later of the qualification date of the offering statement and that of a post-qualification amendment containing an offering circular; the omitted pricing information is filed within 15 business days after it (Rule 302(c)).",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
