        {
          "@id": "regca-complete:rule/REGCA_FS_PERIOD_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_FS_PERIOD_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FS_PERIOD_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not((string($DocumentType) eq 'http://luca.pacioli.ai/report#Form1KCMember' and string($ReportType) eq 'http://luca.pacioli.ai/report#AnnualReportMember') or (string($DocumentType) eq 'http://luca.pacioli.ai/report#Form1SCMember' and string($ReportType) eq 'http://luca.pacioli.ai/report#SemiannualReportMember')) or string($Amend) eq 'true' or (some $i in (for $a in $BalanceSheets return xfi:period-instant(xfi:period($a))) satisfies $i eq xs:dateTime(concat(string($End), 'T00:00:00')) + xs:dayTimeDuration('P1D'))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_ReportType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_ReportType\" name=\"ReportType\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_ReportType_concept\">\n    <cf:concept><cf:qname>regca:PeriodicReportType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_ReportType\" xlink:to=\"f_ReportType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_ReportType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_ReportType\" xlink:to=\"f_ReportType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\"