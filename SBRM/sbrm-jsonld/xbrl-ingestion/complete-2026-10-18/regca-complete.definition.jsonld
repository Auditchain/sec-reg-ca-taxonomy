          "rdfs:label": {
            "@value": "Date the offering price was determined",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. For an offering circular filed under Rule 302(f)(1) or (3): the date the offering price was set. The filing is due two business days after the earlier of this date and the date of first use.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1316",
            "regca-complete:reference/1317"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/OfferingPriceDeterminationDate"
        },
        {
          "@id": "regca:CoveredTransactionExchangeRateDate",
          "rdfs:label": {
            "@value": "Date of the exchange rate used",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. The date the rate was in effect: on, or a reasonable time before, the date of the covered transaction.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1315",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CoveredTransactionExchangeRateDate"
        },
        {
          "@id": "regca:CoveredTransactionExchangeRate",
          "rdfs:label": {
            "@value": "Exchange rate used (U.S. dollars per unit of foreign currency)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Rate applied to translate the amount into U.S. dollars. The U.S. dollar consideration value equals the foreign amount times this rate.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1314",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CoveredTransactionExchangeRate"
        },
