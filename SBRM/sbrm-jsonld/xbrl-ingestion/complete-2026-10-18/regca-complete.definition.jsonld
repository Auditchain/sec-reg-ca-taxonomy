          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/PostQualificationAmendmentBasis"
        },
        {
          "@id": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "rdfs:label": {
            "@value": "Amendment includes amended audited financial statements",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "If true, the amendment must include the consent of the certifying accountant (filed as an exhibit).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1087",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AmendedAuditedFinancialStatementsIncludedIndicator"
