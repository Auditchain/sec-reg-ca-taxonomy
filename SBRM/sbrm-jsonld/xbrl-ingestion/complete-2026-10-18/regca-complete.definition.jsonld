        {
          "@id": "regca-complete:mvf/entry/ObligationToDeliverSubjectCryptoAsset",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_ObligationToDeliverSubjectCryptoAsset",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Liability for units of the subject crypto asset that the issuer is obligated to deliver for consideration it has already received or recognized - for example, units payable for an asset acquired, or units sold in advance of delivery. Recognized at the amount recognized for the consideration (the fair value of the units, or of the consideration, whichever is more clearly evident) and derecognized when the units are delivered and the issuer is relieved of the obligation (ASC 405-20-40-1). Presented separately from other liabilities when material; a noncash acquisition settled in units is disclosed under ASC 230-10-50-4.",
          "mvf:hasSemanticReference": [
            "https://storage.fasb.org/ASU%202016-04.pdf",
            "https://storage.fasb.org/ASU%202016-15.pdf",
            "https://storage.fasb.org/ASU%202022-03.pdf"
