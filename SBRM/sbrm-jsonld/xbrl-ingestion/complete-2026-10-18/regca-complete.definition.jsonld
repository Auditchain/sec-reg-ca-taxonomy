          "rdf:value": {
            "@value": "Basis for post-qualification amendment [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 636
        },
        {
          "@id": "regca-complete:label/PostQualificationAnnualUpdateMember/Standard/en",
