          "xbrlb:labelOf": "regca:DepartingOfficerName",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The form asks only for the fact and date of the departure; the name makes the event traceable.",
