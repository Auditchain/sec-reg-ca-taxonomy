          "dct:identifier": "REGCA_C_OFFER_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$AggregateOfferingPrice = $UnitsOfCoveredInvestmentContractsOffered * $PurchasePricePerUnit"
          },
          "cmns-cxtdsg:appliesTo": "regca-complete:fragment/regca-22-offering",
