            "@value": "Third-party provides blockchain network services indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1150
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderLegalName/Standard/en",
          "@type": "xbrlb:Label",
