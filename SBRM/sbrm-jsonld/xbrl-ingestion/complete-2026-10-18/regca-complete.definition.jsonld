        {
          "@id": "regca-complete:label/StartupRule103DisclosureMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:StartupRule103DisclosureMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Form 1-SU — startup disclosure statement (proposed form) [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 9
        },
        {
          "@id": "regca-complete:label/StartupRule103DisclosureMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:StartupRule103DisclosureMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The Rule 103 information an issuer relying on the startup exemption must make publicly accessible at the website named in its Form NOR, and any amendment made within 30 days after a calendar year-end because of material changes. Auditchain Labs recommends (Request for Comment 65) that this disclosure be an official form, Form 1-SU, filed with the Commission in structured form (XBRL) in the same way an offering statement is filed, signed like Form 1-CRYPTO, and posted on the issuer's website in Inline XBRL, so that the Commission can capture every fact of every filing in the lifecycle of a project and supervise in an automated manner.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 10
        },
        {
          "@id": "regca-complete:label/Form1CRYPTOMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Form1CRYPTOMember",
