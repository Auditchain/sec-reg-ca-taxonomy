        {
          "@id": "regca-complete:mvf/entry/UnitsOfCoveredInvestmentContractsOffered",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_UnitsOfCoveredInvestmentContractsOffered",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Number of units of covered investment contract offered, in the unit the issuer defines. Rule 101(e)(1) as proposed makes one unit of a covered investment contract one unit of the subject crypto asset; Auditchain Labs recommends that an issuer be permitted to define the unit as a functional unit - the subject crypto asset together with the software or other technical primitives the crypto asset invokes (for Pacioli.ai, a Pacioli Validating Node of 50,000 AUDT with its node software license) - with the Rule 101(e) measures reported alongside in the functional-unit elements. Where the unit is the crypto asset itself, the two agree.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
