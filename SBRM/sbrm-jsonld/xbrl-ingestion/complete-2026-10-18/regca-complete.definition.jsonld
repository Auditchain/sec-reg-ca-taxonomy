        },
        {
          "@id": "regca-complete:reference/2480",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "Request for comment No. 28 (91 FR 54527); 91 FR 54527",
          "cmns-docc:hasTextualContent": "Verbatim: \"Are there any other disclosure requirements that we should specify in Rule 103?\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
