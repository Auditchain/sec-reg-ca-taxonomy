        {
          "@id": "regca-complete:label/NoticeOfRelianceIntroduction/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NoticeOfRelianceIntroduction",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. What the notice is and why it is filed (to make investors, the Commission and the public aware that the issuer has begun to rely on the startup exemption), the four-year period that its filing starts and the date on which that period ends, where the Rule 103 disclosure is publicly accessible, and the issuer's duty to amend the notice.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 216
        },
        {
          "@id": "regca-complete:label/NoticeOfRelianceCoveredInvestmentContractAndCryptoAssetDescription/Standard/en",
