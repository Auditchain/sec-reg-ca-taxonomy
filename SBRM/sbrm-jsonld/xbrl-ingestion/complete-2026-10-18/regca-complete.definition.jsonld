        {
          "@id": "regca-complete:mvf/entry/NetworkRewardAllocationGovernanceDescription",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_NetworkRewardAllocationGovernanceDescription",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Who can change the allocation of network rewards among recipients, including subsidies paid in the subject crypto asset, before and after the deployment of the governance contract, and how a change is made once the allocation is subject to governance.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
