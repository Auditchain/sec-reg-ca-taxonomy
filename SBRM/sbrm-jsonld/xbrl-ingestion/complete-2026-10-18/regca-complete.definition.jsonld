        },
        {
          "@id": "regca-complete:mvf/entry/FunctionalUnitAbstract",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FunctionalUnitAbstract",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Auditchain Labs recommends (Requests for Comment 6, 7 and 31) that an issuer may define the unit of a covered investment contract as a functional unit: the subject crypto asset together with the software or other technical primitives the crypto asset invokes and that an institution needs to stand up and operate the network (for Pacioli.ai, a Pacioli Validating Node of 50,000 AUDT with its node software license). The elements below carry the crypto-asset content of each unit and the measures Rule 101(e) as proposed would report, so the Commission can read the offering either way and the per-crypto-asset arithmetic can be checked. The recommendation is intended to make the exemption easier to use for building real utility than for a token sale with nothing behind it.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/FunctionalUnitAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Functional unit of covered investment contract and Rule 101(e) equivalents [abstract]",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FunctionalUnitAbstract",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/FunctionalUnitAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:FunctionalUnitAbstract",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FunctionalUnitAbstract",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/SubjectCryptoAssetUnitsPerUnit",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_SubjectCryptoAssetUnitsPerUnit",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The number of units of the subject crypto asset delivered with each unit of covered investment contract as the issuer defines the unit. 1 where the unit is the crypto asset itself.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
