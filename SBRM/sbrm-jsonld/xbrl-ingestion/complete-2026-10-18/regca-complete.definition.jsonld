            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BNP_R1_STAKE_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"$EffectiveStakeControlledOnNetwork ge 0 and (not($EffectiveStakeControlledOnNetwork gt 0) or exists($TotalValueStaked)) and (not(exists($TotalValueStaked)) or ($TotalValueStaked ge 0 and (($TotalValueStaked gt 0) eq ($EffectiveStakeControlledOnNetwork gt 0))))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_EffectiveStakeControlledOnNetwork\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_EffectiveStakeControlledOnNetwork\" name=\"EffectiveStakeControlledOnNetwork\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_EffectiveStakeControlledOnNetwork_concept\">\n    <cf:concept><cf:qname>regca:EffectiveStakeControlledOnNetwork</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_EffectiveStakeControlledOnNetwork\" xlink:to=\"f_EffectiveStakeControlledOnNetwork_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_EffectiveStakeControlledOnNetwork_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_EffectiveStakeControlledOnNetwork\" xlink:to=\"f_EffectiveStakeControlledOnNetwork_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_EffectiveStakeControlledOnNetwork_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_EffectiveStakeControlledOnNetwork\" xlink:to=\"f_EffectiveStakeControlledOnNetwork_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_TotalValueStaked\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_TotalValueStaked\" name=\"TotalValueStaked\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_TotalValueStaked_concept\">\n    <cf:concept><cf:qname>regca:TotalValueStaked</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalValueStaked\" xlink:to=\"f_TotalValueStaked_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_TotalValueStaked_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalValueStaked\" xlink:to=\"f_TotalValueStaked_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_TotalValueStaked_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalValueStaked\" xlink:to=\"f_TotalValueStaked_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
