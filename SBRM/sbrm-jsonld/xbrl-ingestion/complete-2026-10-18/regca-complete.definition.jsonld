          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/FilingProvenanceAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:FilingProvenanceAbstract",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingProvenanceAbstract",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/PreviousFilingMerkleRoot",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_PreviousFilingMerkleRoot",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root reported by the issuer's previous filing under Regulation Crypto Assets, as 64 lowercase hexadecimal characters. It is covered by this filing's own root, so the issuer's filings form a chain: a change to an earlier filing breaks every later link. Left blank in the issuer's first filing.",
          "mvf:hasSemanticReference": [
            "https://www.rfc-editor.org/rfc/rfc6962",
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/PreviousFilingMerkleRoot",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Merkle root of the issuer's previous filing",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/PreviousFilingMerkleRoot",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/PreviousFilingMerkleRoot",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:PreviousFilingMerkleRoot",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/PreviousFilingMerkleRoot",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/PreviousFilingDate",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_PreviousFilingDate",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The date of the issuer's previous filing under Regulation Crypto Assets, whose merkle root is reported in this filing. Left blank in the issuer's first filing.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/PreviousFilingDate",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Date of the issuer's previous filing",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/PreviousFilingDate",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/PreviousFilingDate",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:PreviousFilingDate",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/PreviousFilingDate",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/FilingMerkleTreeVersion1Member",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FilingMerkleTreeVersion1Member",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Each fact is written as a JSON object with the keys concept, entity, period, dimensions, unit, decimals and value, leaving out keys with no value; concepts, dimensions and members are written as namespace, \"#\" and local name, and a typed dimension by its value. The object is serialized under RFC 8785 (JSON Canonicalization Scheme). Each leaf is SHA-256 (FIPS 180-4) of the byte 0x00 followed by that serialization; the leaves are sorted in ascending order and combined into the Merkle Tree Hash of RFC 6962, section 2.1. Left out of the root: the root itself, this method and every fact in the table of anchors.",
          "mvf:hasSemanticReference": [
            "https://www.rfc-editor.org/rfc/rfc8785",
            "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf",
            "https://www.rfc-editor.org/rfc/rfc6962",
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/FilingMerkleTreeVersion1Member",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Reg CA filing merkle tree, version 1 [member]",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingMerkleTreeVersion1Member",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/FilingMerkleTreeVersion1Member",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:FilingMerkleTreeVersion1Member",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingMerkleTreeVersion1Member",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/TaxonomyEntryPointAddress",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_TaxonomyEntryPointAddress",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The address of the taxonomy entry point under which the filing is prepared and validated. It is covered by the filing's merkle root.",
          "mvf:hasSemanticReference": [
            "https://www.xbrl.org/Specification/taxonomy-package/REC-2016-04-19/taxonomy-package-REC-2016-04-19.html",
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/TaxonomyEntryPointAddress",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Address of the taxonomy entry point used by the filing",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/TaxonomyEntryPointAddress",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/TaxonomyEntryPointAddress",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:TaxonomyEntryPointAddress",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/TaxonomyEntryPointAddress",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/FilingAnchorsAbstract",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_FilingAnchorsAbstract",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each record of the filing's merkle root on a blockchain network: the network, the transaction whose data is the root, its block and date, and a link where anyone can verify it. The anchors are left out of the root.",
          "mvf:hasSemanticReference": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/FilingAnchorsAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Anchors of the filing's merkle root (proposed) [abstract]",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingAnchorsAbstract",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/standard-labels",
          "mvf:isPreferred": true
        },
        {
          "@id": "regca-complete:mvf/term/xbrl/FilingAnchorsAbstract",
          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "regca:FilingAnchorsAbstract",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/FilingAnchorsAbstract",
          "cmns-col:isIncludedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy",
          "cmns-dsg:isDefinedIn": "regca-complete:mvf/vocabulary/xbrl-taxonomy"
        },
        {
          "@id": "regca-complete:mvf/entry/BlockchainNetworkIdentifier",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_BlockchainNetworkIdentifier",
            "@type": "xsd:anyURI"
          },
