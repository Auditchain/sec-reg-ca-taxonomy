        {
          "@id": "regca-complete:mvf/entry/OmittedDisclosureItemsAbstract",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_OmittedDisclosureItemsAbstract",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 103(a) excuses an item that is not applicable or whose information is unknown or not reasonably available, but does not ask the issuer to say which items it relied on this for. Each such item is listed here with the reason, so an omission can be told apart from an oversight.",
          "mvf:hasSemanticReference": [
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets",
            "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf",
            "https://raw.rutgers.edu/Testing-Machine-Readable-Compliance.pdf"
          ]
        },
        {
          "@id": "regca-complete:mvf/term/standard-label/OmittedDisclosureItemsAbstract",
          "@type": "mvf:VocabularyEntry",
