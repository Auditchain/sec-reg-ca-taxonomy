          "dct:bibliographicCitation": "PDF p. 12",
          "cmns-docc:hasTextualContent": "Verbatim: \"Replicates the entire affiliate disclosure schema per individual affiliate entity using the AffiliateIdentifierTypedAxis.\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf"
