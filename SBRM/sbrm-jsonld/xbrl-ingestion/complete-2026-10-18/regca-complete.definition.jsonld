/variable-filter\" xlink:from=\"v_EntityHoldsGovernanceTokensIndicator\" xlink:to=\"f_EntityHoldsGovernanceTokensIndicator_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_EntityHoldsGovernanceTokensIndicator_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_EntityHoldsGovernanceTokensIndicator\" xlink:to=\"f_EntityHoldsGovernanceTokensIndicator_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_GovernanceTokensQuantityHeld\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_GovernanceTokensQuantityHeld\" name=\"GovernanceTokensQuantityHeld\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_GovernanceTokensQuantityHeld_concept\">\n    <cf:concept><cf:qname>regca:GovernanceTokensQuantityHeld</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_GovernanceTokensQuantityHeld\" xlink:to=\"f_GovernanceTokensQuantityHeld_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_GovernanceTokensQuantityHeld_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_GovernanceTokensQuantityHeld\" xlink:to=\"f_GovernanceTokensQuantityHeld_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\