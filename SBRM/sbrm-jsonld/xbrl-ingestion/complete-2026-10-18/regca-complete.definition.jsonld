        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderLegalEntityIdentifier/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderLegalEntityIdentifier",
