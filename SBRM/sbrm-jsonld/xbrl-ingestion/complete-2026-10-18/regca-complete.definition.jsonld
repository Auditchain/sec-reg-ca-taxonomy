          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PriorRegulationCryptoAssetsOfferingAddress",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Asked so a reader can see earlier offerings under Regulation Crypto Assets that bear on aggregate sales (Rule 100), on whether this is the issuer's first offering or one qualified within a year of it (Rule 300(a)(3)(i)-(ii)) and on one-time use of the startup exemption (Rule 200(b)(3)). A URL where the offering can be found, such as its EDGAR filing or the startup disclosure website.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 938
        },
