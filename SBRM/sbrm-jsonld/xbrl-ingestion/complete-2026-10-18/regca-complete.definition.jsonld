          "xbrlb:referenceOf": "regca:CostOfRevenue",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Subtopic 340-40, Other Assets and Deferred Costs—Contracts with Customers (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "Subtopic 340-40",
          "cmns-docc:hasTextualContent": "Topic title as published: \"Subtopic 340-40, Other Assets and Deferred Costs—Contracts with Customers\" (Subtopic title as published in FASB ASU 2014-09)",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
