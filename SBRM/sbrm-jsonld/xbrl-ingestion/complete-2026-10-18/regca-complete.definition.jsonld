        {
          "@id": "regca:PriorRegulationCryptoAssetsOfferingDescription",
          "rdfs:label": {
            "@value": "Description of the offering",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Asked so a reader can see earlier offerings under Regulation Crypto Assets that bear on aggregate sales (Rule 100), on whether this is the issuer's first offering or one qualified within a year of it (Rule 300(a)(3)(i)-(ii)) and on one-time use of the startup exemption (Rule 200(b)(3)). A text box describing one offering: for example the exemption relied on, dates, units and amounts sold.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1397",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/PriorRegulationCryptoAssetsOfferingDescription"
        },
        {
          "@id": "regca:PriorRegulationCryptoAssetsOfferingAddress",
