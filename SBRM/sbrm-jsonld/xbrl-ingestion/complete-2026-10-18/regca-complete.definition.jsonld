          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ForeignCurrencySaleDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. ",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 855
        },
        {
          "@id": "regca-complete:label/ForeignCurrencyAmountInUSD/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ForeignCurrencyAmountInUSD",
