          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "17 CFR 228.200(b)(1); 91 FR 54609",
          "cmns-docc:hasTextualContent": "Verbatim: \"The covered transaction must occur during the period beginning after the issuer has filed a notice of reliance\"",
