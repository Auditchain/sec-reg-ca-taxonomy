          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BNP_EX_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($AffiliateParticipatesOnSameProtocolIndicator) ne 'true' or count($AffiliateNetworkShare) ge 1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_AffiliateParticipatesOnSameProtocolIndicator\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_AffiliateParticipatesOnSameProtocolIndicator\" name=\"AffiliateParticipatesOnSameProtocolIndicator\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_AffiliateParticipatesOnSameProtocolIndicator_concept\">\n    <cf:concept><cf:qname>regca:AffiliateParticipatesOnSameProtocolIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateParticipatesOnSameProtocolIndicator\" xlink:to=\"f_AffiliateParticipatesOnSameProtocolIndicator_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_AffiliateParticipatesOnSameProtocolIndicator_typed2\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateParticipatesOnSameProtocolIndicator\" xlink:to=\"f_AffiliateParticipatesOnSameProtocolIndicator_typed2\" complement=\"true\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_AffiliateNetworkShare\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_AffiliateNetworkShare\" name=\"AffiliateNetworkShare\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_AffiliateNetworkShare_concept\">\n    <cf:concept><cf:qname>regca:AffiliateEstimatedStakeSharePercentage</cf:qname></cf:concept>\n    <cf:concept><cf:qname>regca:AffiliateEstimatedHashPowerSharePercentage</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateNetworkShare\" xlink:to=\"f_AffiliateNetworkShare_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_AffiliateNetworkShare_typed2\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateNetworkShare\" xlink:to=\"f_AffiliateNetworkShare_typed2\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_AffiliateNetworkShare_unit3\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_AffiliateNetworkShare\" xlink:to=\"f_AffiliateNetworkShare_unit3\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
