        {
          "@id": "regca-complete:label/BoardOrGoverningBodyMemberCount/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BoardOrGoverningBodyMemberCount",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Needed to test that a majority of the board signs Form 1-CRYPTO and Form 1-KC.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 824
        },
        {
          "@id": "regca-complete:label/CoveredTransactionForeignCurrencyCode/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionForeignCurrencyCode",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Currency of consideration received (ISO 4217 code)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 825
        },
        {
          "@id": "regca-complete:label/CoveredTransactionForeignCurrencyCode/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionForeignCurrencyCode",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. The three-letter ISO 4217 code of the foreign currency received in this covered transaction.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 826
        },
        {
          "@id": "regca-complete:label/CoveredTransactionForeignCurrencyAmount/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionForeignCurrencyAmount",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Consideration received in the foreign currency",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 827
        },
        {
          "@id": "regca-complete:label/CoveredTransactionForeignCurrencyAmount/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionForeignCurrencyAmount",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Amount received, in the foreign currency (the fact's unit is that currency).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 828
        },
        {
          "@id": "regca-complete:label/CoveredTransactionExchangeRate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionExchangeRate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Exchange rate used (U.S. dollars per unit of foreign currency)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 829
        },
        {
          "@id": "regca-complete:label/CoveredTransactionExchangeRate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionExchangeRate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Rate applied to translate the amount into U.S. dollars. The U.S. dollar consideration value equals the foreign amount times this rate.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 830
        },
        {
          "@id": "regca-complete:label/CoveredTransactionExchangeRateDate/Standard/en",
