        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderArrangementsAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderArrangementsAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider arrangements [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1145
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderArrangementsAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderArrangementsAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. For each non-affiliate third party that provides blockchain network participation services to or for the issuer: who it is, what it does, what it is paid, and any conflicts. Carried over from Section 8 of the BNP questionnaire (questions 137-148) without questions 142-145 on yield facilitation and reserve-to-yield relationships, which are specific to payment stablecoins. The items reported for a period are in a table of their own, \"Rule 103(b)(9) — third-party service provider arrangements for the period\".",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1146
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderByProviderTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderByProviderTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider by provider [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1147
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider identifier [typed axis]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1148
        },
        {
