        {
          "@id": "regca-complete:reference/837",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:GainLossOnRemeasurementOfCryptoAssets",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Subtopic 350-60, Intangibles—Goodwill and Other—Crypto Assets (as added by ASU 2023-08)",
          "dct:bibliographicCitation": "ASC 350-60-45-2 (ASU PDF p. 14)",
          "cmns-docc:hasTextualContent": "Verbatim: \"Gains and losses from the remeasurement of crypto assets shall be included in net income and presented separately from changes in the carrying amount of other intangible assets.\"",
