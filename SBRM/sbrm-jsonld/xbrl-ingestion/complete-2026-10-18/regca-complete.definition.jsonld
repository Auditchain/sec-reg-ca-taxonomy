        },
        {
          "@id": "regca-complete:reference/2288",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:OperationalControlsAndPoliciesAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/auditchain-labs-ag",
          "dct:title": "Comment letter to the FDIC on GENIUS Act requirements and standards, RIN 3064-AG19, 91 FR 18534 (May 14, 2026)",
          "dct:bibliographicCitation": "PDF p. 4",
          "cmns-docc:hasTextualContent": "Verbatim: \"Internal controls and information systems (§ 350.6(a)(1)) do not address validator uptime monitoring, consensus participation metrics, slashing risk management, or maximum extractable value (\"MEV\") mitigation strategies.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.fdic.gov/federal-register-publications/auditchain-labs-ag-jason-meyers-rin-3064-ag19.pdf"
          },
          "dct:date": {
            "@value": "2026-05-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2288,
          "xbrlb:sourceIndex": 2287
        },
        {
          "@id": "regca-complete:reference/2289",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:OperationalControlsAndPoliciesAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/federal-deposit-insurance-corporation",
          "dct:title": "12 CFR Part 364, Appendix A — Interagency Guidelines Establishing Standards for Safety and Soundness",
          "dct:bibliographicCitation": "Appendix A, II.A (Internal controls and information systems)",
          "cmns-docc:hasTextualContent": "Verbatim: \"An institution should have internal controls and information systems that are appropriate to the size of the institution and the nature, scope and risk of its activities\" Banking-agency standard, cited by analogy; relied on in Auditchain's FDIC comments (RIN 3064-AG20, Feb. 9, 2026; RIN 3064-AG19, May 14, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-12/chapter-III/subchapter-B/part-364/appendix-Appendix%20A%20to%20Part%20364"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2289,
          "xbrlb:sourceIndex": 2288
        },
        {
          "@id": "regca-complete:reference/2290",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:OperationalControlsAndPoliciesAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/federal-deposit-insurance-corporation",
          "dct:title": "12 CFR Part 364, Appendix A — Interagency Guidelines Establishing Standards for Safety and Soundness",
          "dct:bibliographicCitation": "Appendix A, II.A.1-2",
          "cmns-docc:hasTextualContent": "Verbatim: \"An organizational structure that establishes clear lines of authority and responsibility for monitoring adherence to established policies; 2 . Effective risk assessment\" Banking-agency standard, cited by analogy; relied on in Auditchain's FDIC comments (RIN 3064-AG20, Feb. 9, 2026; RIN 3064-AG19, May 14, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-12/chapter-III/subchapter-B/part-364/appendix-Appendix%20A%20to%20Part%20364"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2290,
          "xbrlb:sourceIndex": 2289
        },
        {
          "@id": "regca-complete:reference/2291",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:OperationalControlsAndPoliciesAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/federal-deposit-insurance-corporation",
          "dct:title": "12 CFR Part 364, Appendix A — Interagency Guidelines Establishing Standards for Safety and Soundness",
          "dct:bibliographicCitation": "Appendix A, II.B (Internal audit system)",
          "cmns-docc:hasTextualContent": "Verbatim: \"Adequate monitoring of the system of internal controls through an internal audit function\" Banking-agency standard, cited by analogy; relied on in Auditchain's FDIC comments (RIN 3064-AG20, Feb. 9, 2026; RIN 3064-AG19, May 14, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-12/chapter-III/subchapter-B/part-364/appendix-Appendix%20A%20to%20Part%20364"
