        {
          "@id": "regca-complete:rule/REGCA_PARAMETERS",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_PARAMETERS",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_startupOfferingLimit\" name=\"P_startupOfferingLimit\" select=\"5000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_startupPeriodYears\" name=\"P_startupPeriodYears\" select=\"4\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_annualUpdateDays\" name=\"P_annualUpdateDays\" select=\"30\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier1Limit\" name=\"P_tier1Limit\" select=\"20000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier1AffiliateLimit\" name=\"P_tier1AffiliateLimit\" select=\"6000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier2Limit\" name=\"P_tier2Limit\" select=\"75000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier2AffiliateLimit\" name=\"P_tier2AffiliateLimit\" select=\"22500000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_firstYearSellingSecurityholderShare\" name=\"P_firstYearSellingSecurityholderShare\" select=\"0.30\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_suspensionHolderThreshold\" name=\"P_suspensionHolderThreshold\" select=\"300\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_shareRoundingTolerance\" name=\"P_shareRoundingTolerance\" select=\"0.0001\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_percentFractionLowerBound\" name=\"P_percentFractionLowerBound\" select=\"0\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_percentFractionUpperBound\" name=\"P_percentFractionUpperBound\" select=\"1\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_minimumNetworksPerEngagedAffiliate\" name=\"P_minimumNetworksPerEngagedAffiliate\" select=\"1\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_monetaryTolerance\" name=\"P_monetaryTolerance\" select=\"1\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_annualReportDays\" name=\"P_annualReportDays\" select=\"120\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_semiannualReportDays\" name=\"P_semiannualReportDays\" select=\"90\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_specialAnnualReportDays\" name=\"P_specialAnnualReportDays\" select=\"120\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_specialSemiannualReportDays\" name=\"P_specialSemiannualReportDays\" select=\"90\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_postQualificationUpdateMonths\" name=\"P_postQualificationUpdateMonths\" select=\"12\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeUpperThreshold\" name=\"P_priceRangeUpperThreshold\" select=\"10\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeMaxWidth\" name=\"P_priceRangeMaxWidth\" select=\"2\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeMaxShare\" name=\"P_priceRangeMaxShare\" select=\"0.20\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_supplementChangeLimit\" name=\"P_supplementChangeLimit\" select=\"0.20\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_financialStatementAgeMonths\" name=\"P_financialStatementAgeMonths\" select=\"9\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_fundamentalChangeAssetShare\" name=\"P_fundamentalChangeAssetShare\" select=\"0.50\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_currentReportBusinessDays\" name=\"P_currentReportBusinessDays\" select=\"4\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_omittedPricingBusinessDays\" name=\"P_omittedPricingBusinessDays\" select=\"15\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_pricingSupplementBusinessDays\" name=\"P_pricingSupplementBusinessDays\" select=\"2\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_changeSupplementBusinessDays\" name=\"P_changeSupplementBusinessDays\" select=\"5\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_accountantLetterBusinessDays\" name=\"P_accountantLetterBusinessDays\" select=\"2\" as=\"xs:integer\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "sbrm-mm:sequence": 1,
          "xbrlb:sourceIndex": 0
        },
        {
          "@id": "regca-complete:rule/REGCA_REQ_NOR_DocumentDate",
          "@type": "sbrm-mm:DisclosureRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_REQ_NOR_DocumentDate",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_REQ_NOR_DocumentDate\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($DocumentType) ne 'http://luca.pacioli.ai/report#FormNORMember' or count($X) gt 0\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_X\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_X\" name=\"X\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_X_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_X\" xlink:to=\"f_X_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_X_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_X\" xlink:to=\"f_X_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "sbrm-mm:sequence": 2,
          "xbrlb:sourceIndex": 1
        },
        {
          "@id": "regca-complete:rule/REGCA_REQ_NOR_IssuerName",
          "@type": "sbrm-mm:DisclosureRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_REQ_NOR_IssuerName",
          "cmns-qtu:hasExpression": {
