            "regca-complete:reference/1329"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AggregateSalesComponentMember"
        },
        {
          "@id": "regca:ForeignCurrencyAmountInUSD",
          "rdfs:label": {
            "@value": "Amount translated into U.S. dollars",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Foreign amount times the exchange rate; this is the amount counted in the aggregate offering price or aggregate sales.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1336",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencyAmountInUSD"
        },
        {
          "@id": "regca:ForeignCurrencyCode",
          "rdfs:label": {
            "@value": "Currency received (ISO 4217 code)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Three-letter ISO 4217 code.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1331",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencyCode"
        },
        {
          "@id": "regca:ForeignCurrencySaleDate",
          "rdfs:label": {
            "@value": "Date of the sale",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. ",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1335",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencySaleDate"
        },
        {
          "@id": "regca:ForeignCurrencyTranslatedComponent",
          "rdfs:label": {
            "@value": "Amount translated",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Whether the foreign-currency cash counts toward the aggregate offering price or aggregate sales.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1330",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencyTranslatedComponent"
        },
        {
          "@id": "regca:FormerAccountantReportAdverseOrModifiedIndicator",
          "rdfs:label": {
            "@value": "Former accountant's report adverse, disclaimed, qualified or modified",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if the principal accountant's report on the financial statements for either of the past two years contained an adverse opinion or a disclaimer of opinion, or was qualified or modified as to uncertainty, audit scope or accounting principles (Item 304(a)(1)(ii)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1338",
            "regca-complete:reference/1339"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/FormerAccountantReportAdverseOrModifiedIndicator"
        },
        {
          "@id": "regca:ForeignCurrencyExchangeRateDate",
          "rdfs:label": {
            "@value": "Date of the exchange rate used",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. On, or a reasonable time before, the sale date.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1334",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencyExchangeRateDate"
        },
        {
          "@id": "regca:ForeignCurrencyExchangeRate",
          "rdfs:label": {
            "@value": "Exchange rate used (U.S. dollars per unit of foreign currency)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. ",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1333",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ForeignCurrencyExchangeRate"
        },
        {
          "@id": "regca:AccountantChangeRecommendedOrApprovedIndicator",
          "rdfs:label": {
            "@value": "Change in accountants recommended or approved by the audit committee or board",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if the decision to change accountants was recommended or approved by the audit or similar committee of the board, or by the board if there is no such committee (Item 304(a)(1)(iii)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1341",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantChangeRecommendedOrApprovedIndicator"
        },
        {
          "@id": "regca:FormerAccountantReportAdverseOrModifiedDescription",
          "rdfs:label": {
            "@value": "Nature of each adverse opinion, disclaimer, qualification or modification",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Describes each adverse opinion, disclaimer of opinion, qualification or modification reported as true above (Item 304(a)(1)(ii)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1340",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/FormerAccountantReportAdverseOrModifiedDescription"
        },
        {
          "@id": "regca:DisagreementsWithFormerAccountantDescription",
          "rdfs:label": {
            "@value": "Description of each disagreement",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Describes each disagreement (Item 304(a)(1)(iv)(A)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1350",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/DisagreementsWithFormerAccountantDescription"
        },
        {
          "@id": "regca:AccountantChangeApprovingBodyDomain",
          "rdfs:label": {
            "@value": "Approving body [domain]",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1342",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantChangeApprovingBodyDomain"
        },
        {
          "@id": "regca:AccountantChangeApprovingBody",
          "rdfs:label": {
            "@value": "Body that recommended or approved the change",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Which body recommended or approved the change (Item 304(a)(1)(iii)(A)-(B)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1345",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantChangeApprovingBody"
        },
        {
          "@id": "regca:BoardOfDirectorsMember",
          "rdfs:label": {
            "@value": "Board of directors [member]",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Used when the issuer has no audit or similar committee.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1344",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/BoardOfDirectorsMember"
        },
        {
          "@id": "regca:FormerAccountantAuthorizedToRespondIndicator",
          "rdfs:label": {
            "@value": "Former accountant authorized to respond fully to the successor accountant",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if the issuer has authorized the former accountant to respond fully to the successor accountant's inquiries on the subject matter of each disagreement or reportable event (Item 304(a)(1)(iv)(C), (v)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1353",
            "regca-complete:reference/1354"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/FormerAccountantAuthorizedToRespondIndicator"
        },
        {
          "@id": "regca:DisagreementsWithFormerAccountantIndicator",
          "rdfs:label": {
            "@value": "Disagreements with the former accountant",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if, during the two most recent fiscal years and any later interim period before the resignation, declination or dismissal, there was any disagreement with the former accountant on accounting principles or practices, financial statement disclosure, or auditing scope or procedure that, if not resolved to its satisfaction, would have caused it to refer to the matter in its report. Includes disagreements later resolved; a difference of opinion is enough, and an oral communication from the engagement partner generally suffices (Item 304(a)(1)(iv); Instructions 4-5).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1346",
            "regca-complete:reference/1347",
            "regca-complete:reference/1348",
            "regca-complete:reference/1349"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/DisagreementsWithFormerAccountantIndicator"
        },
        {
          "@id": "regca:AuditOrSimilarCommitteeMember",
          "rdfs:label": {
            "@value": "Audit or similar committee of the board of directors [member]",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Used when the issuer has such a committee.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1343",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AuditOrSimilarCommitteeMember"
        },
        {
          "@id": "regca:SubjectMatterDiscussedWithFormerAccountantIndicator",
          "rdfs:label": {
            "@value": "Audit committee or board discussed the subject matter with the former accountant",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if the audit or similar committee, or the board, discussed the subject matter of each disagreement or reportable event with the former accountant (Item 304(a)(1)(iv)(B), (v)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1351",
            "regca-complete:reference/1352"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/SubjectMatterDiscussedWithFormerAccountantIndicator"
        },
        {
          "@id": "regca:LimitationOnFormerAccountantResponse",
          "rdfs:label": {
            "@value": "Nature of and reason for any limitation on the former accountant's response",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Required if the former accountant is not authorized to respond fully (Item 304(a)(1)(iv)(C)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1355",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/LimitationOnFormerAccountantResponse"
        },
        {
          "@id": "regca:NewAccountantConsultedIndicator",
          "rdfs:label": {
            "@value": "Issuer consulted the new accountant before engaging it",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if, during the two most recent fiscal years and any later interim period before the engagement, the issuer consulted the new accountant on the application of accounting principles to a specified transaction or the type of audit opinion (with a written report or important oral advice), or on any matter that was a disagreement or reportable event (Item 304(a)(2)(i)-(ii)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1362",
            "regca-complete:reference/1363"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantConsultedIndicator"
        },
        {
          "@id": "regca:ReportableEventFairnessOrReliabilityIndicator",
          "rdfs:label": {
            "@value": "Accountant concluded information materially impacts the fairness or reliability of reports or statements, unresolved",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Reportable event under Item 304(a)(1)(v)(D).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1360",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventFairnessOrReliabilityIndicator"
        },
        {
          "@id": "regca:ReportableEventsDescription",
          "rdfs:label": {
            "@value": "Description of each reportable event",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Describes each reportable event (Item 304(a)(1)(v), applying (a)(1)(iv)(A)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1361",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventsDescription"
        },
        {
          "@id": "regca:ReportableEventsIndicator",
          "rdfs:label": {
            "@value": "Reportable events",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if any of the four kinds of events in Item 304(a)(1)(v)(A)-(D) occurred during the two most recent fiscal years and any later interim period before the change, even without a difference of opinion. An event that led to a disagreement is reported as a disagreement instead (Item 304(a)(1)(v)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1356",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventsIndicator"
        },
        {
          "@id": "regca:ReportableEventAuditScopeIndicator",
          "rdfs:label": {
            "@value": "Accountant advised of a need to expand the audit scope significantly, not done",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Reportable event under Item 304(a)(1)(v)(C): the accountant advised that its audit scope must be expanded significantly, or that information needed further investigation, and because of the change (or otherwise) this was not done.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1359",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventAuditScopeIndicator"
        },
        {
          "@id": "regca:ReportableEventInternalControlsIndicator",
          "rdfs:label": {
            "@value": "Accountant advised that internal controls needed for reliable financial statements do not exist",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Reportable event under Item 304(a)(1)(v)(A).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1357",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventInternalControlsIndicator"
        },
        {
          "@id": "regca:NewAccountantConsultationIssues",
          "rdfs:label": {
            "@value": "Issues on which the new accountant was consulted",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Item 304(a)(2)(A).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1364",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantConsultationIssues"
        },
        {
          "@id": "regca:ReportableEventManagementRepresentationsIndicator",
          "rdfs:label": {
            "@value": "Accountant advised it can no longer rely on management's representations or be associated with the statements",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Reportable event under Item 304(a)(1)(v)(B).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1358",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ReportableEventManagementRepresentationsIndicator"
        },
        {
          "@id": "regca:NewAccountantViewsOnConsultationIssues",
          "rdfs:label": {
            "@value": "Views of the new accountant on each issue",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Brief description of the new accountant's oral or written views on each issue (Item 304(a)(2)(B)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1365",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantViewsOnConsultationIssues"
        },
        {
          "@id": "regca:AccountantProvidedCopyOfDisclosuresIndicator",
          "rdfs:label": {
            "@value": "Accountant given a copy of the disclosures",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer gave the former accountant (Item 4) or the independent accountant (Item 5(b)) a copy of the disclosures, received no later than the filing day (Item 304(a)(3); Form 1-UC Item 5(c)(1)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1374",
            "regca-complete:reference/1375"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantProvidedCopyOfDisclosuresIndicator"
        },
        {
          "@id": "regca:NewAccountantReviewOfDisclosureRequestedIndicator",
          "rdfs:label": {
            "@value": "New accountant asked to review the disclosure before filing",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer asked the new accountant to review the Item 304(a) disclosure before filing and offered it the chance to send a letter to the Commission (Item 304(a)(2)(D)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1369",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantReviewOfDisclosureRequestedIndicator"
        },
        {
          "@id": "regca:AccountantLettersAbstract",
          "rdfs:label": {
            "@value": "Accountant letters (Items 4 and 5) [abstract]",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1372",
            "regca-complete:reference/1373"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantLettersAbstract"
        },
        {
          "@id": "regca:FormerAccountantViewsSummary",
          "rdfs:label": {
            "@value": "Summary of the former accountant's views",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Required if the former accountant was consulted (Item 304(a)(2)(C)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1368",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/FormerAccountantViewsSummary"
        },
        {
          "@id": "regca:NewAccountantLetterFiledAsExhibitIndicator",
          "rdfs:label": {
            "@value": "New accountant's letter filed as an exhibit",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the new accountant furnished a letter and it is filed as an exhibit (Item 304(a)(2)(D)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1370",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantLetterFiledAsExhibitIndicator"
        },
        {
          "@id": "regca:NewAccountantWrittenViewsFiledAsExhibitIndicator",
          "rdfs:label": {
            "@value": "New accountant's written views filed as an exhibit",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if written views received from the new accountant are filed as an exhibit, as Item 304(a)(2)(B) requires.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1366",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NewAccountantWrittenViewsFiledAsExhibitIndicator"
        },
        {
          "@id": "regca:AccountantLetterRequestedIndicator",
          "rdfs:label": {
            "@value": "Accountant asked for a letter to the Commission",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer asked the accountant for a letter to the Commission saying whether it agrees with the issuer's statements (Item 304(a)(3); Form 1-UC Item 5(c)(2)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1376",
            "regca-complete:reference/1377"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantLetterRequestedIndicator"
        },
        {
          "@id": "regca:FormerAccountantConsultedOnIssuesIndicator",
          "rdfs:label": {
            "@value": "Former accountant consulted on the same issues",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Item 304(a)(2)(C).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1367",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/FormerAccountantConsultedOnIssuesIndicator"
        },
        {
          "@id": "regca:RegulationSKItem304OtherInformation",
          "rdfs:label": {
            "@value": "Other Item 304 information",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Any further information Item 304(a) calls for that the data points above do not hold.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1371",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/RegulationSKItem304OtherInformation"
        },
        {
          "@id": "regca:AccountantLetterFiledAsExhibitIndicator",
          "rdfs:label": {
            "@value": "Accountant's letter filed as an exhibit",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the accountant's letter is filed as an exhibit to this report or amendment.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1378",
            "regca-complete:reference/1379"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantLetterFiledAsExhibitIndicator"
        },
        {
          "@id": "regca:PriorRegulationCryptoAssetsOfferingsAbstract",
          "rdfs:label": {
            "@value": "Offerings under Regulation Crypto Assets in the previous 12 months [abstract]",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Asked so a reader can see earlier offerings under Regulation Crypto Assets that bear on aggregate sales (Rule 100), on whether this is the issuer's first offering or one qualified within a year of it (Rule 300(a)(3)(i)-(ii)) and on one-time use of the startup exemption (Rule 200(b)(3)). ",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/1386",
            "regca-complete:reference/1387",
            "regca-complete:reference/1388",
            "regca-complete:reference/1389"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/PriorRegulationCryptoAssetsOfferingsAbstract"
        },
        {
          "@id": "regca:PriorRegulationCryptoAssetsOfferingLineItems",
          "rdfs:label": {
            "@value": "Offering in the previous 12 months [line items]",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1396",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/PriorRegulationCryptoAssetsOfferingLineItems"
        },
        {
          "@id": "regca:AccountantInterimLetterIndicator",
          "rdfs:label": {
            "@value": "Letter is an interim letter",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the letter filed is an interim letter highlighting specific concerns, with a fuller letter to follow (Item 304(a)(3)).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1380",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AccountantInterimLetterIndicator"
        },
        {
          "@id": "regca:LaterSimilarTransactionsAccountedDifferentlyIndicator",
          "rdfs:label": {
            "@value": "Later similar transactions accounted for as the former accountant would not have",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Regulation S-K Item 304(b): true if, after a disagreement or reportable event, material transactions or events like it in the year of the change or the next year were accounted for or disclosed differently from what the former accountant apparently would have required. Form 1-KC does not ask for this.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1384",
