        },
        {
          "@id": "regca:NumberOfAffiliatesEngagedInBlockchainNetworkParticipation",
          "rdfs:label": {
            "@value": "Number of affiliates engaged in blockchain network participation",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of the issuer's affiliates that are engaged in blockchain network participation as of the reporting instant. Reported dimensionlessly; the enumerated perimeter rows on the affiliate axis must number exactly this many. A filer with no participating affiliates reports zero.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2196",
            "regca-complete:reference/2197",
            "regca-complete:reference/2198",
            "regca-complete:reference/2199"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/NumberOfAffiliatesEngagedInBlockchainNetworkParticipation"
        },
        {
          "@id": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "rdfs:label": {
            "@value": "The enumerated affiliate perimeter is complete",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Affirmative statement that the enumerated list of affiliates engaged in blockchain network participation includes every affiliate so engaged, applying the control-based affiliate definition and not a narrower one chosen by the filer. This is the element that converts an omission from a silent arithmetic gap into an affirmative misstatement on the face of the filing.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2200",
            "regca-complete:reference/2201",
            "regca-complete:reference/2202",
            "regca-complete:reference/2203"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliatePerimeterCompletenessAttestationIndicator"
        },
        {
          "@id": "regca:AffiliatePerimeterAttestingOfficerName",
          "rdfs:label": {
            "@value": "Affiliate perimeter attesting officer name",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Full legal name of the executive officer who certifies that the enumerated affiliate perimeter is complete. This is the element that converts regca:AffiliatePerimeterCompletenessAttestationIndicator from an unattributed checkbox into a named person's representation.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2204",
            "regca-complete:reference/2205",
            "regca-complete:reference/2206",
            "regca-complete:reference/2207"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliatePerimeterAttestingOfficerName"
        },
        {
          "@id": "regca:AffiliateCanObserveTransactionsBeforeConfirmationIndicator",
          "rdfs:label": {
            "@value": "Affiliate can observe transactions before public confirmation indicator",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2228",
            "regca-complete:reference/2229",
            "regca-complete:reference/2230",
            "regca-complete:reference/2231"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/AffiliateCanObserveTransactionsBeforeConfirmationIndicator"
        },
        {
          "@id": "regca:CombinedEntitiesCouldInfluenceConsensusIndicator",
          "rdfs:label": {
            "@value": "Combined entities could influence consensus indicator",
