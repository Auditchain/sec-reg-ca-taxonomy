ariable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Price_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Price_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SubType\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SubType\" name=\"SubType\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SubType_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementSubmissionType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_SubType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
