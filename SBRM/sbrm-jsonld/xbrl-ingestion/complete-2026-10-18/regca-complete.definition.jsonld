        },
        {
          "@id": "regca-complete:label/AmendmentExplanatoryNote/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentExplanatoryNote",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Explanatory note to amendment",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 630
        },
        {
          "@id": "regca-complete:label/AmendmentExplanatoryNote/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentExplanatoryNote",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "An amendment that relates solely to Part III of Form 1-CRYPTO may be limited to Part I, an explanatory note and Part III.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 631
        },
        {
          "@id": "regca-complete:label/AmendmentRelatesSolelyToPartIIIIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentRelatesSolelyToPartIIIIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Amendment relates solely to Part III (exhibits)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 632
        },
        {
          "@id": "regca-complete:label/AmendmentRelatesSolelyToPartIIIIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentRelatesSolelyToPartIIIIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if this Form 1-CRYPTO amendment relates solely to Part III. Part II and the financial statements are then not required.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 633
        },
        {
          "@id": "regca-complete:label/AmendedAuditedFinancialStatementsIncludedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Amendment includes amended audited financial statements",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 634
        },
        {
          "@id": "regca-complete:label/AmendedAuditedFinancialStatementsIncludedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "If true, the amendment must include the consent of the certifying accountant (filed as an exhibit).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 635
        },
        {
          "@id": "regca-complete:label/PostQualificationAmendmentBasisDomain/Standard/en",
