          "@type": "mvf:VocabularyEntry",
          "cmns-dsg:hasTextualName": "Units of subject crypto asset in each unit of covered investment contract",
          "cmns-dsg:denotes": "regca-complete:mvf/entry/SubjectCryptoAssetUnitsPerUnit",
