          "dct:bibliographicCitation": "17 CFR 228.103(b)(9); 91 FR 54608",
          "cmns-docc:hasTextualContent": "Verbatim: \"including information regarding the technology infrastructure, types of participants, and other parties and systems using the subject crypto asset and the associated crypto network or associated crypto application\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
            "@value": "2026-08-21",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2311,
          "xbrlb:sourceIndex": 2310
        },
        {
          "@id": "regca-complete:reference/2312",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AggregatedConcentrationAndSystemicRiskAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/rutgers-carlab-engineering-sciences-laboratory-ibn-tofail-university-auditchain-labs-ag",
          "dct:title": "El Imami, Oh, Meyers, Brennan, Vasarhelyi, Sannella, Egan et al., Beyond the Fiat Vault: Evaluating Machine-Readable Blockchain Disclosures for Systemic Safety, Operational Security, and MEV Conflict Mitigation (BNP Disclosure Taxonomy paper)",
          "dct:bibliographicCitation": "PDF p. 12",
          "cmns-docc:hasTextualContent": "Verbatim: \"Computes combined issuer and affiliate network control as a single consolidated control metric to see if it could influence consensus outcomes.\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2312,
          "xbrlb:sourceIndex": 2311
        },
        {
          "@id": "regca-complete:reference/2313",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AggregatedConcentrationAndSystemicRiskAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/auditchain-labs-ag",
          "dct:title": "Comment to the FDIC on proposed Forms PS-01, PS-01a and PS-02, OMB No. 3064-0225 (Sept. 23, 2026)",
          "dct:bibliographicCitation": "PDF p. 9",
          "cmns-docc:hasTextualContent": "Verbatim: \"Whoever operates the validators, miners and staking infrastructure of the networks … decides which transactions are ordered, included, delayed or excluded.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.fdic.gov/federal-register-publications/auditchain-jason-meyers-omb-3064-0225.pdf"
          },
          "dct:date": {
            "@value": "2026-09-23",
