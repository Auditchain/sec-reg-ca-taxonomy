          "@id": "regca:CoveredTransactionForeignCurrencyCode",
          "rdfs:label": {
            "@value": "Currency of consideration received (ISO 4217 code)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. The three-letter ISO 4217 code of the foreign currency received in this covered transaction.",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1312",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CoveredTransactionForeignCurrencyCode"
        },
        {
          "@id": "regca:CoveredTransactionForeignCurrencyAmount",
          "rdfs:label": {
            "@value": "Consideration received in the foreign currency",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Amount received, in the foreign currency (the fact's unit is that currency).",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/1313",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/CoveredTransactionForeignCurrencyAmount"
