          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FX_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"abs($Amt * $Rate - $USD) le $P_monetaryTolerance and exists($Ccy) and upper-case(normalize-space(string($Ccy))) ne 'USD' and (some $m in xfi:unit-numerator(xfi:unit($Amt)) satisfies local-name-from-QName($m) eq upper-case(normalize-space(string($Ccy)))) and exists($RateDate) and (empty($SaleDate) or xs:date($RateDate) le xs:date($SaleDate))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amt\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amt\" name=\"Amt\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amt_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyAmountReceived</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amt\" xlink:to=\"f_Amt_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Amt_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amt\" xlink:to=\"f_Amt_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Rate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Rate\" name=\"Rate\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Rate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyExchangeRate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Rate\" xlink:to=\"f_Rate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Rate_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Rate\" xlink:to=\"f_Rate_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_USD\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_USD\" name=\"USD\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_USD_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyAmountInUSD</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_USD_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Ccy\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Ccy\" name=\"Ccy\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Ccy_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyCode</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Ccy\" xlink:to=\"f_Ccy_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_RateDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_RateDate\" name=\"RateDate\" order=\"5\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_RateDate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyExchangeRateDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_RateDate\" xlink:to=\"f_RateDate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SaleDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SaleDate\" name=\"SaleDate\" order=\"6\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SaleDate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencySaleDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFil