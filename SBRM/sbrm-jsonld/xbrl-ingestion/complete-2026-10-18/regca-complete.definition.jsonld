          "dct:bibliographicCitation": "17 CFR 229.304(a)(1)(iv)",
          "cmns-docc:hasTextualContent": "Verbatim: \"The disagreements required to be reported in response to this Item include both those resolved to the former accountant's satisfaction and those not resolved to the former accountant's satisfaction\"",
