            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BNP_R1_GOV_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"(if (string($ParticipatedInGovernanceVotesPast12MonthsIndicator) eq 'true') then (exists($NumberOfGovernanceVotesCast) and $NumberOfGovernanceVotesCast ge 1) else (if (string($ParticipatedInGovernanceVotesPast12MonthsIndicator) eq 'false') then (not(exists($NumberOfGovernanceVotesCast)) or $NumberOfGovernanceVotesCast eq 0) else true())) and (not(exists($NumberOfGovernanceVotesCast)) or $NumberOfGovernanceVotesCast ge 0)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_ParticipatedInGovernanceVotesPast12MonthsIndicator\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_ParticipatedInGovernanceVotesPast12MonthsIndicator\" name=\"ParticipatedInGovernanceVotesPast12MonthsIndicator\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_ParticipatedInGovernanceVotesPast12MonthsIndicator_concept\">\n    <cf:concept><cf:qname>regca:ParticipatedInGovernanceVotesPast12MonthsIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_ParticipatedInGovernanceVotesPast12MonthsIndicator\" xlink:to=\"f_ParticipatedInGovernanceVotesPast12MonthsIndicator_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_ParticipatedInGovernanceVotesPast12MonthsIndicator_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_ParticipatedInGovernanceVotesPast12MonthsIndicator\" xlink:to=\"f_ParticipatedInGovernanceVotesPast12MonthsIndicator_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_NumberOfGovernanceVotesCast\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_NumberOfGovernanceVotesCast\" name=\"NumberOfGovernanceVotesCast\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_NumberOfGovernanceVotesCast_concept\">\n    <cf:concept><cf:qname>regca:NumberOfGovernanceVotesCast</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_NumberOfGovernanceVotesCast\" xlink:to=\"f_NumberOfGovernanceVotesCast_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_NumberOfGovernanceVotesCast_dim\">\n    <df:dimension><df:qname>regca:BlockchainNetworkIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_NumberOfGovernanceVotesCast\" xlink:to=\"f_NumberOfGovernanceVotesCast_dim\" complement=\"false\" cover=\"false\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_NumberOfGovernanceVotesCast_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_NumberOfGovernanceVotesCast\" xlink:to=\"f_NumberOfGovernanceVotesCast_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
