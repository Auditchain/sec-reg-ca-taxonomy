          "rdf:value": {
            "@value": "Third-party service provider legal entity identifier",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1152
        },
        {
          "@id": "regca-complete:label/ThirdPartyServicesDescriptionExplanatory/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServicesDescriptionExplanatory",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of services provided by third party [text block]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1153
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceFeesPaid/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceFeesPaid",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Fees paid to third-party service provider",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1154
        },
        {
          "@id": "regca-complete:label/ThirdPartyConflictsOfInterestIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyConflictsOfInterestIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party has conflicts of interest indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1155
        },
        {
          "@id": "regca-complete:label/ThirdPartyConflictsDescriptionExplanatory/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyConflictsDescriptionExplanatory",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of third-party conflicts of interest [text block]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1156
        },
        {
          "@id": "regca-complete:label/ThirdPartyConflictMitigationMeasuresExplanatory/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyConflictMitigationMeasuresExplanatory",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of conflict mitigation measures for third-party arrangements [text block]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1157
        },
        {
          "@id": "regca-complete:label/IssuerBlockchainNetworkParticipationForPeriodAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerBlockchainNetworkParticipationForPeriodAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer blockchain network participation for the period [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1158
        },
        {
          "@id": "regca-complete:label/IssuerBlockchainNetworkParticipationForPeriodAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerBlockchainNetworkParticipationForPeriodAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items of the issuer's network participation that are reported for a period: the financial figures (revenue, share of total revenue, expenses, net income, capital expenditures) for the period of the financial statements, validator uptime and governance votes over the period, and the descriptions. The items reported as of a date (protocol, network type, nodes and validators, stake and hash-power share, governance tokens, the dependency indicators) are in \"Rule 103(b)(9) — issuer blockchain network participation\". Both tables use the same network identifier, so a network has the same number in both. Element names, datatypes and period types are unchanged from the BNP taxonomy filed with the FDIC; only the grouping into two tables, one of items reported as of a date and one of items reported for a period, is new, so that each table has one date column.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1159
        },
        {
          "@id": "regca-complete:label/BlockchainNetworkParticipationForPeriodByNetworkTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Blockchain network participation for the period by network [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1160
        },
        {
          "@id": "regca-complete:label/BlockchainNetworkParticipationForPeriodByNetworkLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Blockchain network participation for the period by network [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1161
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationForPeriodAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationForPeriodAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate blockchain network participation for the period [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1162
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationForPeriodAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationForPeriodAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items of the affiliates' network participation that are reported for a period: for each affiliate, its relationship to the issuer, overlapping directors or officers, its services to the issuer and their fees, conflicts of interest and their mitigation, and its participation revenue, expenses, net income and capital expenditures; for each affiliate on each network, its type of participation and its financial figures; and the totals across affiliates. The items reported as of a date (names, identifiers, control, ownership, stake and hash-power share, indicators) and the perimeter certification are in \"Rule 103(b)(9) — affiliate blockchain network participation\". The tables use the same affiliate and network identifiers. Element names, datatypes and period types are unchanged from the BNP taxonomy filed with the FDIC; only the grouping into two tables, one of items reported as of a date and one of items reported for a period, is new, so that each table has one date column.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1163
        },
        {
          "@id": "regca-complete:label/AffiliateNetworkParticipationForPeriodByAffiliateTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateNetworkParticipationForPeriodByAffiliateTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate network participation for the period by affiliate [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1164
        },
        {
          "@id": "regca-complete:label/AffiliateNetworkParticipationForPeriodByAffiliateLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateNetworkParticipationForPeriodByAffiliateLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate network participation for the period by affiliate [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1165
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationForPeriodByNetworkTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationForPeriodByNetworkTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate blockchain network participation for the period by network [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1166
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationForPeriodByNetworkLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationForPeriodByNetworkLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate blockchain network participation for the period by network [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1167
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderArrangementsForPeriodAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderArrangementsForPeriodAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider arrangements for the period [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1168
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderArrangementsForPeriodAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderArrangementsForPeriodAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items of the third-party service provider arrangements that are reported for a period: for each provider, the services it provides, the fees paid to it, and its conflicts of interest and their mitigation. The items reported as of a date (whether it provides blockchain network services, its name and legal entity identifier, whether it has conflicts of interest) are in \"Rule 103(b)(9) — third-party service provider arrangements\". Both tables use the same provider identifier. Element names, datatypes and period types are unchanged from Section 8 of the BNP questionnaire; only the grouping into two tables, one of items reported as of a date and one of items reported for a period, is new, so that each table has one date column.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1169
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderForPeriodByProviderTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderForPeriodByProviderTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider for the period by provider [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1170
        },
        {
          "@id": "regca-complete:label/ThirdPartyServiceProviderForPeriodByProviderLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyServiceProviderForPeriodByProviderLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Third-party service provider for the period by provider [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1171
        },
        {
          "@id": "regca-complete:label/BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Blockchain network participation for the period by network — totals across networks [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1172
        },
        {
          "@id": "regca-complete:label/AggregatedNetworkConcentrationTotalsLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AggregatedNetworkConcentrationTotalsLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Aggregated network concentration — totals across networks [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1173
        },
        {
          "@id": "regca-complete:label/UseOfProceedsPercentageOfEstimatedNetProceeds/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UseOfProceedsPercentageOfEstimatedNetProceeds",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Use of proceeds percentage of estimated net proceeds",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1174
        },
        {
          "@id": "regca-complete:label/UseOfProceedsPercentageOfEstimatedNetProceeds/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UseOfProceedsPercentageOfEstimatedNetProceeds",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Amount intended for this use divided by estimated net proceeds.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1175
        },
        {
          "@id": "regca-complete:label/UseOfProceedsPercentageOfEstimatedNetProceedsTotal/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UseOfProceedsPercentageOfEstimatedNetProceedsTotal",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total percentage of estimated net proceeds",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1176
        },
        {
          "@id": "regca-complete:label/UseOfProceedsPercentageOfEstimatedNetProceedsTotal/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UseOfProceedsPercentageOfEstimatedNetProceedsTotal",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Sum of the percentages of estimated net proceeds by use.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1177
        },
        {
          "@id": "regca-complete:label/CoveredTransactionPlannedAggregateOfferingPrice/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionPlannedAggregateOfferingPrice",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Planned aggregate offering price of covered transaction, in U.S. dollars",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1178
        },
        {
          "@id": "regca-complete:label/CoveredTransactionPlannedAggregateOfferingPrice/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionPlannedAggregateOfferingPrice",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The aggregate offering price (Rule 100) of a covered transaction that the issuer plans but has not made at the date of the disclosure. A row that states this value is a planned covered transaction; once the transaction is made, the consideration received is reported for it instead. The amount counted against the $5,000,000 limit of Rule 200(b)(4) is reported separately.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1179
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionIdentifier/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionIdentifier",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Transaction identifier (TXID)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1180
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionIdentifier/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionIdentifier",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The identifier (hash) of a transaction recorded on a blockchain network. Used in every table that cites an on-chain proof, so that every such proof in a filing can be found, and matched across filings, in the same way.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1181
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionAddress/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionAddress",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Link to the transaction on a public block explorer",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1182
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionAddress/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionAddress",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The address of the transaction on a public block explorer, where anyone can verify it. The transaction identifier, not the link, identifies the transaction.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1183
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date of the transaction",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1184
        },
        {
          "@id": "regca-complete:label/BlockchainTransactionDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:BlockchainTransactionDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The date on which the transaction was recorded on the network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1185
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentsAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentsAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Smart contract deployments (proposed) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1186
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentsAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentsAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each deployment of a smart contract that the filing states, with the on-chain proof of the deployment. Where a deployment fulfills a representation or promise to engage in essential managerial efforts, the row gives the number of that effort in the table of essential managerial efforts, so that the proof of each completed effort can be followed on-chain.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1187
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Smart contract deployment [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1188
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentTable/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentTable",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each deployment of a smart contract.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1189
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Smart contract deployment identifier [typed axis]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1190
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentIdentifierTypedAxis/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentIdentifierTypedAxis",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Numbers the deployments 1, 2, 3 and so on; as many rows as the issuer needs.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1191
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Smart contract deployment [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1192
        },
        {
          "@id": "regca-complete:label/SmartContractDeploymentLineItems/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractDeploymentLineItems",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items reported for each deployment.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1193
        },
        {
          "@id": "regca-complete:label/SmartContractName/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractName",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Smart contract name",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1194
        },
        {
          "@id": "regca-complete:label/SmartContractName/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SmartContractName",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The name by which the filing refers to the smart contract.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1195
        },
        {
          "@id": "regca-complete:label/FulfilledEssentialManagerialEffortIdentifier/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FulfilledEssentialManagerialEffortIdentifier",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Number of the essential managerial effort that the deployment fulfills",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1196
        },
        {
          "@id": "regca-complete:label/FulfilledEssentialManagerialEffortIdentifier/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FulfilledEssentialManagerialEffortIdentifier",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of the row in the table of essential managerial efforts whose representation or promise the deployment fulfills. Left blank when the deployment fulfills none.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1197
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsDispositionAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsDispositionAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition of administrative rights and privileged roles (proposed) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1198
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsDispositionAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsDispositionAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Whether the issuer has given up or transferred the administrative rights and privileged roles it held in the smart contracts (for example, at a handover), and, for each right, its disposition and the on-chain proof. A right that ended, was destroyed or was transferred is shown with each transaction that carried it out; a right that is retained is listed without a transaction. Supports the certification in Item 2 of Form TR that all promised essential managerial efforts are completed or permanently ceased.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1199
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsRelinquishedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsRelinquishedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer has given up or transferred every administrative right and privileged role it held in the smart contracts, other than those listed as retained",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1200
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsRelinquishedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsRelinquishedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Answered No until the issuer has given up or transferred every such right, and Yes from then on.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1201
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsRelinquishedDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsRelinquishedDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date on which the issuer gave up or transferred those rights",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1202
        },
        {
          "@id": "regca-complete:label/AdministrativeRightsRelinquishedDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightsRelinquishedDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The date of the last transaction by which the issuer gave up or transferred those rights. Left blank until then.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1203
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition of an administrative right [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1204
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionTable/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionTable",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each transaction by which a right was destroyed, transferred or ended, and one row for each right that is retained.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1205
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition transaction identifier [typed axis]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1206
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionIdentifierTypedAxis/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionIdentifierTypedAxis",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Numbers the transactions for each right 1, 2, 3 and so on; as many rows as the issuer needs, for example one for each network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1207
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition of an administrative right [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1208
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionLineItems/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionLineItems",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items reported for each disposition.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1209
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDisposition/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDisposition",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition of the right",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1210
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDisposition/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDisposition",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. What happened to the right: destroyed or renounced, transferred, ended by its terms or by another event, or retained.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1211
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionDomain/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionDomain",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Disposition [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1212
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDispositionDomain/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDispositionDomain",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The dispositions of an administrative right or privileged role.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1213
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDestroyedMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDestroyedMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Destroyed or renounced [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1214
        },
        {
          "@id": "regca-complete:label/AdministrativeRightDestroyedMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightDestroyedMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The right no longer exists; no one holds it.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1215
        },
        {
          "@id": "regca-complete:label/AdministrativeRightTransferredMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightTransferredMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Transferred [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1216
        },
        {
          "@id": "regca-complete:label/AdministrativeRightTransferredMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightTransferredMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The right passed to another holder, named in the row.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1217
        },
        {
          "@id": "regca-complete:label/AdministrativeRightEndedMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightEndedMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Ended by its terms or by another event [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1218
        },
        {
          "@id": "regca-complete:label/AdministrativeRightEndedMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightEndedMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The right ended on a date or event set in advance, such as the deployment of another smart contract.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1219
        },
        {
          "@id": "regca-complete:label/AdministrativeRightRetainedMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightRetainedMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Retained [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1220
        },
        {
          "@id": "regca-complete:label/AdministrativeRightRetainedMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightRetainedMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The issuer keeps the right after the filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1221
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderAfterDisposition/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderAfterDisposition",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Holder of the right after the disposition",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1222
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderAfterDisposition/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderAfterDisposition",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Who holds the right after the disposition, or that no one does.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1223
        },
        {
          "@id": "regca-complete:label/PermissionMintingCap/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PermissionMintingCap",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Minting cap of the role",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1224
        },
        {
          "@id": "regca-complete:label/PermissionMintingCap/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PermissionMintingCap",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The most of the subject crypto asset that the role can mint, as written in the code of the smart contracts. Reported for each role that can mint, so that the caps can be compared with the maximum supply.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1225
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderBeforeDisposition/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderBeforeDisposition",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Holder of the right before the disposition",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1226
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderBeforeDisposition/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderBeforeDisposition",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The person or persons, or the entity or entities, that held the right and transferred it, gave it up or kept it; for a group, each member and the signing threshold.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1227
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderBeforeDispositionKey/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderBeforeDispositionKey",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Key of the holder before the disposition",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1228
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderBeforeDispositionKey/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderBeforeDispositionKey",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The address of the key or contract through which the holder before the disposition held the right.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1229
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderAfterDispositionKey/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderAfterDispositionKey",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Key of the holder after the disposition",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1230
        },
        {
          "@id": "regca-complete:label/AdministrativeRightHolderAfterDispositionKey/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AdministrativeRightHolderAfterDispositionKey",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The address of the key or contract through which the holder after the disposition holds the right, or the zero address if the right was destroyed.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1231
        },
        {
          "@id": "regca-complete:label/NetworkRewardAllocationGovernanceDescription/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkRewardAllocationGovernanceDescription",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Governance of the network reward allocation",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1232
        },
        {
          "@id": "regca-complete:label/NetworkRewardAllocationGovernanceDescription/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkRewardAllocationGovernanceDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Who can change the allocation of network rewards among recipients, including subsidies paid in the subject crypto asset, before and after the deployment of the governance contract, and how a change is made once the allocation is subject to governance.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1233
        },
        {
          "@id": "regca-complete:label/FilingProvenanceAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingProvenanceAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Filing provenance (proposed) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1234
        },
        {
          "@id": "regca-complete:label/FilingProvenanceAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingProvenanceAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root of the filing, the method used to compute it, the root of the issuer's previous filing and the address of the taxonomy the filing uses, so that anyone can check that the filing has not changed since it was filed and where it sits in the issuer's chain of filings.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1235
        },
        {
          "@id": "regca-complete:label/PreviousFilingMerkleRoot/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PreviousFilingMerkleRoot",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Merkle root of the issuer's previous filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1236
        },
        {
          "@id": "regca-complete:label/PreviousFilingMerkleRoot/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PreviousFilingMerkleRoot",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root reported by the issuer's previous filing under Regulation Crypto Assets, as 64 lowercase hexadecimal characters. It is covered by this filing's own root, so the issuer's filings form a chain: a change to an earlier filing breaks every later link. Left blank in the issuer's first filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1237
        },
        {
          "@id": "regca-complete:label/PreviousFilingDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PreviousFilingDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date of the issuer's previous filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1238
        },
        {
          "@id": "regca-complete:label/PreviousFilingDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PreviousFilingDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The date of the issuer's previous filing under Regulation Crypto Assets, whose merkle root is reported in this filing. Left blank in the issuer's first filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1239
        },
        {
          "@id": "regca-complete:label/TaxonomyEntryPointAddress/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TaxonomyEntryPointAddress",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Address of the taxonomy entry point used by the filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1240
        },
        {
          "@id": "regca-complete:label/TaxonomyEntryPointAddress/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TaxonomyEntryPointAddress",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The address of the taxonomy entry point under which the filing is prepared and validated. It is covered by the filing's merkle root.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1241
        },
        {
          "@id": "regca-complete:label/FilingMerkleRoot/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleRoot",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Merkle root of the filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1242
        },
        {
          "@id": "regca-complete:label/FilingMerkleRoot/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleRoot",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The merkle root of this filing, as 64 lowercase hexadecimal characters, computed by the method reported in the filing over every fact in the filing except this root, the method and the facts in the table of anchors. It is recorded on a blockchain network before the filing is filed; the table of anchors gives the record.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1243
        },
        {
          "@id": "regca-complete:label/FilingMerkleRootMethod/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleRootMethod",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Method used to compute the merkle root of the filing",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1244
        },
        {
          "@id": "regca-complete:label/FilingMerkleRootMethod/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleRootMethod",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The method used to compute the merkle root of the filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1245
        },
        {
          "@id": "regca-complete:label/FilingMerkleRootMethodDomain/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleRootMethodDomain",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Merkle root method [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1246
        },
        {
          "@id": "regca-complete:label/FilingMerkleTreeVersion1Member/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleTreeVersion1Member",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Reg CA filing merkle tree, version 1 [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1247
        },
        {
          "@id": "regca-complete:label/FilingMerkleTreeVersion1Member/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingMerkleTreeVersion1Member",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Each fact is written as a JSON object with the keys concept, entity, period, dimensions, unit, decimals and value, leaving out keys with no value; concepts, dimensions and members are written as namespace, \"#\" and local name, and a typed dimension by its value. The object is serialized under RFC 8785 (JSON Canonicalization Scheme). Each leaf is SHA-256 (FIPS 180-4) of the byte 0x00 followed by that serialization; the leaves are sorted in ascending order and combined into the Merkle Tree Hash of RFC 6962, section 2.1. Left out of the root: the root itself, this method and every fact in the table of anchors.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1248
        },
        {
          "@id": "regca-complete:label/FilingAnchorsAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorsAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Anchors of the filing's merkle root (proposed) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1249
        },
        {
          "@id": "regca-complete:label/FilingAnchorsAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorsAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each record of the filing's merkle root on a blockchain network: the network, the transaction whose data is the root, its block and date, and a link where anyone can verify it. The anchors are left out of the root.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1250
        },
        {
          "@id": "regca-complete:label/FilingAnchorTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Filing anchor [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1251
        },
        {
          "@id": "regca-complete:label/FilingAnchorTable/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorTable",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. One row for each record of the filing's merkle root on a blockchain network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1252
        },
        {
          "@id": "regca-complete:label/FilingAnchorIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Filing anchor identifier [typed axis]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1253
        },
        {
          "@id": "regca-complete:label/FilingAnchorIdentifierTypedAxis/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:FilingAnchorIdentifierTypedAxis",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Numbers the anchors 1, 2, 3 and so on; as many rows as the issuer needs, for example one for each network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1254
        },
        {
          "@id": "regca-complete:label/FilingAnchorLineItems/Standard/en",
          "@type": "xbrlb:Label",
