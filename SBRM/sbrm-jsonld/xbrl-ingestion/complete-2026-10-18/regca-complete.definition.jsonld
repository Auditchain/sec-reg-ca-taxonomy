        },
        {
          "@id": "regca-complete:mvf/entry/AffiliateBlockchainNetworkParticipationForPeriodAbstract",
          "@type": "mvf:MVFEntry",
          "cmns-col:isIncludedIn": "regca-complete:mvf/dictionary",
          "mvf:hasDescriptiveReference": {
            "@value": "https://raw.githubusercontent.com/Auditchain/sec-reg-ca-taxonomy/main/SBRM/report.xsd#regca_AffiliateBlockchainNetworkParticipationForPeriodAbstract",
            "@type": "xsd:anyURI"
          },
          "cmns-dsg:hasDescription": "Proposed by Auditchain Labs; not required by the proposed rule. The items of the affiliates' network participation that are reported for a period: for each affiliate, its relationship to the issuer, overlapping directors or officers, its services to the issuer and their fees, conflicts of interest and their mitigation, and its participation revenue, expenses, net income and capital expenditures; for each affiliate on each network, its type of participation and its financial figures; and the totals across affiliates. The items reported as of a date (names, identifiers, control, ownership, stake and hash-power share, indicators) and the perimeter certification are in \"Rule 103(b)(9) — affiliate blockchain network participation\". The tables use the same affiliate and network identifiers. Element names, datatypes and period types are unchanged from the BNP taxonomy filed with the FDIC; only the grouping into two tables, one of items reported as of a date and one of items reported for a period, is new, so that each table has one date column.",
          "mvf:hasSemanticReference": [
            "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets",
            "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405",
            "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf",
            "https://www.fdic.gov/federal-register-publications/auditchain-labs-ag-jason-meyers-rin-3064-ag19.pdf",
            "https://raw.rutgers.edu/Testing-Machine-Readable-Compliance.pdf",
            "https://tile.loc.gov/storage-services/service/ll/usrep/usrep426/usrep426438/usrep426438.pdf",
            "https://storage.fasb.org/ASU%202023-06.pdf"
          ]
        },
