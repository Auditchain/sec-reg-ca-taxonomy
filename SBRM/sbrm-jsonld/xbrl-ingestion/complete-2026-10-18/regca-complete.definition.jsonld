            "@value": "Use of proceeds [line items]",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/468",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/UseOfProceedsLineItems"
        },
        {
          "@id": "regca:EquivalentPurchasePricePerUnitOfSubjectCryptoAsset",
          "rdfs:label": {
            "@value": "Equivalent purchase price per unit of subject crypto asset (Rule 101(e)(2) measure)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Purchase price per unit divided by units of the subject crypto asset per unit: the price per unit Rule 101(e)(2) as proposed would report.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/459",
            "regca-complete:reference/460",
            "regca-complete:reference/461"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/EquivalentPurchasePricePerUnitOfSubjectCryptoAsset"
        },
        {
          "@id": "regca:UseOfProceedsTable",
          "rdfs:label": {
            "@value": "Use of proceeds [table]",
            "@language": "en"
          },
          "dct:source": "regca-complete:reference/466",
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/UseOfProceedsTable"
        },
        {
          "@id": "regca:PurchasersLimitedToAccreditedInvestorsIndicator",
          "rdfs:label": {
            "@value": "Purchasers limited to accredited investors",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer restricts the offering to accredited investors as defined in Rule 501 of Regulation D, a qualification for purchasers under Rule 103(b)(2)(i); where true, the 10 percent investment limit of Rule 300(c)(2)(i)(C) does not operate because every purchaser is accredited.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/462",
            "regca-complete:reference/463",
            "regca-complete:reference/464",
            "regca-complete:reference/465"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/PurchasersLimitedToAccreditedInvestorsIndicator"
        },
