          "xbrlb:sourceIndex": 2376
        },
        {
          "@id": "regca-complete:reference/2378",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:IssuerBlockchainNetworkParticipationForPeriodAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/rutgers-carlab-engineering-sciences-laboratory-ibn-tofail-university-auditchain-labs-ag",
          "dct:title": "El Imami, Oh, Meyers, Brennan, Vasarhelyi, Sannella, Egan and Ouatik El Alaoui, Testing Machine-Readable Compliance: Validation Gaps and Omission Invariance in Stablecoin Reporting",
          "dct:bibliographicCitation": "PDF p. 16",
          "cmns-docc:hasTextualContent": "Verbatim: \"the BNP layer is real and agency-invariant\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/Testing-Machine-Readable-Compliance.pdf"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2378,
          "xbrlb:sourceIndex": 2377
        },
        {
          "@id": "regca-complete:reference/2379",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:IssuerBlockchainNetworkParticipationForPeriodAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/supreme-court-of-the-united-states",
          "dct:title": "TSC Industries, Inc. v. Northway, Inc., 426 U.S. 438 (1976)",
          "dct:bibliographicCitation": "426 U.S. at 449",
          "cmns-docc:hasTextualContent": "Verbatim: \"An omitted fact is material if there is a substantial likelihood that a reasonable shareholder would consider it important in deciding how to vote.\" Relied on for BNP disclosure in Auditchain's FDIC comments (RIN 3064-AG19, May 14, 2026; RIN 3064-AG20 supplemental, Mar. 9, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://tile.loc.gov/storage-services/service/ll/usrep/usrep426/usrep426438/usrep426438.pdf"
          },
