          "xbrlb:labelOf": "regca:SupplyAllocationControlledByIssuerIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the issuer or its affiliates control distribution from the allocation. Distributions from issuer-controlled allocations may be covered transactions.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 376
