          },
          "sbrm-mm:sequence": 831,
          "xbrlb:sourceIndex": 830
        },
        {
          "@id": "regca-complete:reference/832",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:CostOfRevenue",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 340-40-25-1",
          "cmns-docc:hasTextualContent": "Topic title as published: \"An entity shall recognize as an asset the incremental costs of obtaining a contract with a customer if the entity expects to recover those costs.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 832,
          "xbrlb:sourceIndex": 831
        },
        {
          "@id": "regca-complete:reference/833",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:CostOfRevenue",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 340-40-25-2",
          "cmns-docc:hasTextualContent": "Topic title as published: \"The incremental costs of obtaining a contract are those costs that an entity incurs to obtain a contract with a customer that it would not have incurred if the contract had not been obtained (for example, a sales commission).\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 833,
          "xbrlb:sourceIndex": 832
        },
        {
          "@id": "regca-complete:reference/834",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:CostOfRevenue",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-complete:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 340-40-35-1",
          "cmns-docc:hasTextualContent": "Topic title as published: \"shall be amortized on a systematic basis that is consistent with the transfer to the customer of the goods or services to which the asset relates\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
