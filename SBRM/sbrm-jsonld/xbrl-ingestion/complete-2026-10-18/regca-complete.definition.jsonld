          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ForeignCurrencyCode",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Three-letter ISO 4217 code.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 847
        },
        {
