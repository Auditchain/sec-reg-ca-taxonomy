            "@value": "Third-party service provider identifier [typed axis]",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2330",
            "regca-complete:reference/2331",
            "regca-complete:reference/2332",
            "regca-complete:reference/2333",
            "regca-complete:reference/2334",
            "regca-complete:reference/2335"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/ThirdPartyServiceProviderIdentifierTypedAxis"
        },
        {
          "@id": "regca:OperationalControlsAndPoliciesAbstract",
          "rdfs:label": {
            "@value": "Operational controls and policies [abstract]",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Controls over the issuer's network participation: oversight, internal audit, information barriers, and transaction-ordering safeguards.",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2285",
            "regca-complete:reference/2286",
            "regca-complete:reference/2287",
            "regca-complete:reference/2288",
            "regca-complete:reference/2289",
            "regca-complete:reference/2290",
            "regca-complete:reference/2291",
            "regca-complete:reference/2292"
          ],
          "mvf:hasMVFEntry": "regca-complete:mvf/entry/OperationalControlsAndPoliciesAbstract"
        },
        {
          "@id": "regca:AffiliateBlockchainNetworkParticipationAbstract",
          "rdfs:label": {
            "@value": "Affiliate blockchain network participation [abstract]",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Network participation by the issuer's affiliates (Rule 405 definition, adopted by Rule 100). Affiliates are related persons under Rule 100, and their participation bears on conflicts of interest under Rule 103(b)(4)(ii). The perimeter count and officer attestation make an omitted affiliate a false statement on the face of the filing. The items reported for a period are in a table of their own, \"Rule 103(b)(9) — affiliate blockchain network participation for the period\".",
            "@language": "en"
          },
          "dct:source": [
            "regca-complete:reference/2293",
            "regca-complete:reference/2294",
            "regca-complete:reference/2295",
            "regca-complete:reference/2296",
            "regca-complete:reference/2297",
            "regca-complete:reference/2298",
