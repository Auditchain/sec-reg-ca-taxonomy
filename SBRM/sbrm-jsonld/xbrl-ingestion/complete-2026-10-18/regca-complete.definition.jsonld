          "xbrlb:labelOf": "regca:NoticeOfRelianceCoveredInvestmentContractAndCryptoAssetDescription",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. A brief description of the covered investment contract and the subject crypto asset sufficient for a reasonable investor to identify the security and crypto asset to which the notice relates, on the standard that Form TR, Part I, Item 1 applies at the end of the four-year period, with a statement of the essential managerial efforts to which the certification refers.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 218
        },
