          "xbrlb:labelOf": "regca:CoveredTransactionExchangeRateDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date of the exchange rate used",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 831
        },
        {
          "@id": "regca-complete:label/CoveredTransactionExchangeRateDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CoveredTransactionExchangeRateDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. The date the rate was in effect: on, or a reasonable time before, the date of the covered transaction.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 832
        },
        {
          "@id": "regca-complete:label/OfferingPriceDeterminationDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingPriceDeterminationDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date the offering price was determined",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 833
        },
        {
          "@id": "regca-complete:label/OfferingPriceDeterminationDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingPriceDeterminationDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. For an offering circular filed under Rule 302(f)(1) or (3): the date the offering price was set. The filing is due two business days after the earlier of this date and the date of first use.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 834
        },
        {
          "@id": "regca-complete:label/OfferingCircularFirstUseDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularFirstUseDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date the offering circular was first used after qualification",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 835
        },
        {
          "@id": "regca-complete:label/OfferingCircularFirstUseDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularFirstUseDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The date this offering circular (or supplement) was first used after qualification in a public offering or sale. Starts the two-business-day (Rule 302(f)(1), (3)) or five-business-day (Rule 302(f)(2)) filing period.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 836
        },
