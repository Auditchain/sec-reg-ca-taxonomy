          "rdf:value": {
            "@value": "Affiliate validator slots controlled on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1094
        },
        {
          "@id": "regca-complete:label/AffiliateNumberOfValidatorSlotsControlled/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateNumberOfValidatorSlotsControlled",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Number of validator slots on the network controlled by the affiliate.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1095
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationExpenses/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Operating expenses of the affiliate's blockchain network participation on the network. Capital expenditure is excluded.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1096
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationExpenses/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate blockchain network participation expenses",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1097
        },
        {
          "@id": "regca-complete:label/TotalAffiliateBlockchainNetworkParticipationRevenue/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationRevenue",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total affiliate blockchain network participation revenue",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1098
        },
        {
          "@id": "regca-complete:label/TotalAffiliateBlockchainNetworkParticipationNetIncome/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationNetIncome",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total affiliate blockchain network participation net income",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1099
        },
        {
          "@id": "regca-complete:label/TotalAffiliateBlockchainNetworkParticipationCapitalExpenditures/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationCapitalExpenditures",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total affiliate blockchain network participation capital expenditures",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1100
        },
        {
          "@id": "regca-complete:label/TotalAffiliateBlockchainNetworkParticipationExpenses/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total affiliate blockchain network participation expenses",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1101
        },
        {
          "@id": "regca-complete:label/TotalAffiliateBlockchainNetworkParticipationExpenses/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Blockchain network participation operating expenses of all affiliates combined, across all networks.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1102
        },
        {
          "@id": "regca-complete:label/NumberOfAffiliatesEngagedInBlockchainNetworkParticipation/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NumberOfAffiliatesEngagedInBlockchainNetworkParticipation",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Number of affiliates engaged in blockchain network participation",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1103
        },
        {
          "@id": "regca-complete:label/NumberOfAffiliatesEngagedInBlockchainNetworkParticipation/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NumberOfAffiliatesEngagedInBlockchainNetworkParticipation",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of the issuer's affiliates that are engaged in blockchain network participation as of the reporting instant. Reported dimensionlessly; the enumerated perimeter rows on the affiliate axis must number exactly this many. A filer with no participating affiliates reports zero.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1104
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterCompletenessAttestationIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "The enumerated affiliate perimeter is complete",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1105
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterCompletenessAttestationIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Affirmative statement that the enumerated list of affiliates engaged in blockchain network participation includes every affiliate so engaged, applying the control-based affiliate definition and not a narrower one chosen by the filer. This is the element that converts an omission from a silent arithmetic gap into an affirmative misstatement on the face of the filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1106
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerName/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerName",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer name",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1107
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerName/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerName",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Full legal name of the executive officer who certifies that the enumerated affiliate perimeter is complete. This is the element that converts regca:AffiliatePerimeterCompletenessAttestationIndicator from an unattributed checkbox into a named person's representation.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1108
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerTitle/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer title",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1109
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerTitle/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Title of the officer attesting to the affiliate perimeter, as the issuer itself styles the position. Reported in addition to regca:AffiliatePerimeterAttestingOfficerRole, which normalises the officer into standard role categories; this element preserves the issuer's own title for the person.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1110
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerRole/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerRole",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer role",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1111
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerRole/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerRole",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Role category of the officer attesting to the affiliate perimeter. The residual member regca:FunctionalEquivalentExecutiveOfficerMember covers a signer who holds none of the listed titles but serves in the functional capacity of one; a signer who serves in no such capacity has no member to select.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1112
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerIdentifier/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerIdentifier",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer identifier",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1113
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestingOfficerIdentifier/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerIdentifier",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Stable issuer-assigned identifier for the certifying officer, carried across filings so the same person is recognisable when a middle initial, a suffix or a nickname changes the reported name. Deliberately NOT a Legal Entity Identifier: an LEI under ISO 17442 identifies a legal entity, and the only LEIs on this schedule belong to the issuer and to the enumerated affiliates - regca:AffiliateLegalEntityIdentifier. Demanding one for a natural person would be a category error and would invite a false value.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1114
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestationDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestationDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attestation date",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1115
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterAttestationDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestationDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Date on which the certifying officer signed the affiliate-perimeter completeness certification. Must fall on or after the reporting date and on or before the filing date.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1116
        },
        {
          "@id": "regca-complete:label/AffiliateCanInfluenceTransactionOrderingIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanInfluenceTransactionOrderingIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate can influence transaction ordering indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1117
        },
        {
          "@id": "regca-complete:label/AffiliateCanObserveTransactionsBeforeConfirmationIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanObserveTransactionsBeforeConfirmationIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate can observe transactions before public confirmation indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1118
        },
        {
          "@id": "regca-complete:label/CombinedEntitiesCouldInfluenceConsensusIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedEntitiesCouldInfluenceConsensusIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined entities could influence consensus indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1119
        },
        {
          "@id": "regca-complete:label/CombinedStakeSharePercentageOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedStakeSharePercentageOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined stake share of the issuer and its affiliates on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1120
        },
        {
          "@id": "regca-complete:label/CombinedStakeSharePercentageOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedStakeSharePercentageOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The proportion of a blockchain network's total active stake controlled, on that network, by the issuer together with every affiliate reported on that network. Stored as a fraction, so 0.34 is thirty-four per cent.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1121
        },
        {
          "@id": "regca-complete:label/CombinedHashPowerSharePercentageOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedHashPowerSharePercentageOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined hash power share of the issuer and its affiliates on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1122
        },
        {
          "@id": "regca-complete:label/CombinedHashPowerSharePercentageOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedHashPowerSharePercentageOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The proportion of a blockchain network's total hash rate contributed, on that network, by the issuer together with every affiliate reported on that network. Stored as a fraction.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1123
        },
        {
          "@id": "regca-complete:label/CombinedValidatorSlotsControlledOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedValidatorSlotsControlledOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined validator slots controlled on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1124
        },
        {
          "@id": "regca-complete:label/CombinedValidatorSlotsControlledOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedValidatorSlotsControlledOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of validator slots on a blockchain network controlled by the issuer together with every affiliate reported on that network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1125
        },
        {
          "@id": "regca-complete:label/IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer could fulfill obligations if network disrupted indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1126
        },
        {
          "@id": "regca-complete:label/IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Whether the issuer could continue to meet its obligations under the covered investment contract if a network on which it participates were disrupted.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1127
        },
        {
          "@id": "regca-complete:label/NetworkCongestionAffectsBothOperationsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkCongestionAffectsBothOperationsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Network congestion affects both operations and obligations indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1128
        },
        {
          "@id": "regca-complete:label/NetworkCongestionAffectsBothOperationsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkCongestionAffectsBothOperationsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Whether congestion on a network would affect both the issuer's network participation and its obligations under the covered investment contract.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1129
        },
        {
          "@id": "regca-complete:label/SinglePointsOfFailureIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SinglePointsOfFailureIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Single points of failure affecting both network and operations indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1130
        },
        {
          "@id": "regca-complete:label/SinglePointsOfFailureDescriptionExplanatory/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SinglePointsOfFailureDescriptionExplanatory",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of single points of failure [text block]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1131
        },
        {
          "@id": "regca-complete:label/MiningOrStakingAssetsPledgedOrEncumberedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:MiningOrStakingAssetsPledgedOrEncumberedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Mining or staking assets pledged or encumbered indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1132
        },
        {
          "@id": "regca-complete:label/PledgedOrEncumberedAssetsDescriptionExplanatory/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PledgedOrEncumberedAssetsDescriptionExplanatory",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Description of pledged or encumbered assets [text block]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1133
        },
        {
          "@id": "regca-complete:label/IssuerBlockchainNetworkParticipationAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerBlockchainNetworkParticipationAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer blockchain network participation [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1134
        },
        {
          "@id": "regca-complete:label/IssuerBlockchainNetworkParticipationAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerBlockchainNetworkParticipationAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Blockchain Network Participation (BNP) disclosure: for each network the subject crypto asset uses, what the issuer operates and controls there (protocol, nodes and validators, stake and hash-power share, governance tokens, revenue, dependencies). Element names, datatypes and period types are unchanged from the BNP taxonomy filed with the FDIC, so facts compare across agencies. Offered under Rule 103(b)(9) (technology infrastructure, participants, and other parties and systems) and in answer to Request for Comment 28. The items reported for a period are in a table of their own, \"Rule 103(b)(9) — issuer blockchain network participation for the period\".",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1135
        },
        {
          "@id": "regca-complete:label/OperationalControlsAndPoliciesAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OperationalControlsAndPoliciesAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Operational controls and policies [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1136
        },
        {
          "@id": "regca-complete:label/OperationalControlsAndPoliciesAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OperationalControlsAndPoliciesAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Controls over the issuer's network participation: oversight, internal audit, information barriers, and transaction-ordering safeguards.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1137
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate blockchain network participation [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1138
        },
        {
          "@id": "regca-complete:label/AffiliateBlockchainNetworkParticipationAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Network participation by the issuer's affiliates (Rule 405 definition, adopted by Rule 100). Affiliates are related persons under Rule 100, and their participation bears on conflicts of interest under Rule 103(b)(4)(ii). The perimeter count and officer attestation make an omitted affiliate a false statement on the face of the filing. The items reported for a period are in a table of their own, \"Rule 103(b)(9) — affiliate blockchain network participation for the period\".",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1139
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterCompletenessCertificationAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessCertificationAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter completeness certification [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1140
        },
        {
          "@id": "regca-complete:label/AffiliatePerimeterCompletenessCertificationAbstract/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessCertificationAbstract",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Grouping parent for the signature block that certifies the affiliate perimeter enumeration is complete. Sits beside regca:AffiliatePerimeterCompletenessAttestationIndicator, which states the proposition; the elements under this abstract identify the officer who certifies it and when.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 1141
        },
        {
