              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_UC_08\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($Basis) ne 'http://luca.pacioli.ai/report#AcquisitionExceedingHalfOfTotalAssetsMember' or $Price gt $P_fundamentalChangeAssetShare * $TotalAssets\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Basis\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Basis\" name=\"Basis\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Basis_concept\">\n    <cf:concept><cf:qname>regca:FundamentalChangeBasis</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Basis\" xlink:to=\"f_Basis_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Price\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Price\" name=\"Price\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Price_concept\">\n    <cf:concept><cf:qname>regca:AcquisitionPurchasePrice</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Price_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Price\" xlink:to=\"f_Price_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_TotalAssets\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_TotalAssets\" name=\"TotalAssets\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_TotalAssets_concept\">\n    <cf:concept><cf:qname>regca:TotalConsolidatedAssetsAtMostRecentFiscalYearEnd</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalAssets\" xlink:to=\"f_TotalAssets_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_TotalAssets_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_TotalAssets\" xlink:to=\"f_TotalAssets_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
