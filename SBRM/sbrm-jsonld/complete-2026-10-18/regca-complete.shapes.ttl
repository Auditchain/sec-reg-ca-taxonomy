@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix regca: <http://luca.pacioli.ai/report#> .
@prefix regca-complete: <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/expression/REGCA_BNP_D_01> a sh:NodeShape ;
    rdfs:label "REGCA_BNP_D_01: regca:EstimatedStakeSharePercentage = regca:EffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/expr/REGCA_BNP_D_01> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "REGCA_BNP_D_01: reported {?reported} but regca:EstimatedStakeSharePercentage = regca:EffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork gives {?computed} (tolerance 0.0001 from the rule’s XBRL Formula twin)" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?reported ?computed WHERE {
  $this sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?reported ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period .
  ?f1 a regca:EffectiveStakeControlledOnNetwork ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?v2 .
  FILTER NOT EXISTS { $this ?ax3 ?av4 . ?ax3 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?f1 ?ax3 ?av4 } }
  FILTER NOT EXISTS { ?f1 ?bx5 ?bv6 . ?bx5 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx5 ?bv6 } }
  ?f7 a regca:TotalActiveStakeOnNetwork ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?v8 .
  FILTER NOT EXISTS { $this ?ax9 ?av10 . ?ax9 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?f7 ?ax9 ?av10 } }
  FILTER NOT EXISTS { ?f7 ?bx11 ?bv12 . ?bx11 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx11 ?bv12 } }
  FILTER (?v8 > 0)
  BIND ((?v2 / ?v8) AS ?computed)
  FILTER (ABS(?reported * ?v8 - ?v2) > 0.0001 * ?v8)
}""" ] ;
    sh:targetClass regca:EstimatedStakeSharePercentage .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/expression/REGCA_BNP_D_02> a sh:NodeShape ;
    rdfs:label "REGCA_BNP_D_02: regca:EstimatedHashPowerSharePercentage = regca:HashRateContributedToNetwork div regca:TotalNetworkHashRate" ;
