<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/rollforward/regca-31-economics/SubjectCryptoAssetSupplyOutstanding> a sh:NodeShape ;
    rdfs:label "Roll-forward regca:SubjectCryptoAssetSupplyOutstanding (regca-31-economics)" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/fragment/regca-31-economics#rollforward-SubjectCryptoAssetSupplyOutstanding> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "regca:SubjectCryptoAssetSupplyOutstanding: opening {?opening} plus net change {?netChange} does not equal closing {?closing}" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?opening ?closing (SUM(?signed) AS ?netChange) WHERE {
  $this cmns-dt:hasTime ?closingDate ; sbrm-rev:isReportedBy ?entity ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?closing .
  ?duration cmns-dt:hasEndDate ?closingDate ; cmns-dt:hasStartDate/cmns-dt:hasDateValue ?startDate .
  ?open a regca:SubjectCryptoAssetSupplyOutstanding ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime/cmns-dt:hasDateValue ?openDate ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?opening .
  FILTER (STR(xsd:dateTime(CONCAT(STR(?startDate), "T00:00:00")) - xsd:dateTime(CONCAT(STR(?openDate), "T00:00:00"))) = "P1D")
  FILTER NOT EXISTS { $this ?ax1 ?av2 . ?ax1 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?open ?ax1 ?av2 } }
  FILTER NOT EXISTS { ?open ?bx3 ?bv4 . ?bx3 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx3 ?bv4 } }
  { ?change a regca:SubjectCryptoAssetUnitsGenerated . BIND (1 AS ?weight) } UNION { ?change a regca:SubjectCryptoAssetUnitsDestroyed . BIND (-1 AS ?weight) }
  ?change sbrm-rev:isReportedBy ?entity ; cmns-dt:hasDatePeriod ?duration ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?changeValue .
  FILTER NOT EXISTS { $this ?ax5 ?av6 . ?ax5 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?change ?ax5 ?av6 } }
  FILTER NOT EXISTS { ?change ?bx7 ?bv8 . ?bx7 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx7 ?bv8 } }
  BIND (?changeValue * ?weight AS ?signed)
}
GROUP BY $this ?opening ?closing ?duration
HAVING (?opening + SUM(?signed) != ?closing)""" ] ;
    sh:targetClass regca:SubjectCryptoAssetSupplyOutstanding .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/rollforward/regca-73-cash-flows/CashAndCashEquivalents> a sh:NodeShape ;
    rdfs:label "Roll-forward regca:CashAndCashEquivalents (regca-73-cash-flows)" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/fragment/regca-73-cash-flows#rollforward-CashAndCashEquivalents> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "regca:CashAndCashEquivalents: opening {?opening} plus net change {?netChange} does not equal closing {?closing}" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?opening ?closing (SUM(?signed) AS ?netChange) WHERE {
  $this cmns-dt:hasTime ?closingDate ; sbrm-rev:isReportedBy ?entity ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?closing .
  ?duration cmns-dt:hasEndDate ?closingDate ; cmns-dt:hasStartDate/cmns-dt:hasDateValue ?startDate .
  ?open a regca:CashAndCashEquivalents ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime/cmns-dt:hasDateValue ?openDate ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?opening .
  FILTER (STR(xsd:dateTime(CONCAT(STR(?startDate), "T00:00:00")) - xsd:dateTime(CONCAT(STR(?openDate), "T00:00:00"))) = "P1D")
  FILTER NOT EXISTS { $this ?ax1 ?av2 . ?ax1 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?open ?ax1 ?av2 } }
  FILTER NOT EXISTS { ?open ?bx3 ?bv4 . ?bx3 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx3 ?bv4 } }
  { ?change a regca:CashAndCashEquivalentsPeriodIncreaseDecrease . BIND (1 AS ?weight) }
  ?change sbrm-rev:isReportedBy ?entity ; cmns-dt:hasDatePeriod ?duration ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?changeValue .
  FILTER NOT EXISTS { $this ?ax5 ?av6 . ?ax5 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?change ?ax5 ?av6 } }
  FILTER NOT EXISTS { ?change ?bx7 ?bv8 . ?bx7 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx7 ?bv8 } }
  BIND (?changeValue * ?weight AS ?signed)
}
GROUP BY $this ?opening ?closing ?duration
HAVING (?opening + SUM(?signed) != ?closing)""" ] ;
    sh:targetClass regca:CashAndCashEquivalents .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/rollforward/regca-74-changes-in-equity/Equity> a sh:NodeShape ;
    rdfs:label "Roll-forward regca:Equity (regca-74-changes-in-equity)" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/fragment/regca-74-changes-in-equity#rollforward-Equity> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "regca:Equity: opening {?opening} plus net change {?netChange} does not equal closing {?closing}" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?opening ?closing (SUM(?signed) AS ?netChange) WHERE {
  $this cmns-dt:hasTime ?closingDate ; sbrm-rev:isReportedBy ?entity ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?closing .
  ?duration cmns-dt:hasEndDate ?closingDate ; cmns-dt:hasStartDate/cmns-dt:hasDateValue ?startDate .
  ?open a regca:Equity ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime/cmns-dt:hasDateValue ?openDate ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?opening .
  FILTER (STR(xsd:dateTime(CONCAT(STR(?startDate), "T00:00:00")) - xsd:dateTime(CONCAT(STR(?openDate), "T00:00:00"))) = "P1D")
  FILTER NOT EXISTS { $this ?ax1 ?av2 . ?ax1 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?open ?ax1 ?av2 } }
  FILTER NOT EXISTS { ?open ?bx3 ?bv4 . ?bx3 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx3 ?bv4 } }
  { ?change a regca:NetIncomeLoss . BIND (1 AS ?weight) } UNION { ?change a regca:OtherComprehensiveIncomeLoss . BIND (1 AS ?weight) } UNION { ?change a regca:ProceedsFromIssuanceOfEquityRecognizedInEquity . BIND (1 AS ?weight) } UNION { ?change a regca:OtherChangesInEquity . BIND (1 AS ?weight) }
  ?change sbrm-rev:isReportedBy ?entity ; cmns-dt:hasDatePeriod ?duration ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?changeValue .
  FILTER NOT EXISTS { $this ?ax5 ?av6 . ?ax5 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?change ?ax5 ?av6 } }
  FILTER NOT EXISTS { ?change ?bx7 ?bv8 . ?bx7 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx7 ?bv8 } }
  BIND (?changeValue * ?weight AS ?signed)
}
GROUP BY $this ?opening ?closing ?duration
HAVING (?opening + SUM(?signed) != ?closing)""" ] ;
    sh:targetClass regca:Equity .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/rollup/regca-10-startup/AmountCountedAgainstStartupOfferingLimit> a sh:NodeShape ;
    rdfs:label "Roll-up regca:AmountCountedAgainstStartupOfferingLimit (regca-10-startup)" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/fragment/regca-10-startup#rollup-AmountCountedAgainstStartupOfferingLimit> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "regca:AmountCountedAgainstStartupOfferingLimit ({?total}) does not equal the sum of its inputs ({?sumOfInputs}) in regca-10-startup" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?total (SUM(?signed) AS ?sumOfInputs) WHERE {
  $this sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?total ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period .
  { ?input a regca:AggregateOfferingPriceOfCurrentCoveredTransaction . BIND (1 AS ?weight) } UNION { ?input a regca:GrossProceedsFromPriorAndCurrentCoveredTransactions . BIND (1 AS ?weight) }
  ?input sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?inputValue .
  FILTER NOT EXISTS { $this ?ax1 ?av2 . ?ax1 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?input ?ax1 ?av2 } }
