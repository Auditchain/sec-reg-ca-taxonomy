    sh:targetClass regca:AffiliateEstimatedHashPowerSharePercentage .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/expression/REGCA_BNP_TIE_01> a sh:NodeShape ;
    rdfs:label "REGCA_BNP_TIE_01: $BlockchainNetworkParticipationNetIncome = $BlockchainNetworkParticipationRevenue - $BlockchainNetworkParticipationExpenses" ;
    prov:wasDerivedFrom <http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/expr/REGCA_BNP_TIE_01> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "REGCA_BNP_TIE_01: reported {?reported} but $BlockchainNetworkParticipationNetIncome = $BlockchainNetworkParticipationRevenue - $BlockchainNetworkParticipationExpenses gives {?computed}" ;
            sh:prefixes regca-complete:shapes ;
            sh:select """SELECT $this ?reported ?computed WHERE {
  $this sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?reported ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period .
  ?f1 a regca:BlockchainNetworkParticipationRevenue ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?v2 .
  FILTER NOT EXISTS { $this ?ax3 ?av4 . ?ax3 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?f1 ?ax3 ?av4 } }
  FILTER NOT EXISTS { ?f1 ?bx5 ?bv6 . ?bx5 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx5 ?bv6 } }
  ?f7 a regca:BlockchainNetworkParticipationExpenses ; sbrm-rev:isReportedBy ?entity ; cmns-dt:hasTime|cmns-dt:hasDatePeriod ?period ; sbrm-rst:hasFactValue/cmns-qtu:hasNumericValue ?v8 .
  FILTER NOT EXISTS { $this ?ax9 ?av10 . ?ax9 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { ?f7 ?ax9 ?av10 } }
  FILTER NOT EXISTS { ?f7 ?bx11 ?bv12 . ?bx11 a sbrm-mm:TypedDimension . FILTER NOT EXISTS { $this ?bx11 ?bv12 } }
  BIND ((?v2 - ?v8) AS ?computed)
  FILTER (?computed != ?reported)
}""" ] ;
    sh:targetClass regca:BlockchainNetworkParticipationNetIncome .

<http://luca.pacioli.ai/report/sbrm/complete-2026-10-18/shape/expression/REGCA_C_BS_01> a sh:NodeShape ;
