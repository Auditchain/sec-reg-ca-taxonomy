        [ sh:namespace "https://www.omg.org/spec/SBRM/ReportingEnvelope/"^^xsd:anyURI ;
            sh:prefix "sbrm-rev" ],
        [ sh:namespace "https://accounting.auditchain.finance/sbrm/2026/metamodel/"^^xsd:anyURI ;
            sh:prefix "sbrm-mm" ],
        [ sh:namespace "https://www.omg.org/spec/Commons/DatesAndTimes/"^^xsd:anyURI ;
