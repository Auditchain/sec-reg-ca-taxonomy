        {
          "@id": "regca-1crypto:fact/FACTd4b0e5ae43-0",
          "@type": "regca:ConflictsOfInterestDescriptionExplanatory",
          "dct:identifier": "FACTd4b0e5ae43-0",
          "sbrm-mm:sequence": 669,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Auditchain operates its own validator on Ethereum and intends to operate its own validator on Polygon PoS and its own full node on Robinhood Chain, on the same networks as the Company, and earns the same kinds of rewards. Auditchain receives 20 percent of the Company's revenue other than offering proceeds, including the Company's staking rewards. Auditchain will also receive 28,250,000 AUDT after the filing of Form TR. See \"Material aspects of conflicts of interest and related person transactions.\""
          },
          "regca:AffiliateIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 770
        },
        {
          "@id": "regca-1crypto:fact/FACTedddd8d7f9-0",
          "@type": "regca:ConflictMitigationMeasuresExplanatory",
          "dct:identifier": "FACTedddd8d7f9-0",
          "sbrm-mm:sequence": 670,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The material terms of the Auditchain License are disclosed in this document. Neither the Company nor Auditchain holds a privileged role in the consensus or governance of any Underlying Network. Their combined stake on Ethereum is reported in this document and is immaterial to consensus. Neither has a stake on Polygon PoS at the date of this document. The independent director reviews related person transactions."
          },
          "regca:AffiliateIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 771
        },
