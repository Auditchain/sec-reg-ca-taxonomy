          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Governance Council, through the Council Contract, once Governance Votes open. No member is an affiliate, founder, director, officer, employee or adviser of the Company or of Auditchain."
          },
          "regca:PermissionIdentifierTypedAxis": 11,
          "xbrlb:sourceIndex": 555
        },
        {
          "@id": "regca-1crypto:fact/FACTd482ebd5fd-10",
