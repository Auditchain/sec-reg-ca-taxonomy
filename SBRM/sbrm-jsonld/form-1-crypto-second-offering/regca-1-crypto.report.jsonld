        },
        {
          "@id": "regca-1crypto:fact/FACT63eb091b33-0",
          "@type": "regca:EssentialManagerialEffortProgressDescription",
          "dct:identifier": "FACT63eb091b33-0",
          "sbrm-mm:sequence": 823,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Completed. We deployed the Subsidies Contract on July 1, 2027, with the Token Contract, the Validation Contract and the Claims Contract. Each month, the Subsidies Contract splits the AUDT Subsidies for that month equally among the active PVNs, as described under \"Plan of development.\" It can pay no more than 1,000,000 AUDT before the filing of Form TR, and we have set the rate so that that amount is paid over the whole period until that filing."
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 787
        },
        {
          "@id": "regca-1crypto:fact/FACT7e0c4d7290-1",
          "@type": "regca:EssentialManagerialEffortDescription",
          "dct:identifier": "FACT7e0c4d7290-1",
          "sbrm-mm:sequence": 824,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "To achieve the adoption of a minimum of 30 PVNs, not counting any PVN that we operate."
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 2,
          "xbrlb:sourceIndex": 788
        },
        {
          "@id": "regca-1crypto:fact/FACT2c0d25a34a-1",
