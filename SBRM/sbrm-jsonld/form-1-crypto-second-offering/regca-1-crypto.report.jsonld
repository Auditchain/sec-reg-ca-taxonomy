        {
          "@id": "regca-1crypto:fact/FACT7407b8a294-0",
          "@type": "regca:PriorRegulationCryptoAssetsOfferingDescription",
          "dct:identifier": "FACT7407b8a294-0",
          "sbrm-mm:sequence": 1014,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "An offering under the startup exemption of Regulation Crypto Assets (Subpart B), made on Form 1-SU. The offering was for 70 units of a covered investment contract at $50,000 per unit, for an aggregate offering price of $3,500,000. Each unit is a Pacioli Validating Node: 50,000 AUDT delivered staked, with a node software license. The 70 units are the equivalent of 3,500,000 AUDT at $1.00 per AUDT. Form NOR was filed, and Form 1-SU was filed and posted, on March 1, 2027. All 70 units were sold at five closings from April 5, 2027 to August 27, 2027. Form 1-SU is posted in Inline XBRL at the address below."
          },
          "regca:PriorRegulationCryptoAssetsOfferingIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 889
        },
