        {
          "@id": "regca-1crypto:fact/FACTddb34c9f12-0",
          "@type": "regca:InfrastructureDependencyDescriptionExplanatory",
          "dct:identifier": "FACTddb34c9f12-0",
          "sbrm-mm:sequence": 497,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Company's validator on this Underlying Network is not critical to Pacioli. The Smart Contracts run on the network itself, whichever validators secure it."
          },
          "regca:BlockchainNetworkIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 615
        },
        {
          "@id": "regca-1crypto:fact/FACT99538a0df8-0",
          "@type": "regca:BusinessContinuityPlanForInfrastructureFailureExplanatory",
          "dct:identifier": "FACT99538a0df8-0",
          "sbrm-mm:sequence": 498,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "If the hosted validator fails, the Company restores it from its backed-up keys and configuration, on hardware that Northstar Node Hosting LLC provides. An Ethereum validator that is offline earns no rewards and incurs small inactivity penalties, but it is not slashed."
          },
          "regca:BlockchainNetworkIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 616
        },
