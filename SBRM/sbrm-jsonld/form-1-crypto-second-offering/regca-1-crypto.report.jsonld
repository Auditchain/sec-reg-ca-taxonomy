        {
          "@id": "regca-1crypto:fact/FACT693e93a60f",
          "@type": "regca:GovernanceAndOversightOfNetworkParticipationExplanatory",
          "dct:identifier": "FACT693e93a60f",
          "sbrm-mm:sequence": 637,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Our board of directors, which has three members, oversees our validators and nodes. Our Chief Executive Officer is responsible for their operation. Northstar Node Hosting LLC reports monthly on uptime and rewards. We run the default validator clients without software that extracts maximal extractable value (MEV), and we do not sequence transactions on any network."
          },
          "xbrlb:sourceIndex": 109
        },
