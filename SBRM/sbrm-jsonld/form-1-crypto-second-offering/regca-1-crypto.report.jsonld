          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Council Contract, from the deployment of the Governance Contract. It acts by ordinary approval of the Governance Council. The Company is never the Guardian."
          },
