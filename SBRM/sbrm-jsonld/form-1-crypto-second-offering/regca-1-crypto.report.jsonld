          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Liquidity contracts"
          },
          "regca:PermissionIdentifierTypedAxis": 17,
          "xbrlb:sourceIndex": 1131
        },
        {
          "@id": "regca-1crypto:fact/FACT884ab99890-16",
          "@type": "regca:PermissionHolderDescription",
          "dct:identifier": "FACT884ab99890-16",
          "sbrm-mm:sequence": 1258,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "No one. None of the three liquidity contracts has a key."
          },
          "regca:PermissionIdentifierTypedAxis": 17,
          "xbrlb:sourceIndex": 1132
        },
        {
          "@id": "regca-1crypto:fact/FACTa951a653eb-16",
          "@type": "regca:PermissionCapabilitiesDescription",
          "dct:identifier": "FACTa951a653eb-16",
          "sbrm-mm:sequence": 1259,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "When transfers of AUDT open, any person may call each liquidity contract to deposit its AUDT and USDC in its Uniswap AUDT/USDC pool at $1.50 per AUDT. The contract holds the pool position permanently: no person can withdraw the AUDT or the USDC. It collects the trading fees that the position earns and pays them to the Company."
          },
          "regca:PermissionIdentifierTypedAxis": 17,
