          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Subsidies Contract, when the Validation Contract invokes it and, for consultation rewards, when two-thirds of the Governance Council direct it after the filing of Form TR"
          },
          "regca:PermissionIdentifierTypedAxis": 3,
          "xbrlb:sourceIndex": 513
        },
        {
          "@id": "regca-1crypto:fact/FACT01f5361148-2",
