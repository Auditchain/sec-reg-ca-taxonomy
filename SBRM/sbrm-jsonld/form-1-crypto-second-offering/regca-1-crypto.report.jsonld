        },
        {
          "@id": "regca-1crypto:fact/FACT36f0df1491-14",
          "@type": "regca:PermissionHolderDescription",
          "dct:identifier": "FACT36f0df1491-14",
          "sbrm-mm:sequence": 1246,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Council Contract on Ethereum, from the Handover: for the reserve, on the two-thirds approval of the Governance Council; for the partnership allocation, after a general proposal to mint a stated portion passes a Governance Vote and receives the two-thirds approval of the Governance Council."
          },
          "regca:PermissionIdentifierTypedAxis": 15,
          "xbrlb:sourceIndex": 1120
        },
        {
          "@id": "regca-1crypto:fact/FACT94617a51bc-14",
          "@type": "regca:PermissionCapabilitiesDescription",
          "dct:identifier": "FACT94617a51bc-14",
          "sbrm-mm:sequence": 1247,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Calls the mint function of the Token Contract, up to 58,916,667 AUDT in total: 28,916,667 AUDT from the reserve and 30,000,000 AUDT from the partnership allocation. Each mint names the amount, the purpose and the receiving contract, which may be a contract that the Governance Council deploys for bounties, incentives or another purpose. No AUDT may be minted to a member of the Governance Council, its organization or an affiliate of either, to the Company or to Auditchain."
          },
          "regca:PermissionIdentifierTypedAxis": 15,
          "xbrlb:sourceIndex": 1121
        },
        {
