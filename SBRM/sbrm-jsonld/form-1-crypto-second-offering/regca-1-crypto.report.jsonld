        },
        {
          "@id": "regca-1crypto:fact/FACTeaf6330a9d-6",
          "@type": "regca:TradingVenueAccessDescription",
          "dct:identifier": "FACTeaf6330a9d-6",
          "sbrm-mm:sequence": 1270,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Decentralized exchange; any wallet. This is an intended venue. The Company intends to seek trading of AUDT on this venue three business days after it files Form TR (January 4, 2029 in the timeline of this demonstration). No venue has agreed to list AUDT, and AUDT is not listed on any venue at the date of this document. The liquidity contract on Polygon PoS will deposit 2,000,000 AUDT and $3,000,000 of USDC in this pool at $1.50 per AUDT when transfers of AUDT open, and will hold that position permanently."
          },
          "regca:TradingVenueIdentifierTypedAxis": 7,
          "xbrlb:sourceIndex": 1144
        },
