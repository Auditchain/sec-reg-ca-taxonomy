        },
        {
          "@id": "regca-1crypto:fact/FACT1067a06976",
          "@type": "regca:SinglePointsOfFailureDescriptionExplanatory",
          "dct:identifier": "FACT1067a06976",
          "sbrm-mm:sequence": 683,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasDatePeriod": "regca-1crypto:period/2027-01-01--2027-06-30",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Ethereum is the settlement layer for the Token Contract and the other Smart Contracts. A disruption of Ethereum would delay deliveries of AUDT, validation payments and rewards until service resumed. It would also idle our Ethereum validator. Neither our Ethereum validator nor the validator and node that we intend to operate is a single point of failure for the Network or for any Underlying Network."
          },
          "xbrlb:sourceIndex": 133
        },
