            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Administration of the Token Contract"
          },
          "regca:PermissionIdentifierTypedAxis": 7,
          "xbrlb:sourceIndex": 536
        },
        {
          "@id": "regca-1crypto:fact/FACT8d0b4d5fcc-6",
          "@type": "regca:PermissionHolderDescription",
          "dct:identifier": "FACT8d0b4d5fcc-6",
          "sbrm-mm:sequence": 416,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Key Holder Contract on each Underlying Network, until the Handover, on the same signatures as the role that mints for offering deliveries and allocations. In the Handover, the key is used once to give the Council Contract its capped right to mint and is then destroyed. After it, no role of the Token Contract can grant another role."
          },
          "regca:PermissionIdentifierTypedAxis": 7,
          "xbrlb:sourceIndex": 537
        },
        {
          "@id": "regca-1crypto:fact/FACTb65753c55a-6",
