          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Calls the mint function of the Token Contract, up to 136,083,333 AUDT in total, for the AUDT delivered in the Company's offerings, the stakes of the two initial MCVs, the liquidity allocation (12,000,000 AUDT into the liquidity contracts and 8,000,000 AUDT to the Company) and the treasury allocation, which includes the stake of the Company's PVN."
          },
          "regca:PermissionIdentifierTypedAxis": 4,
          "xbrlb:sourceIndex": 520
        },
