          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "None. We have two officers. The validators that we operate do not give us any information about transactions in Pacioli, before those transactions are confirmed, that other participants do not have."
