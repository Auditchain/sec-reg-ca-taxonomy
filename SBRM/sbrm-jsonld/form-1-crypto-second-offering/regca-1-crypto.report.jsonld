            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Auditchain Labs AG"
          },
          "regca:RelatedPersonIdentifierTypedAxis": 4,
          "xbrlb:sourceIndex": 294
        },
        {
          "@id": "regca-1crypto:fact/FACT186738e2e2-3",
          "@type": "regca:RelatedPersonRoleDescription",
          "dct:identifier": "FACT186738e2e2-3",
          "sbrm-mm:sequence": 150,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Licensor and owner of Pacioli and the Disclosure Models, and developer of the Reg CA Disclosure Model. Affiliate under common control with the Company: Jason Meyers controls both. The Company's Chief Executive Officer is its Lead Architect. As consideration for the Auditchain License, it will receive 28,250,000 AUDT after the filing of Form TR and a royalty of 20 percent of the Company's revenue, excluding offering proceeds. It receives no taxonomy-developer rewards. It operates its own validator on Ethereum and intends to operate its own validator on Polygon PoS and its own full node on Robinhood Chain."
          },
          "regca:RelatedPersonIdentifierTypedAxis": 4,
          "xbrlb:sourceIndex": 295
        },
