            },
            "cmns-qtu:hasMeasurementUnit": "iso4217:USD",
            "xbrlb:decimals": "INF"
          },
          "xbrlb:sourceIndex": 63
        },
        {
          "@id": "regca-1crypto:fact/FACTbdd6304003",
          "@type": "regca:FunctionalAssetPriceAllocationBasis",
          "dct:identifier": "FACTbdd6304003",
          "sbrm-mm:sequence": 84,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "We provide the Node License without charge. We attribute the entire purchase price to the AUDT and allocate none of it to the Node License."
          },
          "xbrlb:sourceIndex": 64
        },
        {
