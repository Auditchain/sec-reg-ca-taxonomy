          "dct:identifier": "FACTf721fbf674-15",
          "sbrm-mm:sequence": 1251,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Bridged AUDT on Polygon PoS and Robinhood Chain"
          },
          "regca:PermissionIdentifierTypedAxis": 16,
          "xbrlb:sourceIndex": 1125
        },
        {
          "@id": "regca-1crypto:fact/FACT1d9521fd56-15",
          "@type": "regca:PermissionHolderDescription",
          "dct:identifier": "FACT1d9521fd56-15",
          "sbrm-mm:sequence": 1252,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The bridge of each of those networks."
          },
          "regca:PermissionIdentifierTypedAxis": 16,
          "xbrlb:sourceIndex": 1126
        },
        {
          "@id": "regca-1crypto:fact/FACTe3f711e905-15",
          "@type": "regca:PermissionCapabilitiesDescription",
          "dct:identifier": "FACTe3f711e905-15",
          "sbrm-mm:sequence": 1253,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Creates bridged AUDT on that network only when the same amount of AUDT is locked on Ethereum, and removes it when it returns. It does not change the AUDT outstanding."
          },
          "regca:PermissionIdentifierTypedAxis": 16,
          "xbrlb:sourceIndex": 1127
        },
