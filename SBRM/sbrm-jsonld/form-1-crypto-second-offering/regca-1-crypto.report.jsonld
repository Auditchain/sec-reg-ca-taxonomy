        {
          "@id": "regca-1crypto:fact/FACT819d2e7939",
          "@type": "regca:ClarificationOfResponses",
          "dct:identifier": "FACT819d2e7939",
          "sbrm-mm:sequence": 58,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "This is a demonstration filing. See \"Comments on this filing.\" Sales in the Startup Offering are not \"aggregate sales,\" which Rule 100 defines as gross proceeds for securities sold pursuant to other offering statements. We report the Startup Offering in our answer to the question on offerings in the previous 12 months. We count the securities of the class already outstanding in Units, the unit of this Offering. Persons other than us hold 70 Units. Counted in AUDT under Rule 101(e)(1), the securities outstanding are 4,096,774 AUDT, which consist of 3,500,000 AUDT in the 70 Units, 500,000 AUDT in the stakes of the MCVs and 96,774 AUDT of AUDT Subsidies paid by August 31, 2027 to PVNs other than our own. We count the 50,000 AUDT stake of our own PVN and the 3,226 AUDT of AUDT Subsidies paid to it in the supply outstanding (4,150,000 AUDT) but not as securities outstanding. There are no selling securityholders."
          },
          "xbrlb:sourceIndex": 38
        },
