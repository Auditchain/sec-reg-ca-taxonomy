          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Key Holder Contract on Ethereum, until the Handover: before the Founding PVNs were admitted, on the signatures of two of the Company's three directors; since then, on the signatures of three of the five Initial Key Holders, including the Company's. No one holds this role after the Handover."
          },
          "regca:PermissionIdentifierTypedAxis": 4,
          "xbrlb:sourceIndex": 519
        },
        {
          "@id": "regca-1crypto:fact/FACT3488842f20-3",
          "@type": "regca:PermissionCapabilitiesDescription",
          "dct:identifier": "FACT3488842f20-3",
          "sbrm-mm:sequence": 399,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
