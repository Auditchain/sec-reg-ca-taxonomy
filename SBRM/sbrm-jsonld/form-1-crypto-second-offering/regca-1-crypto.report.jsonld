          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Completed. Ironvault Security Labs completed the Security Audit on June 15, 2027, before the deployment on July 1, 2027."
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 5,
          "xbrlb:sourceIndex": 803
        },
        {
          "@id": "regca-1crypto:fact/FACT252ad682cf-5",
          "@type": "regca:EssentialManagerialEffortDescription",
          "dct:identifier": "FACT252ad682cf-5",
          "sbrm-mm:sequence": 840,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "To deploy the Governance Contract, the Council Contract, the Scheme Registry and the Consultation Stake Contract, with the counsel of the Founding PVNs and after a second audit of their code and of every change that they require in the other Smart Contracts. To seat the first Governance Council. To carry out the Handover, by which we give up every key and privileged role that we hold in the Smart Contracts except the two named below. After the Handover, the code and the settings of the Smart Contracts can be changed only by a Governance Vote together with the approval of the Governance Council. The first Governance Council will have at least five members. None of them will be our affiliate, or our founder, director, officer, employee or adviser. This is our final promised effort, and its completion is the trigger for Form TR. After it, we will keep two rights in the Smart Contracts: the right to name the recipients of the team and advisor allocations, and the Form TR Signal, which we will give immediately before we file Form TR and may withdraw only until it takes effect."
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 6,
          "xbrlb:sourceIndex": 804
        },
        {
