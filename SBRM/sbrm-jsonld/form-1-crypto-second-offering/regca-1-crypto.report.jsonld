        {
          "@id": "regca-1crypto:fact/FACT12259e5680",
          "@type": "regca:OfferingByCompetitiveBiddingIndicator",
          "dct:identifier": "FACT12259e5680",
          "sbrm-mm:sequence": 70,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
