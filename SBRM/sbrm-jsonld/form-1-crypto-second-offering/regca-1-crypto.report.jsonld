          "dct:identifier": "FACT8fbc7b2bf8-3",
          "sbrm-mm:sequence": 156,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "The Auditchain License, effective April 5, 2027. The consideration is 28,250,000 AUDT, deliverable after the filing of Form TR, plus a royalty of 20 percent of the Company's revenue other than offering proceeds. The amount shown is the royalty accrued through June 30, 2027 on the Company's staking rewards. It does not include the 28,250,000 AUDT, which has not been delivered."
          },
