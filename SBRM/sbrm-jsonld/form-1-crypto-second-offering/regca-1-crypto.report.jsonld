          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Calls the mint function of the Token Contract to pay validation rewards and consultation rewards. It can mint no more than 45,000,000 AUDT, of which no more than 1,000,000 AUDT before the filing of Form TR and no more than 4,500,000 AUDT as consultation rewards."
          },
          "regca:PermissionIdentifierTypedAxis": 3,
          "xbrlb:sourceIndex": 514
        },
