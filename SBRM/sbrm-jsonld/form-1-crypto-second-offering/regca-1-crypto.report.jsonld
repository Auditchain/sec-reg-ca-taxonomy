          "@type": "regca:InformationBarrierPoliciesExplanatory",
          "dct:identifier": "FACT5d607d1a6f",
          "sbrm-mm:sequence": 641,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
