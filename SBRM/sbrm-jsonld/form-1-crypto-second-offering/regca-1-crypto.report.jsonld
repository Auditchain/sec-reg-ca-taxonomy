          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Approve or refuse a proposal; no proposal can be queued without its approval, except the vote of last resort described under \"Governance mechanisms.\" Refuse or pause a reporting scheme for a stated fault. Elect and remove firm members and seat observers. After the filing of Form TR, open a pool of consultation rewards and confirm who is paid, within the limits written in the code. Direct the Council Contract to mint from the reserve, and from the partnership allocation after a Governance Vote, as described in the row for that role."
          },
          "regca:PermissionIdentifierTypedAxis": 11,
          "xbrlb:sourceIndex": 556
        },
