          "dct:identifier": "FACT58b64978cc-9",
          "sbrm-mm:sequence": 1244,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Minted to the Company before the Handover. Subject to the lock on transfers of all AUDT until the day named in the Form TR Signal. No other lockup or release schedule applies."
          },
          "regca:SupplyAllocationIdentifierTypedAxis": 10,
          "xbrlb:sourceIndex": 1118
        },
        {
          "@id": "regca-1crypto:fact/FACTa844f4da96-14",
