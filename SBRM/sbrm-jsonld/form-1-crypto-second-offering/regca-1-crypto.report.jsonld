        },
        {
          "@id": "regca-1crypto:fact/FACT98d2c07f15-0",
          "@type": "regca:EssentialManagerialEffortDescription",
          "dct:identifier": "FACT98d2c07f15-0",
          "sbrm-mm:sequence": 820,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "To deploy the Subsidies Contract with the Token Contract, the Validation Contract and the Claims Contract. The Subsidies Contract will pay AUDT Subsidies in order to accelerate the adoption of Pacioli."
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 784
        },
        {
          "@id": "regca-1crypto:fact/FACT5222c2121d-0",
          "@type": "regca:EssentialManagerialEffortStatus",
          "dct:identifier": "FACT5222c2121d-0",
          "sbrm-mm:sequence": 821,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "rdf:value": {
              "@id": "http://luca.pacioli.ai/report#CompletedMember"
            }
          },
          "regca:EssentialManagerialEffortIdentifierTypedAxis": 1,
