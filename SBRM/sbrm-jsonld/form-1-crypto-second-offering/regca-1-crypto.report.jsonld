        {
          "@id": "regca-1crypto:fact/FACTdc67fada8c",
          "@type": "regca:TitleAndAmountOfSecuritiesOffered",
          "dct:identifier": "FACTdc67fada8c",
          "sbrm-mm:sequence": 63,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Up to 670 Units of a CIC. Each Unit is a PVN and consists of 50,000 AUDT, delivered staked, together with a Node License. The 670 Units are the equivalent of 33,500,000 AUDT. The price is $62,500 per Unit, or the equivalent of $1.25 per AUDT. The maximum aggregate offering price is $41,875,000."
          },
