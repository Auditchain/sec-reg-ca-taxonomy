            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Upgrade of the Smart Contracts"
          },
          "regca:PermissionIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 500
        },
        {
          "@id": "regca-1crypto:fact/FACTad7dbed116-0",
          "@type": "regca:PermissionHolderDescription",
          "dct:identifier": "FACTad7dbed116-0",
          "sbrm-mm:sequence": 380,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Until the Governance Contract is deployed: the Key Holder Contract, on the signatures of three of the five Initial Key Holders, including the Company's. The Initial Key Holders are the Company, for which Jason Meyers signs, and four Operators of Founding PVNs that are not affiliated with the Company (Ledgerline Compliance LLC, Fenwick Data Services AG, Orbis Disclosure Ltd, Kestrel Regtech Inc.). From then until Governance Votes open: no one. After that: a Governance Vote in which at least two-thirds of the votes cast are in favor, together with two-thirds of the Governance Council."
          },
          "regca:PermissionIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 501
        },
        {
          "@id": "regca-1crypto:fact/FACT858bf35cd4-0",
          "@type": "regca:PermissionCapabilitiesDescription",
          "dct:identifier": "FACT858bf35cd4-0",
          "sbrm-mm:sequence": 381,
          "sbrm-rev:isReportedBy": "regca-1crypto:party/5067001J8OL3RK15TE82/role",
          "cmns-dt:hasTime": "regca-1crypto:period/2027-09-01",
          "sbrm-rst:hasFactValue": {
            "@type": "sbrm-frst:NonNumericFactValue",
            "cmns-txt:hasTextValue": "Upgrade the Smart Contracts. No upgrade can raise a cap, create a right to mint AUDT, move unminted AUDT from one cap to another or change the maximum supply of 300,000,000 AUDT."
          },
          "regca:PermissionIdentifierTypedAxis": 1,
          "xbrlb:sourceIndex": 502
        },
