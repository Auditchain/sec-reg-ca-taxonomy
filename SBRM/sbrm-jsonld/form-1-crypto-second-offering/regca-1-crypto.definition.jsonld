          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "17 CFR 230.405 (Securities Act Rule 405), incorporated by 17 CFR 228.100",
          "dct:bibliographicCitation": "17 CFR 230.405 (affiliate)",
          "cmns-docc:hasTextualContent": "Verbatim: \"An affiliate of, or person affiliated with, a specified person, is a person that directly, or indirectly through one or more intermediaries, controls or is controlled by, or is under common control with, the person specified.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405"
          },
