          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Topic 606, Revenue from Contracts with Customers",
          "dct:bibliographicCitation": "Topic 606",
          "cmns-docc:hasTextualContent": "Topic title as published: \"Revenue from Contracts with Customers (Topic 606)\" (FASB ASU 2016-10)",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
