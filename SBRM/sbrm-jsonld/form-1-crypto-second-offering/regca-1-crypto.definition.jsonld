          "xbrlb:sourceIndex": 1
        },
        {
          "@id": "regca-1crypto:reference/3",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:RegulationCryptoAssetsFilingAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "Request for comment No. 99 (91 FR 54545); 91 FR 54545",
          "cmns-docc:hasTextualContent": "Verbatim: \"Should we require the disclosures in Part I of proposed Form 1-CRYPTO to be submitted using a different structured data language than Form 1-CRYPTO-specific XML?\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
            "@value": "2026-08-21",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 3,
          "xbrlb:sourceIndex": 2
        },
        {
          "@id": "regca-1crypto:reference/4",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:CoverPageAbstract",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "Form NOR, Preliminary information; 91 FR 54654",
          "cmns-docc:hasTextualContent": "Verbatim: \"Exact name of entity(ies) as specified in the charter(s) that comprise the issuer\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
            "@value": "2026-08-21",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 4,
          "xbrlb:sourceIndex": 3
        },
        {
