        },
        {
          "@id": "regca-1crypto:label/ResponsibleEntityName/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ResponsibleEntityName",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Signatures for the answer on offerings in the previous 12 months, given in the manner of Forms 10-K and 10-Q (the signature blocks of Forms 1-KC and 1-SC use the same words): an entity signs through a person duly authorized to sign on its behalf; a person signs on his or her own behalf; each signer's name and title are printed, and each capacity is shown. The exact name of the entity on whose behalf this signature is given (the issuer, or an entity member of an issuer group). Required when the signature is given on behalf of an entity.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 633
        },
        {
