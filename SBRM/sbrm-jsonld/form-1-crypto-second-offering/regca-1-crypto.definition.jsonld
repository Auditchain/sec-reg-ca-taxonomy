        },
        {
          "@id": "regca-1crypto:reference/2204",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:TaxonomyEntryPointAddress",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/xbrl-international",
          "dct:title": "Taxonomy Packages 1.0, Recommendation 2016-04-19",
          "dct:bibliographicCitation": "Taxonomy Packages 1.0, Section 3.2.2",
          "cmns-docc:hasTextualContent": "Verbatim: \"An entry point is a set of URLs that define a logical starting point for the DTS discovery process, as defined in [XBRL 2.1].\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.xbrl.org/Specification/taxonomy-package/REC-2016-04-19/taxonomy-package-REC-2016-04-19.html"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2204,
          "xbrlb:sourceIndex": 2203
        },
        {
          "@id": "regca-1crypto:reference/2205",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:TaxonomyEntryPointAddress",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "Release at 237; 91 FR 54580",
          "cmns-docc:hasTextualContent": "Verbatim: \"would allow Commission staff to more efficiently process, aggregate, and analyze the reported information about the issuers and offerings\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
