          },
          "sbrm-mm:sequence": 2105,
          "xbrlb:sourceIndex": 2104
        },
        {
          "@id": "regca-1crypto:reference/2106",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/rutgers-carlab-engineering-sciences-laboratory-ibn-tofail-university-auditchain-labs-ag",
          "dct:title": "El Imami, Oh, Meyers, Brennan, Vasarhelyi, Sannella, Egan et al., Beyond the Fiat Vault: Evaluating Machine-Readable Blockchain Disclosures for Systemic Safety, Operational Security, and MEV Conflict Mitigation (BNP Disclosure Taxonomy paper)",
          "dct:bibliographicCitation": "PDF p. 9",
          "cmns-docc:hasTextualContent": "Verbatim: \"requires digital asset issuers to disclose the operational characteristics, concentration risks, affiliate relationships, third-party service provider dependencies, and conflict-of-interest exposures arising from their participation in blockchain network infrastructure\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2106,
          "xbrlb:sourceIndex": 2105
        },
        {
          "@id": "regca-1crypto:reference/2107",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/auditchain-labs-ag",
          "dct:title": "Supplemental comment to the FDIC — BNP framework expansion, RIN 3064-AG20 (Mar. 9, 2026)",
          "dct:bibliographicCitation": "PDF p. 4",
          "cmns-docc:hasTextualContent": "Verbatim: \"The BNP disclosure framework is built on a strict one-to-one correspondence between disclosure questions (inputs) and XBRL taxonomy concepts (outputs).\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.fdic.gov/federal-register-publications/supplemental-comment-auditchain-labs-ag-jason-meyers-rin-3064-ag20"
          },
          "dct:date": {
            "@value": "2026-03-09",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2107,
          "xbrlb:sourceIndex": 2106
        },
        {
          "@id": "regca-1crypto:reference/2108",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/rutgers-carlab-engineering-sciences-laboratory-ibn-tofail-university-auditchain-labs-ag",
          "dct:title": "El Imami, Oh, Meyers, Brennan, Vasarhelyi, Sannella, Egan and Ouatik El Alaoui, Testing Machine-Readable Compliance: Validation Gaps and Omission Invariance in Stablecoin Reporting",
          "dct:bibliographicCitation": "PDF p. 16",
          "cmns-docc:hasTextualContent": "Verbatim: \"the BNP layer is real and agency-invariant\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/Testing-Machine-Readable-Compliance.pdf"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2108,
          "xbrlb:sourceIndex": 2107
        },
        {
          "@id": "regca-1crypto:reference/2109",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/supreme-court-of-the-united-states",
          "dct:title": "TSC Industries, Inc. v. Northway, Inc., 426 U.S. 438 (1976)",
          "dct:bibliographicCitation": "426 U.S. at 449",
          "cmns-docc:hasTextualContent": "Verbatim: \"An omitted fact is material if there is a substantial likelihood that a reasonable shareholder would consider it important in deciding how to vote.\" Relied on for BNP disclosure in Auditchain's FDIC comments (RIN 3064-AG19, May 14, 2026; RIN 3064-AG20 supplemental, Mar. 9, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://tile.loc.gov/storage-services/service/ll/usrep/usrep426/usrep426438/usrep426438.pdf"
          },
          "dct:date": {
            "@value": "1976-06-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2109,
          "xbrlb:sourceIndex": 2108
        },
        {
          "@id": "regca-1crypto:reference/2110",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/supreme-court-of-the-united-states",
          "dct:title": "TSC Industries, Inc. v. Northway, Inc., 426 U.S. 438 (1976)",
          "dct:bibliographicCitation": "426 U.S. at 449",
          "cmns-docc:hasTextualContent": "Verbatim: \"there must be a substantial likelihood that the disclosure of the omitted fact would have been viewed by the reasonable investor as having significantly altered the \"total mix\" of information made available.\" Relied on for BNP disclosure in Auditchain's FDIC comments (RIN 3064-AG19, May 14, 2026; RIN 3064-AG20 supplemental, Mar. 9, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://tile.loc.gov/storage-services/service/ll/usrep/usrep426/usrep426438/usrep426438.pdf"
          },
          "dct:date": {
            "@value": "1976-06-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2110,
          "xbrlb:sourceIndex": 2109
        },
        {
          "@id": "regca-1crypto:reference/2111",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/federal-deposit-insurance-corporation",
          "dct:title": "GENIUS Act Requirements and Standards for FDIC-Supervised Permitted Payment Stablecoin Issuers and Insured Depository Institutions (proposed rule), 91 FR 18534 (Apr. 10, 2026)",
          "dct:bibliographicCitation": "91 FR 18548 (proposed 12 CFR 350.6(b))",
          "cmns-docc:hasTextualContent": "Verbatim: \"including reliance on distributed ledger(s) or distributed ledger protocol(s) to process and record payment stablecoin transactions\" Proposed banking-agency standard for payment stablecoin issuers, cited by analogy; addressed in Auditchain's FDIC comment (RIN 3064-AG19, May 14, 2026).",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/04/10/2026-06974/genius-act-requirements-and-standards-for-fdic-supervised-permitted-payment-stablecoin-issuers-and"
          },
          "dct:date": {
            "@value": "2026-04-10",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2111,
          "xbrlb:sourceIndex": 2110
        },
        {
          "@id": "regca-1crypto:reference/2112",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:BlockchainNetworkParticipationForPeriodByNetworkTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/auditchain-labs-ag",
          "dct:title": "Comment letter to the FDIC on GENIUS Act requirements and standards, RIN 3064-AG19, 91 FR 18534 (May 14, 2026)",
          "dct:bibliographicCitation": "PDF p. 3",
          "cmns-docc:hasTextualContent": "Verbatim: \"Validator concentration ratios, affiliate consensus participation, MEV mitigation policies, and slashing event histories each bear directly on the risk\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.fdic.gov/federal-register-publications/auditchain-labs-ag-jason-meyers-rin-3064-ag19.pdf"
          },
          "dct:date": {
            "@value": "2026-05-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2112,
          "xbrlb:sourceIndex": 2111
        },
        {
          "@id": "regca-1crypto:reference/2113",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AggregatedNetworkConcentrationTotalsLineItems",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "17 CFR 228.103(b)(10); 91 FR 54608",
          "cmns-docc:hasTextualContent": "Verbatim: \"This description must avoid generalized statements and include only factors specific to the covered investment contract, the issuer, the subject crypto asset, and the associated crypto network or associated crypto application\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
            "@value": "2026-08-21",
