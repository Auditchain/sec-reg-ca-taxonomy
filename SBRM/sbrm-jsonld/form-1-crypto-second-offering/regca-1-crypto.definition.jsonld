          "dct:bibliographicCitation": "Section IV.B.1 (91 FR 54580); 91 FR 54580",
          "cmns-docc:hasTextualContent": "Verbatim: \"more efficiently process, aggregate, and analyze the reported information\"",
          "cmns-doc:refersTo": {
