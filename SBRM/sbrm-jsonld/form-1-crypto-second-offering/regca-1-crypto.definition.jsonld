            "@value": "Affiliate perimeter attesting officer name",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Full legal name of the executive officer who certifies that the enumerated affiliate perimeter is complete. This is the element that converts regca:AffiliatePerimeterCompletenessAttestationIndicator from an unattributed checkbox into a named person's representation.",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/1829",
            "regca-1crypto:reference/1830",
            "regca-1crypto:reference/1831",
            "regca-1crypto:reference/1832"
          ]
        },
        {
          "@id": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "rdfs:label": {
            "@value": "Affiliate perimeter attesting officer title",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Title of the officer attesting to the affiliate perimeter, as the issuer itself styles the position. Reported in addition to regca:AffiliatePerimeterAttestingOfficerRole, which normalises the officer into standard role categories; this element preserves the issuer's own title for the person.",
            "@language": "en"
          },
          "dct:source": [
