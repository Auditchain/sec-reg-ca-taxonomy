        },
        {
          "@id": "regca-1crypto:reference/2206",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRoot",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 6962, Certificate Transparency",
          "dct:bibliographicCitation": "RFC 6962, Section 2.1",
          "cmns-docc:hasTextualContent": "Verbatim: \"The input to the Merkle Tree Hash is a list of data entries; these entries will be hashed to form the leaves of the Merkle Hash Tree.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc6962"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2206,
          "xbrlb:sourceIndex": 2205
        },
        {
          "@id": "regca-1crypto:reference/2207",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRoot",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 6962, Certificate Transparency",
          "dct:bibliographicCitation": "RFC 6962, Section 2.1",
          "cmns-docc:hasTextualContent": "Verbatim: \"The output is a single 32-byte Merkle Tree Hash.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc6962"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2207,
          "xbrlb:sourceIndex": 2206
        },
        {
          "@id": "regca-1crypto:reference/2208",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRoot",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/national-institute-of-standards-and-technology-nist",
          "dct:title": "FIPS PUB 180-4, Secure Hash Standard (SHS)",
          "dct:bibliographicCitation": "FIPS 180-4, Section 1",
          "cmns-docc:hasTextualContent": "Verbatim: \"These algorithms enable the determination of a message’s integrity: any change to the message will, with a very high probability, result in a different message digest.\"",
          "cmns-doc:refersTo": {
            "@id": "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2208,
          "xbrlb:sourceIndex": 2207
        },
        {
          "@id": "regca-1crypto:reference/2209",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRoot",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "Release at 237; 91 FR 54580",
          "cmns-docc:hasTextualContent": "Verbatim: \"would allow Commission staff to more efficiently process, aggregate, and analyze the reported information about the issuers and offerings\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.federalregister.gov/documents/2026/08/21/2026-17183/regulation-crypto-assets"
          },
          "dct:date": {
            "@value": "2026-08-21",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2209,
          "xbrlb:sourceIndex": 2208
        },
        {
          "@id": "regca-1crypto:reference/2210",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRootMethod",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 8785, JSON Canonicalization Scheme (JCS)",
          "dct:bibliographicCitation": "RFC 8785, Abstract",
          "cmns-docc:hasTextualContent": "Verbatim: \"Cryptographic operations like hashing and signing need the data to be expressed in an invariant format so that the operations are reliably repeatable.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc8785"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2210,
          "xbrlb:sourceIndex": 2209
        },
        {
          "@id": "regca-1crypto:reference/2211",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleRootMethod",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 6962, Certificate Transparency",
          "dct:bibliographicCitation": "RFC 6962, Section 2.1",
          "cmns-docc:hasTextualContent": "Verbatim: \"The input to the Merkle Tree Hash is a list of data entries; these entries will be hashed to form the leaves of the Merkle Hash Tree.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc6962"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2211,
          "xbrlb:sourceIndex": 2210
        },
        {
          "@id": "regca-1crypto:reference/2212",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleTreeVersion1Member",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 8785, JSON Canonicalization Scheme (JCS)",
          "dct:bibliographicCitation": "RFC 8785, Abstract",
          "cmns-docc:hasTextualContent": "Verbatim: \"This document describes the JSON Canonicalization Scheme (JCS).\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc8785"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2212,
          "xbrlb:sourceIndex": 2211
        },
        {
          "@id": "regca-1crypto:reference/2213",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleTreeVersion1Member",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/national-institute-of-standards-and-technology-nist",
          "dct:title": "FIPS PUB 180-4, Secure Hash Standard (SHS)",
          "dct:bibliographicCitation": "FIPS 180-4, Section 6.2",
          "cmns-docc:hasTextualContent": "Verbatim: \"The final result of SHA-256 is a 256-bit message digest.\"",
          "cmns-doc:refersTo": {
            "@id": "https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2213,
          "xbrlb:sourceIndex": 2212
        },
        {
          "@id": "regca-1crypto:reference/2214",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:FilingMerkleTreeVersion1Member",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/internet-engineering-task-force-ietf",
          "dct:title": "RFC 6962, Certificate Transparency",
          "dct:bibliographicCitation": "RFC 6962, Section 2.1",
          "cmns-docc:hasTextualContent": "Verbatim: \"MTH(D[n]) = SHA-256(0x01 || MTH(D[0:k]) || MTH(D[k:n]))\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.rfc-editor.org/rfc/rfc6962"
          },
          "dct:date": {
            "@value": "2026-10-17",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 2214,
          "xbrlb:sourceIndex": 2213
        },
