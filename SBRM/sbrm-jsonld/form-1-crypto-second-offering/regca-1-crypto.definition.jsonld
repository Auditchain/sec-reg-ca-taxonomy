        {
          "@id": "regca:AmendmentExplanatoryNote",
          "rdfs:label": {
            "@value": "Explanatory note to amendment",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "An amendment that relates solely to Part III of Form 1-CRYPTO may be limited to Part I, an explanatory note and Part III.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/859"
        },
        {
          "@id": "regca:AmendmentRelatesSolelyToPartIIIIndicator",
          "rdfs:label": {
            "@value": "Amendment relates solely to Part III (exhibits)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if this Form 1-CRYPTO amendment relates solely to Part III. Part II and the financial statements are then not required.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/860"
        },
        {
          "@id": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "rdfs:label": {
            "@value": "Amendment includes amended audited financial statements",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "If true, the amendment must include the consent of the certifying accountant (filed as an exhibit).",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/861"
        },
        {
          "@id": "regca:PostQualificationAmendmentBasisDomain",
          "rdfs:label": {
            "@value": "Basis for post-qualification amendment [domain]",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/862",
            "regca-1crypto:reference/863",
            "regca-1crypto:reference/864",
            "regca-1crypto:reference/865"
          ]
        },
        {
          "@id": "regca:PostQualificationAnnualUpdateMember",
          "rdfs:label": {
            "@value": "Update at least every 12 months with current financial statements (Rule 301(f)(2)(i)) [member]",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/866"
        },
        {
          "@id": "regca:PostQualificationFundamentalChangeMember",
          "rdfs:label": {
            "@value": "Facts or events representing a fundamental change (Rule 301(f)(2)(ii)) [member]",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/867"
        },
        {
          "@id": "regca:PostQualificationOtherMember",
          "rdfs:label": {
            "@value": "Other, for example omitted pricing information or additional securities (Rule 302(b)-(c)) [member]",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/868",
            "regca-1crypto:reference/869"
          ]
        },
        {
          "@id": "regca:PostQualificationAmendmentBasis",
          "rdfs:label": {
            "@value": "Basis for post-qualification amendment",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Why a post-qualification amendment is filed. Rule 301(f)(2) says when one must be filed; saying which reason applies lets the 12-month deadline be checked.",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/870",
            "regca-1crypto:reference/871",
            "regca-1crypto:reference/872",
            "regca-1crypto:reference/873"
          ]
        },
        {
          "@id": "regca:OfferingStatementQualificationDate",
          "rdfs:label": {
            "@value": "Qualification date of the offering statement",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. In a special financial report, the date the Commission qualified the offering statement (Rule 305(a)(2)(ii)). In a post-qualification amendment, the most recent qualification date: the offering statement or the last post-qualification amendment (Rule 301(f)(2)). The forms do not ask for it, but these deadlines run from it. In an offering circular filed under Rule 302(f)(1) or (3), the later of the qualification date of the offering statement and that of a post-qualification amendment containing an offering circular; the omitted pricing information is filed within 15 business days after it (Rule 302(c)).",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/874",
            "regca-1crypto:reference/875",
            "regca-1crypto:reference/876",
            "regca-1crypto:reference/877",
            "regca-1crypto:reference/878"
          ]
        },
        {
          "@id": "regca:IssuerNameClarification",
          "rdfs:label": {
            "@value": "Information eliminating confusion about the issuer's name",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Required on the offering circular cover when the issuer's name is the same as, or confusingly similar to, that of a well-known company, or suggests a line of business it is not engaged in.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/879"
        },
        {
          "@id": "regca:AmendedItems",
          "rdfs:label": {
            "@value": "Items amended",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items a report amendment sets out. Rule 305(b) lets an amendment omit items not amended; listing the ones it contains tells a reader, and the presence rules, what to expect.",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/880",
            "regca-1crypto:reference/881"
          ]
        },
        {
          "@id": "regca:OfferingCircularPricingAbstract",
          "rdfs:label": {
            "@value": "Pricing information omitted at qualification (Rule 302(b)) [abstract]",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/882"
        },
        {
          "@id": "regca:Rule302bPricingOmissionIndicator",
          "rdfs:label": {
            "@value": "Pricing information omitted in reliance on Rule 302(b)",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the qualified offering circular omits the offering price and related information under Rule 302(b). The cover must then give a bona fide price range and the maximum number of units.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/883"
        },
        {
          "@id": "regca:SecuritiesOfferedForCashIndicator",
          "rdfs:label": {
            "@value": "Securities are offered for cash",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. A condition of Rule 302(b), stated so it can be checked.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/884"
        },
        {
          "@id": "regca:OfferingByCompetitiveBiddingIndicator",
          "rdfs:label": {
            "@value": "Securities are offered by competitive bidding",
            "@language": "en"
          },
          "skos:definition": {
