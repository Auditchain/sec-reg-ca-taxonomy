          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Topic 220, Income Statement—Reporting Comprehensive Income",
          "dct:bibliographicCitation": "Topic 220",
          "cmns-docc:hasTextualContent": "Topic title as published: \"Income Statement—Reporting Comprehensive Income (Topic 220)\" (FASB ASU 2018-02)",
          "cmns-doc:refersTo": {
