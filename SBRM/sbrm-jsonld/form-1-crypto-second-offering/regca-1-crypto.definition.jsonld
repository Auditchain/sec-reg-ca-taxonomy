          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 854
        },
        {
          "@id": "regca-1crypto:label/TotalAffiliateBlockchainNetworkParticipationCapitalExpenditures/Standard/en",
