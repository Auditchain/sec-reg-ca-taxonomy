        },
        {
          "@id": "regca-1crypto:label/AffiliateBlockchainNetworkParticipationExpenses/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateBlockchainNetworkParticipationExpenses",
