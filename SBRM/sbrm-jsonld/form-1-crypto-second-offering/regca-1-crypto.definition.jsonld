        },
        {
          "@id": "regca-1crypto:label/SignsOnBehalfOfResponsibleEntityMember/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignsOnBehalfOfResponsibleEntityMember",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "The issuer, or an entity that is a member of an issuer group; the \"(Exact name of issuer) By (Signature and Title)\" block of Forms 1-KC and 1-SC, as on Form 10-K.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 629
        },
        {
          "@id": "regca-1crypto:label/ResponsibleSignatorySignsFor/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ResponsibleSignatorySignsFor",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Signs for",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 630
        },
        {
          "@id": "regca-1crypto:label/ResponsibleSignatorySignsFor/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ResponsibleSignatorySignsFor",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Signatures for the answer on offerings in the previous 12 months, given in the manner of Forms 10-K and 10-Q (the signature blocks of Forms 1-KC and 1-SC use the same words): an entity signs through a person duly authorized to sign on its behalf; a person signs on his or her own behalf; each signer's name and title are printed, and each capacity is shown. Whether this signature is given by a responsible person for itself or on behalf of a responsible entity.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 631
        },
        {
          "@id": "regca-1crypto:label/ResponsibleEntityName/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ResponsibleEntityName",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Name of the responsible entity",
