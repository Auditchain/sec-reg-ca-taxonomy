\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_PartIIIOnly_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Doc\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Doc\" name=\"Doc\" order=\"5\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Doc_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Doc_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_BalanceSheets\" bindAsSequence=\"true\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_BalanceSheets\" name=\"BalanceSheets\" order=\"6\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_concept\">\n    <cf:concept><cf:qname>regca:Assets</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "The most recent balance sheet in an offering statement is no more than nine months old at filing (Form 1-CRYPTO Part F/S (b)(3)(i)-(iv)). A last day falling on a weekend moves to the Monday (Instruction 2 to paragraph (b)); Federal holidays are not applied. This is a necessary condition of the age rules, not all of them.",
          "sbrm-mm:sequence": 145,
          "xbrlb:sourceIndex": 144
        },
        {
          "@id": "regca-1crypto:rule/REGCA_FS_AGE_02",
