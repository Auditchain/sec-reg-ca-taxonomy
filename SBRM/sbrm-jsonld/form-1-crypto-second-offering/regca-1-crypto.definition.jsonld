          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FS_AGE_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($DocumentType) ne 'http://luca.pacioli.ai/report#Form1CRYPTOMember' or string($SubType) eq 'http://luca.pacioli.ai/report#OfferingCircularSupplementMember' or (string($PartIIIOnly) eq 'true' and string($Amend) eq 'true') or empty($Qual) or (some $dl in (max(for $a in $BalanceSheets return xs:date(xfi:period-instant(xfi:period($a)) - xs:dayTimeDuration('P1D'))) + xs:yearMonthDuration(concat('P', string($P_financialStatementAgeMonths), 'M'))) satisfies (some $w in (days-from-duration($dl - xs:date('2000-01-03')) mod 7) satisfies xs:date($Qual) le $dl + xs:dayTimeDuration(if ($w eq 5) then 'P2D' else if ($w eq 6) then 'P1D' else 'P0D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SubType\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SubType\" name=\"SubType\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SubType_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementSubmissionType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_SubType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_PartIIIOnly\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_PartIIIOnly\" name=\"PartIIIOnly\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_PartIIIOnly_concept\">\n    <cf:concept><cf:qname>regca:AmendmentRelatesSolelyToPartIIIIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_PartIIIOnly_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Qual\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Qual\" name=\"Qual\" order=\"5\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Qual_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementQualificationDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Qual\" xlink:to=\"f_Qual_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Qual_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Qual\" xlink:to=\"f_Qual_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_BalanceSheets\" bindAsSequence=\"true\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_BalanceSheets\" name=\"BalanceSheets\" order=\"6\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_concept\">\n    <cf:concept><cf:qname>regca:Assets</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_BalanceSheets_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_BalanceSheets\" xlink:to=\"f_BalanceSheets_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "The most recent balance sheet in an offering statement is no more than nine months old at qualification as well as at filing (Form 1-CRYPTO Part F/S (b)(3)(ii): an offering statement filed or qualified more than nine months after the fiscal year-end includes an interim balance sheet). Checked when the qualification date is reported; a weekend last day moves to the Monday. Without the interim statements, Rule 305(a)(2)(i)(B) would also require a special financial report on Form 1-SC.",
          "sbrm-mm:sequence": 146,
          "xbrlb:sourceIndex": 145
        },
        {
          "@id": "regca-1crypto:rule/REGCA_FS_INT_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_FS_INT_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FS_INT_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not((string($DocumentType) eq 'http://luca.pacioli.ai/report#Form1SCMember' and string($Amend) ne 'true') or exists($InterimBasis)) or string($Statement) eq 'true'\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Statement\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Statement\" name=\"Statement\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Statement_concept\">\n    <cf:concept><cf:qname>regca:InterimFinancialStatementsManagementAdjustmentsStatementIncludedIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Statement\" xlink:to=\"f_Statement_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Statement_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Statement\" xlink:to=\"f_Statement_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_InterimBasis\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_InterimBasis\" name=\"InterimBasis\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_InterimBasis_concept\">\n    <cf:concept><cf:qname>regca:InterimFinancialStatementsBasis</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_InterimBasis\" xlink:to=\"f_InterimBasis_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_InterimBasis_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_InterimBasis\" xlink:to=\"f_InterimBasis_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Interim statements come with management's statement that all adjustments necessary for them not to be misleading are included (Form 1-CRYPTO Part F/S (b)(5)(iii); Form 1-SC Item 5(b)).",
          "sbrm-mm:sequence": 147,
          "xbrlb:sourceIndex": 146
        },
        {
          "@id": "regca-1crypto:rule/REGCA_AUDIT_02",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_AUDIT_02",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_AUDIT_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($Audited) ne 'true' or (exists($Auditor) and exists($Standards) and exists($Report))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Audited\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Audited\" name=\"Audited\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Audited_concept\">\n    <cf:concept><cf:qname>regca:FinancialStatementsAuditedIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Audited\" xlink:to=\"f_Audited_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Audited_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Audited\" xlink:to=\"f_Audited_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Auditor\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Auditor\" name=\"Auditor\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Auditor_concept\">\n    <cf:concept><cf:qname>regca:AuditorName</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Auditor\" xlink:to=\"f_Auditor_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Auditor_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Auditor\" xlink:to=\"f_Auditor_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Standards\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Standards\" name=\"Standards\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Standards_concept\">\n    <cf:concept><cf:qname>regca:AuditingStandardsApplied</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Standards\" xlink:to=\"f_Standards_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Standards_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Standards\" xlink:to=\"f_Standards_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Report\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Report\" name=\"Report\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Report_concept\">\n    <cf:concept><cf:qname>regca:AuditorsReport</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Report\" xlink:to=\"f_Report_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Report_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Report\" xlink:to=\"f_Report_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Audited statements are filed with the auditor's report, which names the auditor and the auditing standards (U.S. GAAS or PCAOB) (Form 1-CRYPTO Part F/S (b)(2), (c)(1)(iii); Form 1-KC Item 12).",
          "sbrm-mm:sequence": 148,
          "xbrlb:sourceIndex": 147
        },
        {
          "@id": "regca-1crypto:rule/REGCA_RISK_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_RISK_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_RISK_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"exists($Cat) and exists($Head)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Body\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Body\" name=\"Body\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Body_concept\">\n    <cf:concept><cf:qname>regca:RiskFactorStatement</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Body\" xlink:to=\"f_Body_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Cat\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Cat\" name=\"Cat\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Cat_concept\">\n    <cf:concept><cf:qname>regca:RiskFactorCategory</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Cat\" xlink:to=\"f_Cat_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Head\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Head\" name=\"Head\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Head_concept\">\n    <cf:concept><cf:qname>regca:RiskFactorHeading</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Head\" xlink:to=\"f_Head_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Each risk factor row gives its category and its heading with the statement (Rule 103(b)(10): short, concise statements specific to the covered investment contract, the issuer, the subject crypto asset and the network or application). Added Oct. 5, 2026 with the removal of the single all-risks text block.",
          "sbrm-mm:sequence": 149,
          "xbrlb:sourceIndex": 148
        },
        {
          "@id": "regca-1crypto:rule/REGCA_NOTE_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_NOTE_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_NOTE_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"exists($Num) and exists($Title)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Text\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Text\" name=\"Text\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Text_concept\">\n    <cf:concept><cf:qname>regca:FinancialStatementNoteText</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Text\" xlink:to=\"f_Text_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Num\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Num\" name=\"Num\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Num_concept\">\n    <cf:concept><cf:qname>regca:FinancialStatementNoteNumber</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Num\" xlink:to=\"f_Num_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Title\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Title\" name=\"Title\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Title_concept\">\n    <cf:concept><cf:qname>regca:FinancialStatementNoteTitle</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Title\" xlink:to=\"f_Title_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Each note to the financial statements is a row with its number and title (Form 1-CRYPTO Part F/S; Form 1-KC Item 12; Form 1-SC Item 5). Added Oct. 5, 2026 with the removal of the single all-notes text block.",
          "sbrm-mm:sequence": 150,
          "xbrlb:sourceIndex": 149
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BDAY_02",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_BDAY_02",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BDAY_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($Para) = ('http://luca.pacioli.ai/report#Rule302f1Member', 'http://luca.pacioli.ai/report#Rule302f3Member')) or empty($Qual) or xs:date($Doc) le (for $bd0 in xs:date($Qual), $bw0 in (days-from-duration($bd0 - xs:date('2000-01-03')) mod 7), $bdf in ($bd0 - xs:dayTimeDuration(concat('P', string(max((0, $bw0 - 4))), 'D'))), $bwf in min(($bw0, 4)) return $bdf + xs:dayTimeDuration(concat('P', string($P_omittedPricingBusinessDays + 2 * (($bwf + $P_omittedPricingBusinessDays) idiv 5)), 'D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Para\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Para\" name=\"Para\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Para_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularSupplementRule302fParagraph</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Para_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Doc\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Doc\" name=\"Doc\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Doc_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Doc_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Qual\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Qual\" name=\"Qual\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Qual_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementQualificationDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Qual\" xlink:to=\"f_Qual_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Qual_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Qual\" xlink:to=\"f_Qual_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "An offering circular with pricing information omitted at qualification is filed within 15 business days after the later of the qualification of the offering statement or of a post-qualification amendment containing an offering circular; after that, the information must be in a post-qualification amendment (Rule 302(c)). Checked when the qualification date is reported. A business day is read as any day other than Saturday or Sunday; Federal holidays are not excluded (see gap 25). Uses the document date as the filing date.",
          "sbrm-mm:sequence": 151,
          "xbrlb:sourceIndex": 150
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BDAY_03",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_BDAY_03",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BDAY_03\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($Para) = ('http://luca.pacioli.ai/report#Rule302f1Member', 'http://luca.pacioli.ai/report#Rule302f3Member')) or (empty($PriceDate) and empty($FirstUse)) or xs:date($Doc) le (for $bd0 in xs:date(min((for $x in ($PriceDate, $FirstUse) return xs:date($x)))), $bw0 in (days-from-duration($bd0 - xs:date('2000-01-03')) mod 7), $bdf in ($bd0 - xs:dayTimeDuration(concat('P', string(max((0, $bw0 - 4))), 'D'))), $bwf in min(($bw0, 4)) return $bdf + xs:dayTimeDuration(concat('P', string($P_pricingSupplementBusinessDays + 2 * (($bwf + $P_pricingSupplementBusinessDays) idiv 5)), 'D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Para\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Para\" name=\"Para\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Para_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularSupplementRule302fParagraph</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Para_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Doc\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Doc\" name=\"Doc\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Doc_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Doc_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_PriceDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_PriceDate\" name=\"PriceDate\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_PriceDate_concept\">\n    <cf:concept><cf:qname>regca:OfferingPriceDeterminationDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PriceDate\" xlink:to=\"f_PriceDate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_PriceDate_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PriceDate\" xlink:to=\"f_PriceDate_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_FirstUse\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_FirstUse\" name=\"FirstUse\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_FirstUse_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularFirstUseDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_FirstUse\" xlink:to=\"f_FirstUse_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_FirstUse_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_FirstUse\" xlink:to=\"f_FirstUse_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "An offering circular filed under Rule 302(f)(1) or (3) is filed within two business days after the earlier of the date the offering price was determined and the date it was first used after qualification (Rule 302(f)(1), (3)). Checked when either date is reported. A business day is read as any day other than Saturday or Sunday; Federal holidays are not excluded (see gap 25). Uses the document date as the filing date.",
          "sbrm-mm:sequence": 152,
          "xbrlb:sourceIndex": 151
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BDAY_04",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_BDAY_04",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BDAY_04\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($Para) ne 'http://luca.pacioli.ai/report#Rule302f2Member' or empty($FirstUse) or xs:date($Doc) le (for $bd0 in xs:date($FirstUse), $bw0 in (days-from-duration($bd0 - xs:date('2000-01-03')) mod 7), $bdf in ($bd0 - xs:dayTimeDuration(concat('P', string(max((0, $bw0 - 4))), 'D'))), $bwf in min(($bw0, 4)) return $bdf + xs:dayTimeDuration(concat('P', string($P_changeSupplementBusinessDays + 2 * (($bwf + $P_changeSupplementBusinessDays) idiv 5)), 'D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Para\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Para\" name=\"Para\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Para_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularSupplementRule302fParagraph</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Para_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Para\" xlink:to=\"f_Para_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Doc\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Doc\" name=\"Doc\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Doc_concept\">\n    <cf:concept><cf:qname>regca:DocumentDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Doc_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Doc\" xlink:to=\"f_Doc_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_FirstUse\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_FirstUse\" name=\"FirstUse\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_FirstUse_concept\">\n    <cf:concept><cf:qname>regca:OfferingCircularFirstUseDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_FirstUse\" xlink:to=\"f_FirstUse_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_FirstUse_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_FirstUse\" xlink:to=\"f_FirstUse_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "An offering circular reflecting a substantive change or addition is filed within five business days after it is first used after qualification (Rule 302(f)(2)). Checked when the first-use date is reported. A business day is read as any day other than Saturday or Sunday; Federal holidays are not excluded (see gap 25). Uses the document date as the filing date.",
          "sbrm-mm:sequence": 153,
          "xbrlb:sourceIndex": 152
        },
        {
          "@id": "regca-1crypto:rule/REGCA_FX_02",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_FX_02",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FX_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"abs($Amt * $Rate - $USD) le $P_monetaryTolerance and exists($Ccy) and upper-case(normalize-space(string($Ccy))) ne 'USD' and (some $m in xfi:unit-numerator(xfi:unit($Amt)) satisfies local-name-from-QName($m) eq upper-case(normalize-space(string($Ccy)))) and exists($RateDate) and (empty($SaleDate) or xs:date($RateDate) le xs:date($SaleDate))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amt\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amt\" name=\"Amt\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amt_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyAmountReceived</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amt\" xlink:to=\"f_Amt_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Amt_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amt\" xlink:to=\"f_Amt_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Rate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Rate\" name=\"Rate\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Rate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyExchangeRate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Rate\" xlink:to=\"f_Rate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Rate_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Rate\" xlink:to=\"f_Rate_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_USD\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_USD\" name=\"USD\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_USD_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyAmountInUSD</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_USD_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Ccy\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Ccy\" name=\"Ccy\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Ccy_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyCode</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Ccy\" xlink:to=\"f_Ccy_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_RateDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_RateDate\" name=\"RateDate\" order=\"5\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_RateDate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyExchangeRateDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_RateDate\" xlink:to=\"f_RateDate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SaleDate\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SaleDate\" name=\"SaleDate\" order=\"6\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SaleDate_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencySaleDate</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SaleDate\" xlink:to=\"f_SaleDate_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Proposed (Form 1-CRYPTO foreign currency table): an amount received in a foreign currency gives its ISO 4217 code (matching the unit of the amount, not USD), the exchange rate and its date; the amount times the rate equals the U.S. dollar value within $1; and the rate is dated on or before the sale (Rule 100, aggregate offering price and aggregate sales). Whether an earlier rate is \"a reasonable time before\" the sale is not checked.",
          "sbrm-mm:sequence": 154,
          "xbrlb:sourceIndex": 153
        },
        {
          "@id": "regca-1crypto:rule/REGCA_FX_03",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_FX_03",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FX_03\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"count($USD) eq 0 or sum($USD) le $Total\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Total\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Total\" name=\"Total\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Total_concept\">\n    <cf:concept><cf:qname>regca:AggregateOfferingPriceAndAggregateSalesTotal</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Total\" xlink:to=\"f_Total_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Total_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Total\" xlink:to=\"f_Total_unit\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_USD\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_USD\" name=\"USD\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_USD_concept\">\n    <cf:concept><cf:qname>regca:ForeignCurrencyAmountInUSD</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_USD_typed1\">\n    <df:dimension><df:qname>regca:ForeignCurrencyReceiptIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_typed1\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_USD_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_USD\" xlink:to=\"f_USD_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Proposed: the translated foreign-currency amounts do not exceed the total of the aggregate offering price and aggregate sales they form part of (Form 1-CRYPTO Part I Item 2; Rule 100).",
          "sbrm-mm:sequence": 155,
          "xbrlb:sourceIndex": 154
        },
        {
          "@id": "regca-1crypto:rule/REGCA_PRIOR_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_PRIOR_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
