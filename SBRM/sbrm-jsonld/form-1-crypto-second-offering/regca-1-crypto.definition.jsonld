        {
          "@id": "regca-1crypto:label/Revenues/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Revenues",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Revenue from contracts with customers. For an issuer of units of covered investment contracts, the promised goods and services are identified from the contract and from the promises implied by the issuer's Rule 103 disclosure, combined into a single performance obligation where they are not distinct, and revenue is recognized when that obligation is satisfied - for a network unit, when the unit is delivered and the network it participates in is operating.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 404
        },
        {
          "@id": "regca-1crypto:label/CostOfRevenue/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CostOfRevenue",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Cost of revenue",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 405
        },
        {
          "@id": "regca-1crypto:label/CostOfRevenue/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CostOfRevenue",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Includes the incremental costs of obtaining the contracts whose revenue is recognized in the period (for example, placement-agent compensation on units of covered investment contracts sold), expensed when the related revenue is recognized.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 406
        },
