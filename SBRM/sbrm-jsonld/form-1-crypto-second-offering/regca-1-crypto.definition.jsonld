          "rdf:value": {
            "@value": "Total affiliate blockchain network participation capital expenditures",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 855
        },
        {
          "@id": "regca-1crypto:label/TotalAffiliateBlockchainNetworkParticipationCapitalExpenditures/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationCapitalExpenditures",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 856
        },
        {
          "@id": "regca-1crypto:label/TotalAffiliateBlockchainNetworkParticipationExpenses/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Total affiliate blockchain network participation expenses",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 857
        },
        {
          "@id": "regca-1crypto:label/TotalAffiliateBlockchainNetworkParticipationExpenses/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:TotalAffiliateBlockchainNetworkParticipationExpenses",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Blockchain network participation operating expenses of all affiliates combined, across all networks.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 858
        },
        {
          "@id": "regca-1crypto:label/NumberOfAffiliatesEngagedInBlockchainNetworkParticipation/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NumberOfAffiliatesEngagedInBlockchainNetworkParticipation",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Number of affiliates engaged in blockchain network participation",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 859
        },
        {
          "@id": "regca-1crypto:label/NumberOfAffiliatesEngagedInBlockchainNetworkParticipation/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NumberOfAffiliatesEngagedInBlockchainNetworkParticipation",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of the issuer's affiliates that are engaged in blockchain network participation as of the reporting instant. Reported dimensionlessly; the enumerated perimeter rows on the affiliate axis must number exactly this many. A filer with no participating affiliates reports zero.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 860
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterCompletenessAttestationIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "The enumerated affiliate perimeter is complete",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 861
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterCompletenessAttestationIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Affirmative statement that the enumerated list of affiliates engaged in blockchain network participation includes every affiliate so engaged, applying the control-based affiliate definition and not a narrower one chosen by the filer. This is the element that converts an omission from a silent arithmetic gap into an affirmative misstatement on the face of the filing.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 862
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerName/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerName",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer name",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 863
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerName/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerName",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Full legal name of the executive officer who certifies that the enumerated affiliate perimeter is complete. This is the element that converts regca:AffiliatePerimeterCompletenessAttestationIndicator from an unattributed checkbox into a named person's representation.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 864
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerTitle/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer title",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 865
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerTitle/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerTitle",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Title of the officer attesting to the affiliate perimeter, as the issuer itself styles the position. Reported in addition to regca:AffiliatePerimeterAttestingOfficerRole, which normalises the officer into standard role categories; this element preserves the issuer's own title for the person.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 866
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerRole/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerRole",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer role",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 867
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerRole/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerRole",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Role category of the officer attesting to the affiliate perimeter. The residual member regca:FunctionalEquivalentExecutiveOfficerMember covers a signer who holds none of the listed titles but serves in the functional capacity of one; a signer who serves in no such capacity has no member to select.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 868
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerIdentifier/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerIdentifier",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attesting officer identifier",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 869
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestingOfficerIdentifier/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestingOfficerIdentifier",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Stable issuer-assigned identifier for the certifying officer, carried across filings so the same person is recognisable when a middle initial, a suffix or a nickname changes the reported name. Deliberately NOT a Legal Entity Identifier: an LEI under ISO 17442 identifies a legal entity, and the only LEIs on this schedule belong to the issuer and to the enumerated affiliates - regca:AffiliateLegalEntityIdentifier. Demanding one for a natural person would be a category error and would invite a false value.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 870
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestationDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestationDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate perimeter attestation date",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 871
        },
        {
          "@id": "regca-1crypto:label/AffiliatePerimeterAttestationDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliatePerimeterAttestationDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Date on which the certifying officer signed the affiliate-perimeter completeness certification. Must fall on or after the reporting date and on or before the filing date.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 872
        },
        {
          "@id": "regca-1crypto:label/AffiliateCanInfluenceTransactionOrderingIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanInfluenceTransactionOrderingIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate can influence transaction ordering indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 873
        },
        {
          "@id": "regca-1crypto:label/AffiliateCanInfluenceTransactionOrderingIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanInfluenceTransactionOrderingIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 874
        },
        {
          "@id": "regca-1crypto:label/AffiliateCanObserveTransactionsBeforeConfirmationIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanObserveTransactionsBeforeConfirmationIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Affiliate can observe transactions before public confirmation indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 875
        },
        {
          "@id": "regca-1crypto:label/AffiliateCanObserveTransactionsBeforeConfirmationIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AffiliateCanObserveTransactionsBeforeConfirmationIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 876
        },
        {
          "@id": "regca-1crypto:label/CombinedEntitiesCouldInfluenceConsensusIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedEntitiesCouldInfluenceConsensusIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined entities could influence consensus indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 877
        },
        {
          "@id": "regca-1crypto:label/CombinedEntitiesCouldInfluenceConsensusIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedEntitiesCouldInfluenceConsensusIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 878
        },
        {
          "@id": "regca-1crypto:label/CombinedStakeSharePercentageOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedStakeSharePercentageOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined stake share of the issuer and its affiliates on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 879
        },
        {
          "@id": "regca-1crypto:label/CombinedStakeSharePercentageOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedStakeSharePercentageOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The proportion of a blockchain network's total active stake controlled, on that network, by the issuer together with every affiliate reported on that network. Stored as a fraction, so 0.34 is thirty-four per cent.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 880
        },
        {
          "@id": "regca-1crypto:label/CombinedHashPowerSharePercentageOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedHashPowerSharePercentageOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined hash power share of the issuer and its affiliates on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 881
        },
        {
          "@id": "regca-1crypto:label/CombinedHashPowerSharePercentageOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedHashPowerSharePercentageOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The proportion of a blockchain network's total hash rate contributed, on that network, by the issuer together with every affiliate reported on that network. Stored as a fraction.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 882
        },
        {
          "@id": "regca-1crypto:label/CombinedValidatorSlotsControlledOnNetwork/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedValidatorSlotsControlledOnNetwork",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Combined validator slots controlled on the network",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 883
        },
        {
          "@id": "regca-1crypto:label/CombinedValidatorSlotsControlledOnNetwork/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:CombinedValidatorSlotsControlledOnNetwork",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The number of validator slots on a blockchain network controlled by the issuer together with every affiliate reported on that network.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 884
        },
        {
          "@id": "regca-1crypto:label/IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Issuer could fulfill obligations if network disrupted indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 885
        },
        {
          "@id": "regca-1crypto:label/IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerCouldFulfillObligationsIfNetworkDisruptedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Whether the issuer could continue to meet its obligations under the covered investment contract if a network on which it participates were disrupted.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 886
        },
        {
          "@id": "regca-1crypto:label/NetworkCongestionAffectsBothOperationsIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkCongestionAffectsBothOperationsIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Network congestion affects both operations and obligations indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 887
        },
        {
          "@id": "regca-1crypto:label/NetworkCongestionAffectsBothOperationsIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:NetworkCongestionAffectsBothOperationsIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Whether congestion on a network would affect both the issuer's network participation and its obligations under the covered investment contract.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 888
        },
        {
          "@id": "regca-1crypto:label/SinglePointsOfFailureIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SinglePointsOfFailureIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Single points of failure affecting both network and operations indicator",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 889
