          "dct:bibliographicCitation": "17 CFR 228.103(b)(4)(ii); 91 FR 54608",
          "cmns-docc:hasTextualContent": "Verbatim: \"The material aspects of any conflicts of interest or related person transactions involving the issuer\"",
