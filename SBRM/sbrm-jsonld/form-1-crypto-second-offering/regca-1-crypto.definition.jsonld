        },
        {
          "@id": "regca-1crypto:label/ThirdPartyConflictMitigationMeasuresExplanatory/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:ThirdPartyConflictMitigationMeasuresExplanatory",
