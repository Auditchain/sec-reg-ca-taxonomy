          "xbrlb:referenceOf": "regca:DataSourceForNetworkShareEstimate",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/supreme-court-of-the-united-states",
          "dct:title": "TSC Industries, Inc. v. Northway, Inc., 426 U.S. 438 (1976)",
          "dct:bibliographicCitation": "426 U.S. at 449",
          "cmns-docc:hasTextualContent": "Verbatim: \"there must be a substantial likelihood that the disclosure of the omitted fact would have been viewed by the reasonable investor as having significantly altered the \"total mix\" of information made available.\" Relied on for BNP disclosure in Auditchain's FDIC comments (RIN 3064-AG19, May 14, 2026; RIN 3064-AG20 supplemental, Mar. 9, 2026).",
          "cmns-doc:refersTo": {
