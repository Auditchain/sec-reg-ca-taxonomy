          },
          "dct:source": "regca-1crypto:reference/894"
        },
        {
          "@id": "regca:OfferingCircularSupplementRule302fParagraph",
          "rdfs:label": {
            "@value": "Rule 302(f) paragraph under which the offering circular is filed",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Shown in the upper right corner of the cover page with the offering statement file number.",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/895",
            "regca-1crypto:reference/896"
          ]
        },
        {
          "@id": "regca:OfferingCircularSupplementOnlyIndicator",
          "rdfs:label": {
            "@value": "Filing consists only of an offering circular supplement",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "True if only the supplement is filed, attached to an offering circular filed earlier. Its cover must then identify the dates of the related offering circular and supplements.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/897"
        },
        {
          "@id": "regca:RelatedOfferingCircularDate",
          "rdfs:label": {
            "@value": "Date of the related offering circular",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/898"
        },
        {
