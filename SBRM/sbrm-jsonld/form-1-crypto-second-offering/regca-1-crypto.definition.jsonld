          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "Regulation Crypto Assets (proposed), Release Nos. 33-11434; 34-106150, File No. S7-2026-27, 91 FR 54510 (Aug. 21, 2026)",
          "dct:bibliographicCitation": "17 CFR 228.103(b)(10); 91 FR 54608",
          "cmns-docc:hasTextualContent": "Verbatim: \"This description must avoid generalized statements and include only factors specific to the covered investment contract, the issuer, the subject crypto asset, and the associated crypto network or associated crypto application\"",
