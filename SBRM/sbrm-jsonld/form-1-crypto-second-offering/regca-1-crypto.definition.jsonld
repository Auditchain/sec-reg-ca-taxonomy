        {
          "@id": "regca:AffiliateBlockchainNetworkParticipationForPeriodByNetworkLineItems",
          "rdfs:label": {
            "@value": "Affiliate blockchain network participation for the period by network [line items]",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/2074",
            "regca-1crypto:reference/2075",
            "regca-1crypto:reference/2076",
