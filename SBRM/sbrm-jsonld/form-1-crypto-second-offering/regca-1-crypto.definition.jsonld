            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_OFFER_04\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"count($Pcts) eq 0 or abs(sum($Pcts) - $Total) le $P_shareRoundingTolerance\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Total\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Total\" name=\"Total\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Total_concept\">\n    <cf:concept><cf:qname>regca:UseOfProceedsPercentageOfEstimatedNetProceedsTotal</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Total\" xlink:to=\"f_Total_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Pcts\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Pcts\" name=\"Pcts\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Pcts_concept\">\n    <cf:concept><cf:qname>regca:UseOfProceedsPercentageOfEstimatedNetProceeds</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Pcts\" xlink:to=\"f_Pcts_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Pcts_typed1\">\n    <df:dimension><df:qname>regca:UseOfProceedsIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Pcts\" xlink:to=\"f_Pcts_typed1\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
