          ]
        },
        {
          "@id": "regca:AffiliatePerimeterCompletenessAttestationIndicator",
          "rdfs:label": {
            "@value": "The enumerated affiliate perimeter is complete",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Affirmative statement that the enumerated list of affiliates engaged in blockchain network participation includes every affiliate so engaged, applying the control-based affiliate definition and not a narrower one chosen by the filer. This is the element that converts an omission from a silent arithmetic gap into an affirmative misstatement on the face of the filing.",
            "@language": "en"
          },
          "dct:source": [
            "regca-1crypto:reference/1825",
            "regca-1crypto:reference/1826",
            "regca-1crypto:reference/1827",
            "regca-1crypto:reference/1828"
          ]
        },
        {
