              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Form 1-CRYPTO requires regca:ExemptionRelied (Exemption relied on). It cannot be omitted. Proposed by Auditchain Labs; not required by the proposed rule.",
          "sbrm-mm:sequence": 2,
          "xbrlb:sourceIndex": 1
        },
