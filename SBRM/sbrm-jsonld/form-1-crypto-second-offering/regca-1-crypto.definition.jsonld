            "@value": "Capacity in which signed",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 466
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacity/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacity",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "One capacity in which the signatory signs. A signatory who signs in more than one capacity has one row for each capacity in the capacity table, under the same signatory identifier.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 467
        },
        {
          "@id": "regca-1crypto:label/SignsOnBehalfOf/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignsOnBehalfOf",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Signs on behalf of",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 468
        },
        {
          "@id": "regca-1crypto:label/SignsOnBehalfOf/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignsOnBehalfOf",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "The name of the entity (the issuer, or for a group issuer the group member) or natural person identified by the entity axis of this row, for which the signatory signs.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 469
        },
        {
          "@id": "regca-1crypto:label/SignatureAuthenticationDocumentRetainedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatureAuthenticationDocumentRetainedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Signature authentication document executed and retained",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 470
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacityTable/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacityTable",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Capacity of signatory [table]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 471
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacityIdentifierTypedAxis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacityIdentifierTypedAxis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Capacity identifier [typed axis]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 472
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacityIdentifierTypedAxis/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacityIdentifierTypedAxis",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "One value per capacity in which the signatory identified by the signatory axis signs (1, 2, ...). A person who holds more than one of the positions that must sign signs once and states each capacity in a row of its own.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 473
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacityLineItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacityLineItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Capacity of signatory [line items]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 474
        },
        {
          "@id": "regca-1crypto:label/SignatoryCapacitiesAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SignatoryCapacitiesAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Capacities of the signatories [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 475
        },
        {
          "@id": "regca-1crypto:label/AmendmentExplanatoryNote/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentExplanatoryNote",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Explanatory note to amendment",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 476
        },
        {
          "@id": "regca-1crypto:label/AmendmentExplanatoryNote/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentExplanatoryNote",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "An amendment that relates solely to Part III of Form 1-CRYPTO may be limited to Part I, an explanatory note and Part III.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 477
        },
        {
          "@id": "regca-1crypto:label/AmendmentRelatesSolelyToPartIIIIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentRelatesSolelyToPartIIIIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Amendment relates solely to Part III (exhibits)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 478
        },
        {
          "@id": "regca-1crypto:label/AmendmentRelatesSolelyToPartIIIIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendmentRelatesSolelyToPartIIIIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if this Form 1-CRYPTO amendment relates solely to Part III. Part II and the financial statements are then not required.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 479
        },
        {
          "@id": "regca-1crypto:label/AmendedAuditedFinancialStatementsIncludedIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Amendment includes amended audited financial statements",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 480
        },
        {
          "@id": "regca-1crypto:label/AmendedAuditedFinancialStatementsIncludedIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedAuditedFinancialStatementsIncludedIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "If true, the amendment must include the consent of the certifying accountant (filed as an exhibit).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 481
        },
        {
          "@id": "regca-1crypto:label/PostQualificationAmendmentBasisDomain/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationAmendmentBasisDomain",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Basis for post-qualification amendment [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 482
        },
        {
          "@id": "regca-1crypto:label/PostQualificationAnnualUpdateMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationAnnualUpdateMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Update at least every 12 months with current financial statements (Rule 301(f)(2)(i)) [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 483
        },
        {
          "@id": "regca-1crypto:label/PostQualificationFundamentalChangeMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationFundamentalChangeMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Facts or events representing a fundamental change (Rule 301(f)(2)(ii)) [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 484
        },
        {
          "@id": "regca-1crypto:label/PostQualificationOtherMember/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationOtherMember",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Other, for example omitted pricing information or additional securities (Rule 302(b)-(c)) [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 485
        },
        {
          "@id": "regca-1crypto:label/PostQualificationAmendmentBasis/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationAmendmentBasis",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Basis for post-qualification amendment",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 486
        },
        {
          "@id": "regca-1crypto:label/PostQualificationAmendmentBasis/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:PostQualificationAmendmentBasis",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Why a post-qualification amendment is filed. Rule 301(f)(2) says when one must be filed; saying which reason applies lets the 12-month deadline be checked.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 487
        },
        {
          "@id": "regca-1crypto:label/OfferingStatementQualificationDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingStatementQualificationDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Qualification date of the offering statement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 488
        },
        {
          "@id": "regca-1crypto:label/OfferingStatementQualificationDate/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingStatementQualificationDate",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. In a special financial report, the date the Commission qualified the offering statement (Rule 305(a)(2)(ii)). In a post-qualification amendment, the most recent qualification date: the offering statement or the last post-qualification amendment (Rule 301(f)(2)). The forms do not ask for it, but these deadlines run from it. In an offering circular filed under Rule 302(f)(1) or (3), the later of the qualification date of the offering statement and that of a post-qualification amendment containing an offering circular; the omitted pricing information is filed within 15 business days after it (Rule 302(c)).",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 489
        },
        {
          "@id": "regca-1crypto:label/IssuerNameClarification/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerNameClarification",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Information eliminating confusion about the issuer's name",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 490
        },
        {
          "@id": "regca-1crypto:label/IssuerNameClarification/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:IssuerNameClarification",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Required on the offering circular cover when the issuer's name is the same as, or confusingly similar to, that of a well-known company, or suggests a line of business it is not engaged in.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 491
        },
        {
          "@id": "regca-1crypto:label/AmendedItems/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedItems",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Items amended",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 492
        },
        {
          "@id": "regca-1crypto:label/AmendedItems/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:AmendedItems",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. The items a report amendment sets out. Rule 305(b) lets an amendment omit items not amended; listing the ones it contains tells a reader, and the presence rules, what to expect.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 493
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularPricingAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularPricingAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Pricing information omitted at qualification (Rule 302(b)) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 494
        },
        {
          "@id": "regca-1crypto:label/Rule302bPricingOmissionIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302bPricingOmissionIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Pricing information omitted in reliance on Rule 302(b)",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 495
        },
        {
          "@id": "regca-1crypto:label/Rule302bPricingOmissionIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302bPricingOmissionIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. True if the qualified offering circular omits the offering price and related information under Rule 302(b). The cover must then give a bona fide price range and the maximum number of units.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 496
        },
        {
          "@id": "regca-1crypto:label/SecuritiesOfferedForCashIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SecuritiesOfferedForCashIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Securities are offered for cash",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 497
        },
        {
          "@id": "regca-1crypto:label/SecuritiesOfferedForCashIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:SecuritiesOfferedForCashIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. A condition of Rule 302(b), stated so it can be checked.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 498
        },
        {
          "@id": "regca-1crypto:label/OfferingByCompetitiveBiddingIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingByCompetitiveBiddingIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Securities are offered by competitive bidding",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 499
        },
        {
          "@id": "regca-1crypto:label/OfferingByCompetitiveBiddingIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingByCompetitiveBiddingIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. A condition of Rule 302(b), stated so it can be checked.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 500
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularSupplementAbstract/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularSupplementAbstract",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Offering circular supplement (Rule 302(f)) [abstract]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 501
        },
        {
          "@id": "regca-1crypto:label/Rule302fParagraphDomain/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302fParagraphDomain",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f) paragraph [domain]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 502
        },
        {
          "@id": "regca-1crypto:label/Rule302f1Member/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302f1Member",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f)(1) — previously omitted pricing information [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 503
        },
        {
          "@id": "regca-1crypto:label/Rule302f2Member/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302f2Member",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f)(2) — substantive change or addition [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 504
        },
        {
          "@id": "regca-1crypto:label/Rule302f3Member/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302f3Member",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f)(3) — both [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 505
        },
        {
          "@id": "regca-1crypto:label/Rule302f4Member/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:Rule302f4Member",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f)(4) — filed late [member]",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 506
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularSupplementRule302fParagraph/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularSupplementRule302fParagraph",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Rule 302(f) paragraph under which the offering circular is filed",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 507
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularSupplementRule302fParagraph/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularSupplementRule302fParagraph",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Shown in the upper right corner of the cover page with the offering statement file number.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 508
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularSupplementOnlyIndicator/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularSupplementOnlyIndicator",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Filing consists only of an offering circular supplement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 509
        },
        {
          "@id": "regca-1crypto:label/OfferingCircularSupplementOnlyIndicator/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:OfferingCircularSupplementOnlyIndicator",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "True if only the supplement is filed, attached to an offering circular filed earlier. Its cover must then identify the dates of the related offering circular and supplements.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 510
        },
        {
          "@id": "regca-1crypto:label/RelatedOfferingCircularDate/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:RelatedOfferingCircularDate",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Date of the related offering circular",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 511
        },
        {
          "@id": "regca-1crypto:label/RelatedOfferingCircularSupplementDates/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:RelatedOfferingCircularSupplementDates",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Dates of the related offering circular supplements",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 512
        },
        {
          "@id": "regca-1crypto:label/RelatedOfferingCircularSupplementDates/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:RelatedOfferingCircularSupplementDates",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "Dates of each earlier supplement that, with the related offering circular, forms the offering circular now in use.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 513
        },
        {
          "@id": "regca-1crypto:label/QualifiedMaximumAggregateOfferingPrice/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:QualifiedMaximumAggregateOfferingPrice",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Maximum aggregate offering price calculable from the qualified offering statement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 514
        },
        {
          "@id": "regca-1crypto:label/QualifiedMaximumAggregateOfferingPrice/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:QualifiedMaximumAggregateOfferingPrice",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "The base for the 20 percent limit on changes in volume and price that a Rule 302(f)(1) or (3) supplement may reflect.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 515
        },
        {
          "@id": "regca-1crypto:label/QualifiedMaximumUnitsToBeOffered/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:QualifiedMaximumUnitsToBeOffered",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Maximum number of units in the qualified offering statement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 516
        },
        {
          "@id": "regca-1crypto:label/QualifiedMaximumUnitsToBeOffered/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:QualifiedMaximumUnitsToBeOffered",
          "xbrlb:labelRole": "Documentation",
          "rdf:value": {
            "@value": "A supplement may not increase the volume of securities offered.",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 517
        },
        {
          "@id": "regca-1crypto:label/UnsoldSecuritiesFromPriorOfferingStatementIncluded/Standard/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UnsoldSecuritiesFromPriorOfferingStatementIncluded",
          "xbrlb:labelRole": "Standard",
          "rdf:value": {
            "@value": "Unsold securities from the earlier offering statement included in this offering statement",
            "@language": "en"
          },
          "xbrlb:sourceIndex": 518
        },
        {
          "@id": "regca-1crypto:label/UnsoldSecuritiesFromPriorOfferingStatementIncluded/Documentation/en",
          "@type": "xbrlb:Label",
          "xbrlb:labelOf": "regca:UnsoldSecuritiesFromPriorOfferingStatementIncluded",
