          "dct:identifier": "REGCA_BNP_R1_NODES_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_BNP_R1_NODES_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"(if (string($IssuerOperatesBlockchainInfrastructureIndicator) eq 'true') then (exists($NumberOfNodesOrValidatorsOperated) and $NumberOfNodesOrValidatorsOperated ge 1) else (if (string($IssuerOperatesBlockchainInfrastructureIndicator) eq 'false') then (not(exists($NumberOfNodesOrValidatorsOperated)) or $NumberOfNodesOrValidatorsOperated eq 0) else true())) and (not(exists($NumberOfNodesOrValidatorsOperated)) or $NumberOfNodesOrValidatorsOperated ge 0) and (not(exists($NumberOfValidatorSlotsControlled)) or not($NumberOfValidatorSlotsControlled gt 0) or (exists($NumberOfNodesOrValidatorsOperated) and $NumberOfNodesOrValidatorsOperated ge 1))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_IssuerOperatesBlockchainInfrastructureIndicator\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_IssuerOperatesBlockchainInfrastructureIndicator\" name=\"IssuerOperatesBlockchainInfrastructureIndicator\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_IssuerOperatesBlockchainInfrastructureIndicator_concept\">\n    <cf:concept><cf:qname>regca:IssuerOperatesBlockchainInfrastructureIndicato