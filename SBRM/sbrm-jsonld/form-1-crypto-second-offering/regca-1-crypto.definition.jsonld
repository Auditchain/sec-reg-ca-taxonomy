          "sbrm-mm:sequence": 1197,
          "xbrlb:sourceIndex": 1196
        },
        {
          "@id": "regca-1crypto:reference/1198",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:AffiliateIdentifierTypedAxis",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/securities-and-exchange-commission",
          "dct:title": "17 CFR 230.405 (Securities Act Rule 405), incorporated by 17 CFR 228.100",
          "dct:bibliographicCitation": "17 CFR 230.405 (control)",
          "cmns-docc:hasTextualContent": "Verbatim: \"the possession, direct or indirect, of the power to direct or cause the direction of the management and policies of a person, whether through the ownership of voting securities, by contract, or otherwise\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.ecfr.gov/current/title-17/chapter-II/part-230/subject-group-ECFR6e651a4c86c0174/section-230.405"
