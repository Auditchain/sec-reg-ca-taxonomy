          },
          "sbrm-mm:sequence": 639,
          "xbrlb:sourceIndex": 638
        },
        {
          "@id": "regca-1crypto:reference/640",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606): Identifying Performance Obligations and Licensing (as amended by ASU 2016-10)",
          "dct:bibliographicCitation": "ASC 606-10-25-16",
          "cmns-docc:hasTextualContent": "Topic title as published: \"a contract with a customer also may include promises that are implied by an entity's customary business practices, published policies, or specific statements\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 640,
          "xbrlb:sourceIndex": 639
        },
        {
          "@id": "regca-1crypto:reference/641",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 606-10-25-17",
          "cmns-docc:hasTextualContent": "Topic title as published: \"Performance obligations do not include activities that an entity must undertake to fulfill a contract unless those activities transfer a good or service to a customer.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 641,
          "xbrlb:sourceIndex": 640
        },
        {
          "@id": "regca-1crypto:reference/642",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606): Identifying Performance Obligations and Licensing (as amended by ASU 2016-10)",
          "dct:bibliographicCitation": "ASC 606-10-25-19",
          "cmns-docc:hasTextualContent": "Topic title as published: \"A good or service that is promised to a customer is distinct if both of the following criteria are met\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 642,
          "xbrlb:sourceIndex": 641
        },
        {
          "@id": "regca-1crypto:reference/643",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606): Identifying Performance Obligations and Licensing (as amended by ASU 2016-10)",
          "dct:bibliographicCitation": "ASC 606-10-25-21",
          "cmns-docc:hasTextualContent": "Topic title as published: \"the objective is to determine whether the nature of the promise, within the context of the contract, is to transfer each of those goods or services individually or, instead, to transfer a combined item or items to which the promised goods or services are inputs\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 643,
          "xbrlb:sourceIndex": 642
        },
        {
          "@id": "regca-1crypto:reference/644",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606): Identifying Performance Obligations and Licensing (as amended by ASU 2016-10)",
          "dct:bibliographicCitation": "ASC 606-10-25-22",
          "cmns-docc:hasTextualContent": "Topic title as published: \"If a promised good or service is not distinct, an entity shall combine that good or service with other promised goods or services until it identifies a bundle of goods or services that is distinct.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 644,
          "xbrlb:sourceIndex": 643
        },
        {
          "@id": "regca-1crypto:reference/645",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 606-10-25-23",
          "cmns-docc:hasTextualContent": "Topic title as published: \"An entity shall recognize revenue when (or as) the entity satisfies a performance obligation by transferring a promised good or service (that is, an asset) to a customer. An asset is transferred when (or as) the customer obtains control of that asset.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 645,
          "xbrlb:sourceIndex": 644
        },
        {
          "@id": "regca-1crypto:reference/646",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 606-10-25-30",
          "cmns-docc:hasTextualContent": "Topic title as published: \"If a performance obligation is not satisfied over time in accordance with paragraphs 606-10-25-27 through 25-29, an entity satisfies the performance obligation at a point in time.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 646,
          "xbrlb:sourceIndex": 645
        },
        {
          "@id": "regca-1crypto:reference/647",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606) (as created by ASU 2014-09, Section A)",
          "dct:bibliographicCitation": "ASC 606-10-32-2",
          "cmns-docc:hasTextualContent": "Topic title as published: \"The transaction price is the amount of consideration to which an entity expects to be entitled in exchange for transferring promised goods or services to a customer, excluding amounts collected on behalf of third parties\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202014-09_Section%20A.pdf"
          },
          "dct:date": {
            "@value": "2014-05-28",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 647,
          "xbrlb:sourceIndex": 646
        },
        {
          "@id": "regca-1crypto:reference/648",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:Revenues",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/financial-accounting-standards-board",
          "dct:title": "FASB Accounting Standards Codification, Revenue from Contracts with Customers (Topic 606): Identifying Performance Obligations and Licensing (as amended by ASU 2016-10)",
          "dct:bibliographicCitation": "ASC 606-10-55-58B",
          "cmns-docc:hasTextualContent": "Topic title as published: \"An entity's promise to provide a customer with the right to use its intellectual property is satisfied at a point in time.\" ()",
          "cmns-doc:refersTo": {
            "@id": "https://storage.fasb.org/ASU%202016-10.pdf"
          },
          "dct:date": {
            "@value": "2016-04-14",
