          "dct:bibliographicCitation": "PDF p. 11",
          "cmns-docc:hasTextualContent": "Verbatim: \"Extends network participation mapping to affiliate perimeter: affiliate identification and participation details, services provided, and conflicts of interest analysis.\"",
          "cmns-doc:refersTo": {
