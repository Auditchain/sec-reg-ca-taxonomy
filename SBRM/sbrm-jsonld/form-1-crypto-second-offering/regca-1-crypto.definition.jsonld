          "cmns-av:explanatoryNote": "If an incorporated document was substantively modified after it was filed, the text and date of the modification are filed with the reference (Form 1-CRYPTO General Instruction III(d)).",
          "sbrm-mm:sequence": 140,
          "xbrlb:sourceIndex": 139
        },
        {
          "@id": "regca-1crypto:rule/REGCA_EXH_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_EXH_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_EXH_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($Incorporated) ne 'true' or exists($Link)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Incorporated\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Incorporated\" name=\"Incorporated\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Incorporated_concept\">\n    <cf:concept><cf:qname>regca:ExhibitIncorporatedByReferenceIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Incorporated\" xlink:to=\"f_Incorporated_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Link\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Link\" name=\"Link\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Link_concept\">\n    <cf:concept><cf:qname>regca:ExhibitAddress</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Link\" xlink:to=\"f_Link_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "An exhibit incorporated by reference has a hyperlink to the document on EDGAR (Form 1-CRYPTO General Instruction III(b)).",
          "sbrm-mm:sequence": 141,
          "xbrlb:sourceIndex": 140
        },
        {
          "@id": "regca-1crypto:rule/REGCA_SIG_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_SIG_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_SIG_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($DocumentType) = ('http://luca.pacioli.ai/report#Form1CRYPTOMember', 'http://luca.pacioli.ai/report#Form1KCMember', 'http://luca.pacioli.ai/report#Form1SCMember', 'http://luca.pacioli.ai/report#StartupRule103DisclosureMember')) or string($SubType) eq 'http://luca.pacioli.ai/report#OfferingCircularSupplementMember' or (string($DocumentType) = ('http://luca.pacioli.ai/report#Form1KCMember', 'http://luca.pacioli.ai/report#Form1SCMember') and string($Amend) eq 'true') or (every $m in ('http://luca.pacioli.ai/report#PrincipalExecutiveOfficerMember', 'http://luca.pacioli.ai/report#PrincipalFinancialOfficerMember', 'http://luca.pacioli.ai/report#PrincipalAccountingOfficerMember') satisfies $m = (for $c in $Caps return string($c)))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SubType\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SubType\" name=\"SubType\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SubType_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementSubmissionType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_SubType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Caps\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Caps\" name=\"Caps\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Caps_concept\">\n    <cf:concept><cf:qname>regca:SignatoryCapacity</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed1\">\n    <df:dimension><df:qname>regca:SignatoryEntityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed1\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed2\">\n    <df:dimension><df:qname>regca:SignatoryIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed2\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed3\">\n    <df:dimension><df:qname>regca:SignatoryCapacityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed3\" complement=\"false\" cover=\"true\" order=\"4\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Caps_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_period\" complement=\"false\" cover=\"true\" order=\"5\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Form 1-CRYPTO, Form 1-KC and Form 1-SC are signed by the principal executive, financial and accounting officers (Rule 301(c); Form 1-KC and 1-SC General Instruction C(2)); Auditchain Labs proposes the same for Form 1-SU, the startup disclosure statement, and its annual updates. A person who holds more than one of these positions signs once and states each capacity in the capacity table. Amendments to Forms 1-KC and 1-SC need only a duly authorized representative (Rule 305(b)).",
          "sbrm-mm:sequence": 142,
          "xbrlb:sourceIndex": 141
        },
        {
          "@id": "regca-1crypto:rule/REGCA_SIG_02",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_SIG_02",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_SIG_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"not(string($DocumentType) = ('http://luca.pacioli.ai/report#Form1CRYPTOMember', 'http://luca.pacioli.ai/report#Form1KCMember', 'http://luca.pacioli.ai/report#StartupRule103DisclosureMember')) or string($SubType) eq 'http://luca.pacioli.ai/report#OfferingCircularSupplementMember' or (string($DocumentType) eq 'http://luca.pacioli.ai/report#Form1KCMember' and string($Amend) eq 'true') or count(for $c in $Caps return (if (string($c) eq 'http://luca.pacioli.ai/report#DirectorOrGoverningBodyMemberMember') then 1 else ())) gt $Board div 2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_DocumentType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_DocumentType\" xlink:to=\"f_DocumentType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_SubType\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_SubType\" name=\"SubType\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_SubType_concept\">\n    <cf:concept><cf:qname>regca:OfferingStatementSubmissionType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_SubType_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_SubType\" xlink:to=\"f_SubType_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Amend\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Amend\" name=\"Amend\" order=\"3\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Amend_concept\">\n    <cf:concept><cf:qname>regca:AmendmentIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Amend_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Amend\" xlink:to=\"f_Amend_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Board\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Board\" name=\"Board\" order=\"4\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Board_concept\">\n    <cf:concept><cf:qname>regca:BoardOrGoverningBodyMemberCount</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Board\" xlink:to=\"f_Board_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Board_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Board\" xlink:to=\"f_Board_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <uf:generalMeasures xlink:type=\"resource\" xlink:label=\"f_Board_unit\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Board\" xlink:to=\"f_Board_unit\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Caps\" bindAsSequence=\"true\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Caps\" name=\"Caps\" order=\"5\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Caps_concept\">\n    <cf:concept><cf:qname>regca:SignatoryCapacity</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed1\">\n    <df:dimension><df:qname>regca:SignatoryEntityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed1\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed2\">\n    <df:dimension><df:qname>regca:SignatoryIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed2\" complement=\"false\" cover=\"true\" order=\"3\"/>\n  <df:typedDimension xlink:type=\"resource\" xlink:label=\"f_Caps_typed3\">\n    <df:dimension><df:qname>regca:SignatoryCapacityIdentifierTypedAxis</df:qname></df:dimension>\n  </df:typedDimension>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_typed3\" complement=\"false\" cover=\"true\" order=\"4\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Caps_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Caps\" xlink:to=\"f_Caps_period\" complement=\"false\" cover=\"true\" order=\"5\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "A majority of the board of directors or other governing body signs Form 1-CRYPTO and Form 1-KC (Rule 301(c); Form 1-KC General Instruction C(2)); Auditchain Labs proposes the same for Form 1-SU, the startup disclosure statement. Not required for an amendment to Form 1-KC (Rule 305(b)).",
          "sbrm-mm:sequence": 143,
          "xbrlb:sourceIndex": 142
        },
        {
          "@id": "regca-1crypto:rule/REGCA_SRC_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_SRC_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_SRC_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($Public) ne 'true' or exists($Url)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Public\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Public\" name=\"Public\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Public_concept\">\n    <cf:concept><cf:qname>regca:SourceCodePubliclyAvailableIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Public\" xlink:to=\"f_Public_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Public_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Public\" xlink:to=\"f_Public_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Url\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Url\" name=\"Url\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Url_concept\">\n    <cf:concept><cf:qname>regca:SourceCodeWebsiteAddress</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Url\" xlink:to=\"f_Url_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Url_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Url\" xlink:to=\"f_Url_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "If the source code is publicly available, its website address is disclosed (Rule 103(b)(6)).",
          "sbrm-mm:sequence": 144,
          "xbrlb:sourceIndex": 143
        },
        {
          "@id": "regca-1crypto:rule/REGCA_FS_AGE_01",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_FS_AGE_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_FS_AGE_01\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($DocumentType) ne 'http://luca.pacioli.ai/report#Form1CRYPTOMember' or string($SubType) eq 'http://luca.pacioli.ai/report#OfferingCircularSupplementMember' or (string($PartIIIOnly) eq 'true' and string($Amend) eq 'true') or (some $dl in (max(for $a in $BalanceSheets return xs:date(xfi:period-instant(xfi:period($a)) - xs:dayTimeDuration('P1D'))) + xs:yearMonthDuration(concat('P', string($P_financialStatementAgeMonths), 'M'))) satisfies (some $w in (days-from-duration($dl - xs:date('2000-01-03')) mod 7) satisfies xs:date($Doc) le $dl + xs:dayTimeDuration(if ($w eq 5) then 'P2D' else if ($w eq 6) then 'P1D' else 'P0D')))\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_DocumentType\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_DocumentType\" name=\"DocumentType\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_DocumentType_concept\">\n    <cf:concept><cf:qname>regca:DocumentType</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2