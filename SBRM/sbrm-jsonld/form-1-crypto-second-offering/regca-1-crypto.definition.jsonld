          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_F_PARTI_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"$Affiliates le $Sellers\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Affiliates\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Affiliates\" name=\"Affiliates\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Affiliates_concept\">\n    <cf:concept><cf:qname>regca:AggregateOfferingPriceAttributableToAffiliateSellingSecurityholders</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Affiliates\" xlink:to=\"f_Affiliates_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Sellers\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Sellers\" name=\"Sellers\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Sellers_concept\">\n    <cf:concept><cf:qname>regca:AggregateOfferingPriceAttributableToSellingSecurityholders</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Sellers\" xlink:to=\"f_Sellers_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "The portion offered by affiliate selling securityholders is part of the selling-securityholder portion (Rule 300(a)(1)-(2)).",
          "sbrm-mm:sequence": 129,
          "xbrlb:sourceIndex": 128
        },
        {
