          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. Three-letter ISO 4217 code.",
            "@language": "en"
          },
          "dct:source": "regca-1crypto:reference/1005"
        },
        {
          "@id": "regca:ForeignCurrencyAmountReceived",
          "rdfs:label": {
            "@value": "Amount received in the foreign currency",
            "@language": "en"
          },
          "skos:definition": {
            "@value": "Proposed by Auditchain Labs; not required by the proposed rule. Rule 100 requires cash received in a foreign currency to be translated into U.S. dollars at an exchange rate in effect on, or a reasonable time before, the date of sale. The fact's unit is the foreign currency.",
