          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:va=\"http://xbrl.org/2008/assertion/value\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:cf=\"http://xbrl.org/2008/filter/concept\" xmlns:df=\"http://xbrl.org/2008/filter/dimension\" xmlns:pf=\"http://xbrl.org/2008/filter/period\" xmlns:uf=\"http://xbrl.org/2008/filter/unit\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:xfi=\"http://www.xbrl.org/2008/function/instance\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <va:valueAssertion xlink:type=\"resource\" xlink:label=\"assertion\" id=\"REGCA_AMEND_02\" aspectModel=\"dimensional\" implicitFiltering=\"true\" test=\"string($PartIIIOnly) ne 'true' or exists($Note)\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_PartIIIOnly\" bindAsSequence=\"false\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_PartIIIOnly\" name=\"PartIIIOnly\" order=\"1\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_PartIIIOnly_concept\">\n    <cf:concept><cf:qname>regca:AmendmentRelatesSolelyToPartIIIIndicator</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_PartIIIOnly_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_PartIIIOnly\" xlink:to=\"f_PartIIIOnly_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n  <variable:factVariable xlink:type=\"resource\" xlink:label=\"v_Note\" bindAsSequence=\"false\" fallbackValue=\"()\"/>\n  <variable:variableArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-set\" xlink:from=\"assertion\" xlink:to=\"v_Note\" name=\"Note\" order=\"2\"/>\n  <cf:conceptName xlink:type=\"resource\" xlink:label=\"f_Note_concept\">\n    <cf:concept><cf:qname>regca:AmendmentExplanatoryNote</cf:qname></cf:concept>\n  </cf:conceptName>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Note\" xlink:to=\"f_Note_concept\" complement=\"false\" cover=\"true\" order=\"1\"/>\n  <pf:period xlink:type=\"resource\" xlink:label=\"f_Note_period\" test=\"true()\"/>\n  <variable:variableFilterArc xlink:type=\"arc\" xlink:arcrole=\"http://xbrl.org/arcrole/2008/variable-filter\" xlink:from=\"v_Note\" xlink:to=\"f_Note_period\" complement=\"false\" cover=\"true\" order=\"2\"/>\n</gen:link>",
