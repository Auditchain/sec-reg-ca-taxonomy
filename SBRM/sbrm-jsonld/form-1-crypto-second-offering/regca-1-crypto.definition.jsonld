        {
          "@id": "regca-1crypto:rule/REGCA_C_OFFER_01",
          "@type": "sbrm-mm:ConsistencyRule",
          "xbrlb:ruleType": "ConsistencyRule",
          "dct:identifier": "REGCA_C_OFFER_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$AggregateOfferingPrice = $UnitsOfCoveredInvestmentContractsOffered * $PurchasePricePerUnit"
          },
          "cmns-cxtdsg:appliesTo": "regca-1crypto:fragment/regca-22-offering",
          "xbrlb:conceptAspect": "regca:AggregateOfferingPrice",
          "cmns-av:explanatoryNote": "Aggregate offering price equals units offered times price per unit; one unit equals one unit of the subject crypto asset (Rule 101(e)).",
          "sbrm-mm:sequence": 1,
          "xbrlb:sourceIndex": 0
        },
        {
          "@id": "regca-1crypto:rule/REGCA_C_BS_01",
          "@type": "sbrm-mm:ConsistencyRule",
          "xbrlb:ruleType": "ConsistencyRule",
          "dct:identifier": "REGCA_C_BS_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$Assets = $LiabilitiesAndEquity"
          },
          "cmns-cxtdsg:appliesTo": "regca-1crypto:fragment/regca-71-balance-sheet",
          "xbrlb:conceptAspect": "regca:Assets",
          "cmns-av:explanatoryNote": "Total assets equal total liabilities and equity (ASC 210).",
          "sbrm-mm:sequence": 2,
          "xbrlb:sourceIndex": 1
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BNP_TIE_01",
          "@type": "sbrm-mm:ConsistencyRule",
          "xbrlb:ruleType": "ConsistencyRule",
          "dct:identifier": "REGCA_BNP_TIE_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$BlockchainNetworkParticipationNetIncome = $BlockchainNetworkParticipationRevenue - $BlockchainNetworkParticipationExpenses"
          },
          "cmns-cxtdsg:appliesTo": "regca-1crypto:fragment/regca-40b-bnp-issuer-period",
          "xbrlb:conceptAspect": "regca:BlockchainNetworkParticipationNetIncome",
          "cmns-av:explanatoryNote": "ConsistencyRule REGCA_BNP_TIE_01: $BlockchainNetworkParticipationNetIncome = $BlockchainNetworkParticipationRevenue - $BlockchainNetworkParticipationExpenses. Concept: regca:BlockchainNetworkParticipationNetIncome. Structure: Rule 103(b)(9) — issuer blockchain network participation for the period. Carried over unchanged (renamed) from the BNP rules in the Auditchain FDIC PS-02 model.",
          "sbrm-mm:sequence": 3,
          "xbrlb:sourceIndex": 2
        },
        {
          "@id": "regca-1crypto:rule/REGCA_RF_CASH_01",
          "@type": "sbrm-mm:RollForwardRule",
          "xbrlb:ruleType": "RollForwardRule",
          "dct:identifier": "REGCA_RF_CASH_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$CashAndCashEquivalents_PeriodStart + $CashAndCashEquivalentsPeriodIncreaseDecrease = $CashAndCashEquivalents_PeriodEnd"
          },
          "cmns-cxtdsg:appliesTo": "regca-1crypto:fragment/regca-73-cash-flows",
          "xbrlb:conceptAspect": "regca:CashAndCashEquivalents",
          "cmns-av:explanatoryNote": "Cash at the start of the period plus the net change equals cash at the end (ASC 230).",
          "sbrm-mm:sequence": 2,
          "xbrlb:sourceIndex": 0
        },
        {
          "@id": "regca-1crypto:rule/REGCA_RF_EQUITY_01",
          "@type": "sbrm-mm:RollForwardRule",
          "xbrlb:ruleType": "RollForwardRule",
          "dct:identifier": "REGCA_RF_EQUITY_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "$Equity_PeriodStart + $NetIncomeLoss + $OtherComprehensiveIncomeLoss + $ProceedsFromIssuanceOfEquityRecognizedInEquity + $OtherChangesInEquity = $Equity_PeriodEnd"
          },
          "cmns-cxtdsg:appliesTo": "regca-1crypto:fragment/regca-74-changes-in-equity",
          "xbrlb:conceptAspect": "regca:Equity",
          "cmns-av:explanatoryNote": "Opening equity plus net income, other comprehensive income, equity issued and other changes equals closing equity (ASC 505).",
          "sbrm-mm:sequence": 3,
          "xbrlb:sourceIndex": 1
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BNP_D_01",
          "@type": "sbrm-mm:DerivationRule",
          "xbrlb:ruleType": "DerivationRule",
          "dct:identifier": "REGCA_BNP_D_01",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:EstimatedStakeSharePercentage = regca:EffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork"
          },
          "xbrlb:derivedFact": "regca:EstimatedStakeSharePercentage",
          "xbrlb:basedOnSourceFact": "regca:EffectiveStakeControlledOnNetwork",
          "xbrlb:precondition": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:TotalActiveStakeOnNetwork > 0"
          },
          "cmns-av:explanatoryNote": "DerivationRule REGCA_BNP_D_01: regca:EstimatedStakeSharePercentage = regca:EffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork. Precondition: regca:TotalActiveStakeOnNetwork > 0. Carried over unchanged (renamed) from the BNP rules in the Auditchain FDIC PS-02 model.",
          "xbrlb:sourceIndex": 0
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BNP_D_02",
          "@type": "sbrm-mm:DerivationRule",
          "xbrlb:ruleType": "DerivationRule",
          "dct:identifier": "REGCA_BNP_D_02",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:EstimatedHashPowerSharePercentage = regca:HashRateContributedToNetwork div regca:TotalNetworkHashRate"
          },
          "xbrlb:derivedFact": "regca:EstimatedHashPowerSharePercentage",
          "xbrlb:basedOnSourceFact": "regca:HashRateContributedToNetwork",
          "xbrlb:precondition": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:TotalNetworkHashRate > 0"
          },
          "cmns-av:explanatoryNote": "DerivationRule REGCA_BNP_D_02: regca:EstimatedHashPowerSharePercentage = regca:HashRateContributedToNetwork div regca:TotalNetworkHashRate. Precondition: regca:TotalNetworkHashRate > 0. Carried over unchanged (renamed) from the BNP rules in the Auditchain FDIC PS-02 model.",
          "xbrlb:sourceIndex": 1
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BNP_D_03",
          "@type": "sbrm-mm:DerivationRule",
          "xbrlb:ruleType": "DerivationRule",
          "dct:identifier": "REGCA_BNP_D_03",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:AffiliateEstimatedStakeSharePercentage = regca:AffiliateEffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork[regca:AffiliateIdentifierTypedAxis = absent]"
          },
          "xbrlb:derivedFact": "regca:AffiliateEstimatedStakeSharePercentage",
          "xbrlb:basedOnSourceFact": "regca:AffiliateEffectiveStakeControlledOnNetwork",
          "xbrlb:precondition": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:TotalActiveStakeOnNetwork[regca:AffiliateIdentifierTypedAxis = absent] > 0"
          },
          "cmns-av:explanatoryNote": "DerivationRule REGCA_BNP_D_03: regca:AffiliateEstimatedStakeSharePercentage = regca:AffiliateEffectiveStakeControlledOnNetwork div regca:TotalActiveStakeOnNetwork[regca:AffiliateIdentifierTypedAxis = absent]. Precondition: regca:TotalActiveStakeOnNetwork[regca:AffiliateIdentifierTypedAxis = absent] > 0. Carried over unchanged (renamed) from the BNP rules in the Auditchain FDIC PS-02 model.",
          "xbrlb:sourceIndex": 2
        },
        {
          "@id": "regca-1crypto:rule/REGCA_BNP_D_04",
          "@type": "sbrm-mm:DerivationRule",
          "xbrlb:ruleType": "DerivationRule",
          "dct:identifier": "REGCA_BNP_D_04",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:AffiliateEstimatedHashPowerSharePercentage = regca:AffiliateHashRateContributedToNetwork div regca:TotalNetworkHashRate[regca:AffiliateIdentifierTypedAxis = absent]"
          },
          "xbrlb:derivedFact": "regca:AffiliateEstimatedHashPowerSharePercentage",
          "xbrlb:basedOnSourceFact": "regca:AffiliateHashRateContributedToNetwork",
          "xbrlb:precondition": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": "regca:TotalNetworkHashRate[regca:AffiliateIdentifierTypedAxis = absent] > 0"
          },
          "cmns-av:explanatoryNote": "DerivationRule REGCA_BNP_D_04: regca:AffiliateEstimatedHashPowerSharePercentage = regca:AffiliateHashRateContributedToNetwork div regca:TotalNetworkHashRate[regca:AffiliateIdentifierTypedAxis = absent]. Precondition: regca:TotalNetworkHashRate[regca:AffiliateIdentifierTypedAxis = absent] > 0. Carried over unchanged (renamed) from the BNP rules in the Auditchain FDIC PS-02 model.",
          "xbrlb:sourceIndex": 3
        },
        {
          "@id": "regca-1crypto:rule/REGCA_PARAM_REGISTER",
          "@type": "sbrm-mm:ReportLevelRule",
          "xbrlb:ruleType": "NonstandardRule",
          "dct:identifier": "REGCA_PARAM_REGISTER",
          "cmns-qtu:hasExpression": {
            "@type": "cmns-qtu:Expression",
            "cmns-qtu:describesActualExpression": {
              "@value": "<gen:link xlink:type=\"extended\" xlink:role=\"http://www.xbrl.org/2003/role/link\" xmlns:gen=\"http://xbrl.org/2008/generic\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:variable=\"http://xbrl.org/2008/variable\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:regca=\"http://luca.pacioli.ai/report\">\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_startupOfferingLimit\" name=\"P_startupOfferingLimit\" select=\"5000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_startupPeriodYears\" name=\"P_startupPeriodYears\" select=\"4\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_annualUpdateDays\" name=\"P_annualUpdateDays\" select=\"30\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier1Limit\" name=\"P_tier1Limit\" select=\"20000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier1AffiliateLimit\" name=\"P_tier1AffiliateLimit\" select=\"6000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier2Limit\" name=\"P_tier2Limit\" select=\"75000000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_tier2AffiliateLimit\" name=\"P_tier2AffiliateLimit\" select=\"22500000\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_firstYearSellingSecurityholderShare\" name=\"P_firstYearSellingSecurityholderShare\" select=\"0.30\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_suspensionHolderThreshold\" name=\"P_suspensionHolderThreshold\" select=\"300\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_shareRoundingTolerance\" name=\"P_shareRoundingTolerance\" select=\"0.0001\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_percentFractionLowerBound\" name=\"P_percentFractionLowerBound\" select=\"0\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_percentFractionUpperBound\" name=\"P_percentFractionUpperBound\" select=\"1\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_minimumNetworksPerEngagedAffiliate\" name=\"P_minimumNetworksPerEngagedAffiliate\" select=\"1\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_monetaryTolerance\" name=\"P_monetaryTolerance\" select=\"1\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_annualReportDays\" name=\"P_annualReportDays\" select=\"120\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_semiannualReportDays\" name=\"P_semiannualReportDays\" select=\"90\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_specialAnnualReportDays\" name=\"P_specialAnnualReportDays\" select=\"120\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_specialSemiannualReportDays\" name=\"P_specialSemiannualReportDays\" select=\"90\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_postQualificationUpdateMonths\" name=\"P_postQualificationUpdateMonths\" select=\"12\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeUpperThreshold\" name=\"P_priceRangeUpperThreshold\" select=\"10\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeMaxWidth\" name=\"P_priceRangeMaxWidth\" select=\"2\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_priceRangeMaxShare\" name=\"P_priceRangeMaxShare\" select=\"0.20\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_supplementChangeLimit\" name=\"P_supplementChangeLimit\" select=\"0.20\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_financialStatementAgeMonths\" name=\"P_financialStatementAgeMonths\" select=\"9\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_fundamentalChangeAssetShare\" name=\"P_fundamentalChangeAssetShare\" select=\"0.50\" as=\"xs:decimal\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_currentReportBusinessDays\" name=\"P_currentReportBusinessDays\" select=\"4\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_omittedPricingBusinessDays\" name=\"P_omittedPricingBusinessDays\" select=\"15\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_pricingSupplementBusinessDays\" name=\"P_pricingSupplementBusinessDays\" select=\"2\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_changeSupplementBusinessDays\" name=\"P_changeSupplementBusinessDays\" select=\"5\" as=\"xs:integer\"/>\n  <variable:parameter xlink:type=\"resource\" xlink:label=\"P_accountantLetterBusinessDays\" name=\"P_accountantLetterBusinessDays\" select=\"2\" as=\"xs:integer\"/>\n</gen:link>",
              "@type": "rdf:XMLLiteral"
            },
            "dct:conformsTo": "https://www.xbrl.org/Specification/formula/REC-2009-06-22/formula-REC-2009-06-22.html"
          },
          "cmns-av:explanatoryNote": "Parameter register: P_startupOfferingLimit = 5000000 (Rule 200(b)(4); adjusted under Rule 102); P_startupPeriodYears = 4 (Rule 200(b)(1), 200(e)); P_annualUpdateDays = 30 (Rule 200(d)(3)); P_tier1Limit = 20000000 (Rule 300(a)(1); adjusted under Rule 102); P_tier1AffiliateLimit = 6000000 (Rule 300(a)(1)); P_tier2Limit = 75000000 (Rule 300(a)(2); adjusted under Rule 102); P_tier2AffiliateLimit = 22500000 (Rule 300(a)(2)); P_firstYearSellingSecurityholderShare = 0.30 (Rule 300(a)(3)); P_suspensionHolderThreshold = 300 (Rule 305(c)(1)); P_shareRoundingTolerance = 0.0001 (BNP share tolerance (carried from the FDIC model)); P_percentFractionLowerBound = 0 (Percent stored as a fraction); P_percentFractionUpperBound = 1 (Percent stored as a fraction); P_minimumNetworksPerEngagedAffiliate = 1 (BNP perimeter rule (carried from the FDIC model)); P_monetaryTolerance = 1 (One dollar rounding tolerance for products of units and prices); P_annualReportDays = 120 (Form 1-KC General Instruction A(2)); P_semiannualReportDays = 90 (Form 1-SC General Instruction A(2)); P_specialAnnualReportDays = 120 (Rule 305(a)(2)(ii); Form 1-KC General Instruction A(3)); P_specialSemiannualReportDays = 90 (Rule 305(a)(2)(ii); Form 1-SC General Instruction A(3)); P_postQualificationUpdateMonths = 12 (Rule 301(f)(2)(i)); P_priceRangeUpperThreshold = 10 (Rule 302(b)(2)(i)); P_priceRangeMaxWidth = 2 (Rule 302(b)(2)(i)); P_priceRangeMaxShare = 0.20 (Rule 302(b)(2)(i), read as 20 percent of the upper end of the range); P_supplementChangeLimit = 0.20 (Rule 302(b), Note to paragraph (b)); P_financialStatementAgeMonths = 9 (Form 1-CRYPTO Part F/S (b)(3): the most recent balance sheet is no more than nine months old at filing); P_fundamentalChangeAssetShare = 0.50 (Form 1-UC, Instruction 2.a to Item 1); P_currentReportBusinessDays = 4 (Form 1-UC General Instruction A(2); business day read as any day other than Saturday or Sunday); P_omittedPricingBusinessDays = 15 (Rule 302(c)); P_pricingSupplementBusinessDays = 2 (Rule 302(f)(1), (3)); P_changeSupplementBusinessDays = 5 (Rule 302(f)(2)); P_accountantLetterBusinessDays = 2 (Regulation S-K Item 304(a)(3); Form 1-UC Item 5(c)(3)). Limits are parameters because Rule 102 requires inflation adjustments at least every five years.",
          "sbrm-mm:sequence": 1,
          "xbrlb:sourceIndex": 0
        },
        {
          "@id": "regca-1crypto:rule/REGCA_REQ_1CRYPTO_ExemptionRelied",
          "@type": "sbrm-mm:DisclosureRule",
