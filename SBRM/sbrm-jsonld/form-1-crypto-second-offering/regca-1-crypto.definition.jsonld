            "@id": "https://www.fdic.gov/federal-register-publications/supplemental-comment-auditchain-labs-ag-jason-meyers-rin-3064-ag20"
          },
          "dct:date": {
            "@value": "2026-03-09",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 1433,
          "xbrlb:sourceIndex": 1432
        },
        {
          "@id": "regca-1crypto:reference/1434",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:DataSourceForNetworkShareEstimate",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/rutgers-carlab-engineering-sciences-laboratory-ibn-tofail-university-auditchain-labs-ag",
          "dct:title": "El Imami, Oh, Meyers, Brennan, Vasarhelyi, Sannella, Egan et al., Beyond the Fiat Vault: Evaluating Machine-Readable Blockchain Disclosures for Systemic Safety, Operational Security, and MEV Conflict Mitigation (BNP Disclosure Taxonomy paper)",
          "dct:bibliographicCitation": "PDF p. 11",
          "cmns-docc:hasTextualContent": "Verbatim: \"Shapes the issuer's direct exposure to blockchain networks across five separate sub-domains, namely: basic participation information, network governance participation, network share and concentration metrics, operational dependencies, and financial performance.\"",
          "cmns-doc:refersTo": {
            "@id": "https://raw.rutgers.edu/bnp-disclosure-taxonomy.pdf"
          },
          "dct:date": {
            "@value": "2026-09-27",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 1434,
          "xbrlb:sourceIndex": 1433
        },
        {
          "@id": "regca-1crypto:reference/1435",
          "@type": "cmns-doc:Reference",
          "xbrlb:referenceOf": "regca:DataSourceForNetworkShareEstimate",
          "dct:type": "xbrl-role:commentaryRef",
          "dct:publisher": "regca-1crypto:publisher/auditchain-labs-ag",
          "dct:title": "Comment to the FDIC on proposed Forms PS-01, PS-01a and PS-02, OMB No. 3064-0225 (Sept. 23, 2026)",
          "dct:bibliographicCitation": "PDF p. 10",
          "cmns-docc:hasTextualContent": "Verbatim: \"Where a reported figure is an estimate of network share, hash power or stake, require the estimation basis and a source reference to travel with it, so the estimate can be reconciled against on-chain data rather than merely received.\"",
          "cmns-doc:refersTo": {
            "@id": "https://www.fdic.gov/federal-register-publications/auditchain-jason-meyers-omb-3064-0225.pdf"
          },
          "dct:date": {
            "@value": "2026-09-23",
            "@type": "xsd:date"
          },
          "sbrm-mm:sequence": 1435,
          "xbrlb:sourceIndex": 1434
        },
        {
          "@id": "regca-1crypto:reference/1436",
